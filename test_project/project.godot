; Engine configuration file.
; WebGPU smoke test for the Fast_Godot WebGPU experiment.

config_version=5

[application]

config/name="Fast Godot WebGPU Test"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.08, 0.09, 0.12, 1)

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"

[rendering]
environment/defaults/default_clear_color=Color(1, 0, 0, 1)

renderer/rendering_method="mobile"
renderer/rendering_method.web="mobile"
rendering_device/driver.web="webgpu"
textures/default_filters/anisotropic_filtering_level=2
anti_aliasing/quality/msaa_3d=2
