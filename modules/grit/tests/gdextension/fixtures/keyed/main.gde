class_name KeyedMain
extends Node

func cffi_value() -> int:
	var t = CFFI["int"].alloc_array(1)
	t.set_value(0, 7)
	return t.get_value(0)

func cffi_missing() -> int:
	var t = CFFI["int"].alloc_array(1)
	t.set_value(7)
	return t.get_value()

func array_value() -> int:
	var values = [10, 20]
	return values[1] + values[-1]

func packed_value() -> int:
	var values := PackedInt32Array([5, 6])
	return values[1] + values[-1]

func array_oob() -> int:
	var values = []
	return values[3]

func _ready() -> void:
	print("keyed cffi: ", cffi_value())
	print("keyed missing: ", cffi_missing())
	print("keyed array: ", array_value())
	print("keyed packed: ", packed_value())
	print("keyed oob: ", array_oob())
	get_tree().quit()
