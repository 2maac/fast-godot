+            return CreateScalar(source, ty->DeepestElement(), cond ? t : f);
+        };
+        return Dispatch_fia_fiu32_f16_bool(create, c0, c1);
+    };
+
+    return TransformElements(mgr, ty, transform, 0, args[0], args[1]);
+}
