+#ifndef SRC_TINT_LANG_CORE_IR_ANALYSIS_INTEGER_RANGE_ANALYSIS_H_
+#define SRC_TINT_LANG_CORE_IR_ANALYSIS_INTEGER_RANGE_ANALYSIS_H_
+
+#include <cstdint>
+#include <memory>
+#include <variant>
+
+namespace tint::core::ir {
+class Access;
+class Binary;
+class Constant;
+class Convert;
+class CoreBuiltinCall;
+class Function;
+class FunctionParam;
+class Let;
+class Load;
+class Loop;
