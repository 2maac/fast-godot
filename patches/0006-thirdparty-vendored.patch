+#include "src/tint/utils/diagnostic/formatter.h"
+
+#include <algorithm>
+#include <iterator>
+#include <utility>
+#include <vector>
+
+#include "src/tint/utils/diagnostic/diagnostic.h"
+#include "src/tint/utils/macros/defer.h"
