@@ -262,7 +262,10 @@ layout (set = 0, binding = 1) uniform sampler s_LinearClamp;
 	layout (set = 1, binding = FSR2_BIND_UAV_LUMA_HISTORY, rgba8)                     uniform image2D  rw_luma_history;
 #endif
 #if defined FSR2_BIND_UAV_UPSCALED_OUTPUT
-	layout (set = 1, binding = FSR2_BIND_UAV_UPSCALED_OUTPUT /* app controlled format */) writeonly uniform image2D  rw_upscaled_output;
+	// The app-controlled output is Godot's upscaled 3D colour target, which the
+	// Forward+ renderer always allocates as RGBA16F. Naming the format is required
+	// on WebGPU, where a storage texture declaration cannot be format-less.
+	layout (set = 1, binding = FSR2_BIND_UAV_UPSCALED_OUTPUT, rgba16f) writeonly uniform image2D  rw_upscaled_output;
 #endif
 #if defined FSR2_BIND_UAV_EXPOSURE_MIP_LUMA_CHANGE
 	layout (set = 1, binding = FSR2_BIND_UAV_EXPOSURE_MIP_LUMA_CHANGE, r16f)              coherent uniform image2D  rw_img_mip_shading_change;
@@ -515,11 +518,24 @@ void StoreReconstructedDepth(FfxInt32x2 iPxSample, FfxFloat32 fDepth)
 {
 	FfxUInt32 uDepth = floatBitsToUint(fDepth);
 
+#ifdef FFX_FSR2_NO_IMAGE_ATOMICS
+	// WebGPU has no image atomics. Emulate the min/max with a load/store; this
+	// pass distributes each source depth to a few bilinear taps, so the only
+	// effect of a lost update is a stale (more conservative) depth hint.
+	FfxUInt32 uPrev = imageLoad(rw_reconstructed_previous_nearest_depth, iPxSample).r;
+	#if FFX_FSR2_OPTION_INVERTED_DEPTH
+		uDepth = max(uDepth, uPrev);
+	#else
+		uDepth = min(uDepth, uPrev);
+	#endif
+	imageStore(rw_reconstructed_previous_nearest_depth, iPxSample, uvec4(uDepth, 0, 0, 0));
+#else
 	#if FFX_FSR2_OPTION_INVERTED_DEPTH
 		imageAtomicMax(rw_reconstructed_previous_nearest_depth, iPxSample, uDepth);
 	#else
 		imageAtomicMin(rw_reconstructed_previous_nearest_depth, iPxSample, uDepth); // min for standard, max for inverted depth
 	#endif
+#endif
 }
 #endif
 
