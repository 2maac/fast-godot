index 0000000000..47d1a3c029
--- /dev/null
+++ b/thirdparty/spirv-tools/source/val/validate_memory.cpp
@@ -0,0 +1,3558 @@
+// Copyright (c) 2018 Google LLC.
+// Modifications Copyright (C) 2020-2024 Advanced Micro Devices, Inc. All
+// rights reserved.
