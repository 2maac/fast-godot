+    ir::Value* Value(uint32_t id) {
+        if (DAWN_UNLIKELY(id > values_.Length())) {
+            err_ << "value id " << id << " out of range\n";
+            return nullptr;
+        }
+        return id > 0 ? values_[id - 1] : nullptr;
