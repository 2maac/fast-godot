+                         const Expression* cond,
+                         const BlockStatement* b,
+                         const Statement* else_stmt,
+                         VectorRef<const Attribute*> attrs)
+    : Base(nid, src),
+      condition(cond),
+      body(b),
+      else_statement(else_stmt),
+      attributes(std::move(attrs)) {
