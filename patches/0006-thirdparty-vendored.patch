+                                                            {sym.Register("C"), ty.f32()},
+                                                            {sym.Register("D"), ty.f32()},
+                                                            {sym.Register("E"), ty.f32()},
+                                                            {sym.Register("F"), ty.f32()},
+                                                            {sym.Register("G"), ty.f32()},
+                                                        });
