+#ifndef SRC_TINT_LANG_CORE_IR_REFERENCED_MODULE_VARS_H_
+#define SRC_TINT_LANG_CORE_IR_REFERENCED_MODULE_VARS_H_
+
+#include <functional>
+
+#include "src/tint/lang/core/ir/control_instruction.h"
