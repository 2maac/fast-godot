+    uint32_t packed_uint8_vec4_2 = args[1]->ValueAs<u32>();
+
+    uint32_t result = 0;
+    for (size_t i = 0; i < 4; i++) {
+        result +=
+            GetNthUnsignedByte(packed_uint8_vec4_1, i) * GetNthUnsignedByte(packed_uint8_vec4_2, i);
+    }
+
+    return CreateScalar(source, ty, u32(result));
