+template <uint32_t C, uint32_t R>
+inline const type::Matrix* BuildMat(intrinsic::MatchState& state,
+                                    const type::Type*,
+                                    const type::Type* T) {
+    auto* column_type = state.types.vec(T, R);
+    return state.types.mat(column_type, C);
+}
