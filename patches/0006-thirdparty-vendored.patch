+                case 5:
+                    return mat3x4<T>(source);
+                case 6:
+                    return mat4x2<T>(source);
+                case 7:
+                    return mat4x3<T>(source);
+                case 8:
+                    return mat4x4<T>(source);
+                default:
+                    TINT_ICE() << "invalid matrix dimensions " << columns << "x" << rows;
+            }
+        }
