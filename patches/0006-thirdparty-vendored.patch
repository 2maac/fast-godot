+        case BuiltinFn::kFaceForward:
+        case BuiltinFn::kFirstLeadingBit:
+        case BuiltinFn::kFirstTrailingBit:
+        case BuiltinFn::kFloor:
+        case BuiltinFn::kFma:
+        case BuiltinFn::kFract:
+        case BuiltinFn::kFrexp:
