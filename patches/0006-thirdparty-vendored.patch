 void SPD_IncreaseAtomicCounter(inout uint spdCounter)
 {
+#ifdef SPD_NO_IMAGE_ATOMICS
+	// Not called: SpdExitWorkgroup() takes the no-atomic path. Keep the atomic
+	// opcode out of the SPIR-V so Tint can lower the stage to WGSL.
+	spdCounter = 0;
