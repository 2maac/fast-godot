+            auto& bp_in = var_in.binding_point();
+            var_out->SetBindingPoint(bp_in.group(), bp_in.binding());
+        }
+        if (var_in.has_input_attachment_index()) {
+            var_out->SetInputAttachmentIndex(var_in.input_attachment_index());
+        }
+        return var_out;
+    }
