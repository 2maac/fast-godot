index 0000000000..dd9bb4a1ea
--- /dev/null
+++ b/thirdparty/spirv-tools/source/val/validate_mesh_shading.cpp
@@ -0,0 +1,238 @@
+// Copyright (c) 2022 The Khronos Group Inc.
+//
