+                    EmitBuiltinCall(inst, core::BuiltinFn::kQuantizeToF16);
+                    break;
+                case spv::Op::OpTranspose:
+                    EmitBuiltinCall(inst, core::BuiltinFn::kTranspose);
+                    break;
