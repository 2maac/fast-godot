+    void EmitBitCount(const spvtools::opt::Instruction& inst) {
+        auto* res_ty = Type(inst.type_id());
+        Emit(b_.CallExplicit<spirv::ir::BuiltinCall>(res_ty, spirv::BuiltinFn::kBitCount,
+                                                     Vector{res_ty->DeepestElement()},
+                                                     Args(inst, 2)),
+             inst.result_id());
