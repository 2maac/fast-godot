+        template <typename T>
+        ast::Type mat(const Source& source, uint32_t columns, uint32_t rows) const {
+            switch ((columns - 2) * 3 + (rows - 2)) {
+                case 0:
+                    return mat2x2<T>(source);
+                case 1:
+                    return mat2x3<T>(source);
+                case 2:
+                    return mat2x4<T>(source);
