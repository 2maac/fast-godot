index 0000000000..28fd916534
--- /dev/null
+++ b/thirdparty/spirv-tools/include/spirv-tools/libspirv.h
@@ -0,0 +1,1075 @@
+// Copyright (c) 2015-2020 The Khronos Group Inc.
