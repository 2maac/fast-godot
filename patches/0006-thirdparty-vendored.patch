+++ b/thirdparty/spirv-tools/source/disassemble.cpp
@@ -0,0 +1,1145 @@
+// Copyright (c) 2015-2020 The Khronos Group Inc.
+// Modifications Copyright (C) 2020 Advanced Micro Devices, Inc. All rights
+// reserved.
