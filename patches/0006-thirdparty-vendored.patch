+namespace tint::core {
+
+std::string_view ToString(UnaryOp value) {
+    switch (value) {
+        case UnaryOp::kAddressOf:
+            return "&";
+        case UnaryOp::kComplement:
+            return "~";
+        case UnaryOp::kIndirection:
+            return "*";
+        case UnaryOp::kNegation:
+            return "-";
+        case UnaryOp::kNot:
+            return "!";
+    }
+    return "<unknown>";
+}
