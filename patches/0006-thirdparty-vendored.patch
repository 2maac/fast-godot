+    void EmitSubgroupBuiltin(spvtools::opt::Instruction& inst, core::BuiltinFn fn) {
+        ValidateScope(inst);
+        Emit(b_.Call(Type(inst.type_id()), fn, Args(inst, 3)), inst.result_id());
+    }
