index 0000000000..09c1568eff
--- /dev/null
+++ b/thirdparty/tint/src/tint/lang/core/ir/transform/value_to_let.cc
@@ -0,0 +1,240 @@
+// Copyright 2023 The Dawn & Tint Authors
+//
+// Redistribution and use in source and binary forms, with or without
