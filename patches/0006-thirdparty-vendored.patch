--- /dev/null
+++ b/thirdparty/spirv-tools/source/cfa.h
@@ -0,0 +1,398 @@
+// Copyright (c) 2015-2016 The Khronos Group Inc.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
