+
+namespace tint::ast {
+
+/// The pipeline stage
+enum class PipelineStage : uint8_t { kVertex, kFragment, kCompute, kNone };
+
+/// @param stage the enum value
+/// @returns the string for the given enum value
+std::string_view ToString(PipelineStage stage);
+
