+++ b/thirdparty/amd-fsr2/shaders/ffx_spd.h
@@ -108,6 +108,15 @@ void SpdWorkgroupShuffleBarrier()
 // Only last active workgroup should proceed
 bool SpdExitWorkgroup(FfxUInt32 numWorkGroups, FfxUInt32 localInvocationIndex, FfxUInt32 slice)
 {
+#ifdef SPD_NO_IMAGE_ATOMICS
+    // WebGPU has no image atomics, so there is no way to elect a single "last"
+    // workgroup. Every workgroup can compute the final global mips 6/7 instead:
+    // that code loads the source texels directly (not per-workgroup LDS), so all
+    // workgroups produce identical values and the redundant writes are benign.
+    // The workgroup barrier still has to run before the LDS reduction below.
+    SpdWorkgroupShuffleBarrier();
+    return false;
+#else
     // global atomic counter
     if (localInvocationIndex == 0)
     {
@@ -116,6 +125,7 @@ bool SpdExitWorkgroup(FfxUInt32 numWorkGroups, FfxUInt32 localInvocationIndex, F
 
     SpdWorkgroupShuffleBarrier();
     return (SpdGetAtomicCounter() != (numWorkGroups - 1));
+#endif
 }
 
