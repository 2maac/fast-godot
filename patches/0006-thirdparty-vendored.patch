+    ///         was not found.
+    template <typename TYPE,
+              typename _ = std::enable_if<tint::traits::IsTypeOrDerived<TYPE, Type>>,
+              typename... ARGS>
+    auto* Find(ARGS&&... args) const {
+        return types_.Find<TYPE>(std::forward<ARGS>(args)...);
+    }
