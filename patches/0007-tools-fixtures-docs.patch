+            options["platform"] = rest.pop(0)
+        elif arg in ("--jobs", "-j") and rest:
+            options["jobs"] = rest.pop(0)
+        elif arg in ("--toolchain", "-t") and rest:
+            options["toolchain"] = rest.pop(0)
