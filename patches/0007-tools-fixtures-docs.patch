+#version 450
+
+layout(location = 0) in vec3 position;
+layout(location = 1) in vec2 uv;
+layout(location = 2) in vec3 normal;
+
+layout(location = 0) out vec2 v_uv;
+layout(location = 1) out vec3 v_normal;
+layout(location = 2) out vec3 v_world_pos;
