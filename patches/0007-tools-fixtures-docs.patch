+	if (cmd->render_state.current_pipeline) {
+		_flush_push_constants(cmd, cmd->render_state.current_pipeline->shader);
+	}
+
+	wgpuComputePassEncoderDispatchWorkgroupsIndirect(cmd->compute_encoder, indirect->handle, p_offset);
+}
