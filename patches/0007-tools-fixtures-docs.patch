+	color_ramp.gradient = gradient
+	pmat.color_ramp = color_ramp
+	particles.process_material = pmat
+
+	# Draw pass — small sphere per particle
+	var sphere := SphereMesh.new()
+	sphere.radius = 0.05
+	sphere.height = 0.1
+	sphere.radial_segments = 8
+	sphere.rings = 4
+	particles.draw_pass_1 = sphere
+
