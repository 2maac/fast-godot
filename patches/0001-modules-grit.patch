+#include "core/templates/vector.h"
+
+class GDScript;
+class Resource;
+
+class GritProjectCompiler {
+public:
+	struct Report {
+		String fingerprint;
+		int script_count = 0;
+		int function_count = 0;
+		int native_function_count = 0;
+		int stripped_function_count = 0;
+		HashMap<String, String> stripped_sources;
+	};
