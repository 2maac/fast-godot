+struct PropertyAccessor {
+	const MethodBind *method = nullptr;
+	StringName method_name;
+	int index = -1;
+	Variant::Type value_type = Variant::VARIANT_MAX;
+	bool is_call = false;
+	bool returns_ref = false;
