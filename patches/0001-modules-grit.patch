+	if (!resolve(p_target, statement.target) || !resolve_all(p_arguments, statement.operands)) {
+		return;
+	}
+	if (p_element_type) {
+		statement.validated = true;
+		statement.type = add_type(*p_element_type);
+	}
+	append(statement);
+}
