+
+static String _safe_project_name() {
+	String project_name = GLOBAL_GET("application/config/name");
+	if (project_name.is_empty()) {
+		project_name = "project";
+	}
+	String safe;
+	for (int i = 0; i < project_name.length(); i++) {
+		const char32_t c = project_name[i];
+		safe += (is_ascii_alphanumeric_char(c) || c == '-' || c == '_') ? String::chr(c) : String("_");
+	}
+	return safe;
+}
+
+// macOS refuses to export an app without a bundle identifier ("Invalid bundle
+// identifier: Identifier is missing"), and a fresh preset ships the option empty,
+// which makes the user stop and invent one. Fill in "fast.<project>" instead:
+// identifiers allow letters, digits, hyphens and dots, so everything else becomes
+// a hyphen and the whole thing is lowercased.
+static String _default_bundle_identifier() {
+	String project_name = GLOBAL_GET("application/config/name");
+	if (project_name.is_empty()) {
+		project_name = "project";
+	}
+	String safe;
+	for (int i = 0; i < project_name.length(); i++) {
+		const char32_t c = project_name[i];
+		safe += (is_ascii_alphanumeric_char(c) || c == '-' || c == '_') ? String::chr(c) : String("-");
+	}
+	return "fast." + safe.to_lower();
+}
+
+static void _apply_default_bundle_identifier(const Ref<EditorExportPreset> &p_preset) {
+	if (p_preset.is_null()) {
+		return;
+	}
+	if (!String(p_preset->get("application/bundle_identifier")).strip_edges().is_empty()) {
+		return;
+	}
+	const String identifier = _default_bundle_identifier();
+	p_preset->set("application/bundle_identifier", identifier);
+	print_line(vformat("Grit: set the preset's bundle identifier to \"%s\"; change it in the preset options before shipping.", identifier));
+}
+
+// "macOS Fast" is the platform that compiles the project into the export. The
+// ordinary "macOS" platform stays plain Godot and ships GDScript.
+// A Fast template is a full engine build for the target platform, which only works
+// when that platform is the one we are running on.
+static bool _is_host_platform(const String &p_os_name) {
+	const String host = OS::get_singleton()->get_name();
+	return p_os_name == host || (host == "macOS" && p_os_name == "macOS");
+}
+
+static bool _is_fast_platform(const Ref<EditorExportPlatform> &p_platform) {
+	return p_platform.is_valid() && p_platform->get_name().ends_with(" Fast");
+}
+
+// GRIT_DISABLE=1 in the editor's environment disables Grit for every export, the
+// same variable the game honours at runtime. The preset's grit/enabled option is
+// the per-preset switch; the environment wins so CI can force a VM-only build
+// without editing (or committing) presets.
+static bool _grit_disabled_by_env() {
+	const String value = OS::get_singleton()->get_environment("GRIT_DISABLE").strip_edges().to_lower();
+	return value == "1" || value == "true";
+}
+
+bool GritExportPlugin::_grit_enabled(const Ref<EditorExportPreset> &p_preset) const {
+	if (_grit_disabled_by_env()) {
+		return false;
+	}
+	if (p_preset.is_valid() && p_preset->has("grit/enabled")) {
+		return bool(p_preset->get("grit/enabled"));
+	}
+	return true;
+}
+
+// A compiled template and a VM-only template are different binaries under the same
+// file name (macOS and HTML5 even share one archive for debug and release), so each
+// build records its mode next to the template and a mismatch forces a rebuild.
+static String _template_mode_path(const String &p_template_path) {
+	return p_template_path + ".gritmode";
+}
+
+static bool _template_matches_mode(const String &p_template_path, bool p_grit) {
+	const String marker_path = _template_mode_path(p_template_path);
+	if (!FileAccess::exists(marker_path)) {
+		// Templates built before the marker existed are compiled builds.
+		return p_grit;
+	}
+	return FileAccess::get_file_as_string(marker_path).strip_edges() == (p_grit ? "grit" : "vm");
+}
+
+static void _write_template_mode(const String &p_template_path, bool p_grit) {
+	Ref<FileAccess> file = FileAccess::open(_template_mode_path(p_template_path), FileAccess::WRITE);
+	if (file.is_valid()) {
+		file->store_string(p_grit ? "grit" : "vm");
+	}
+}
+
+void GritExportPlugin::_get_export_options(const Ref<EditorExportPlatform> &p_export_platform, List<EditorExportPlatform::ExportOption> *r_options) const {
+	last_platform = p_export_platform;
+
+	// A Fast template is a real engine build, so link-time optimization is a build
+	// choice worth exposing per preset. "Automatic" keeps the historical policy
+	// (LTO where the toolchain's compiler can do it, none elsewhere); the other
+	// modes force it, and the build helper rejects modes the compiler cannot do.
+	if (_is_fast_platform(p_export_platform)) {
+		// The Grit switch. Off means: no code generation, no stripping, and a plain
+		// engine template, so the game runs entirely on the GDScript VM. The
+		// GRIT_DISABLE=1 environment variable forces it off for every export
+		// (CI/CLI), matching the runtime variable of the same name.
+		r_options->push_back(EditorExportPlatform::ExportOption(
+				PropertyInfo(Variant::BOOL, "grit/enabled"),
+				true));
+		r_options->push_back(EditorExportPlatform::ExportOption(
+				PropertyInfo(Variant::STRING, "grit/lto", PROPERTY_HINT_ENUM, "Automatic,None,Thin,Full"),
+				"Automatic"));
+		// Optimization level of the template build. Speed is what native release
+		// templates always used; the web platform defaults to Size (-Os) to keep the
+		// download small, but Grit-compiled code is measurably faster at -O3.
+		r_options->push_back(EditorExportPlatform::ExportOption(
+				PropertyInfo(Variant::STRING, "grit/optimize", PROPERTY_HINT_ENUM, "None,Speed,Size"),
+				"Speed"));
+	}
+
+	// Give a macOS preset with no output path a sensible default: an .app bundle.
+	// Other extensions are still accepted, this only fills an empty field.
+	Ref<EditorExportPreset> preset = get_export_preset();
+	if (preset.is_valid() && preset->get_export_path().is_empty() && p_export_platform.is_valid() && p_export_platform->get_os_name() == "macOS") {
+		String name = GLOBAL_GET("application/config/name");
+		if (name.is_empty()) {
+			name = "project";
+		}
+		String safe;
+		for (int i = 0; i < name.length(); i++) {
+			const char32_t c = name[i];
+			safe += (is_ascii_alphanumeric_char(c) || c == '-' || c == '_') ? String::chr(c) : String("_");
+		}
+		preset->set_export_path("res://build/" + safe + ".app");
+	}
+	// The VM/Compiled choice lives in the editor toolbar (see editor_node.cpp),
+	// and debug vs release comes from the export dialog's "Export With Debug".
+	// Nothing to add to the preset panel.
+	// No building here: _get_export_options also runs while presets are loaded at
+	// startup, and building there meant opening the editor kicked off a build.
+	// Templates are prepared when the user adds the platform (export_platform_added)
+	// and, as a fallback, just before an export.
+	//
+	// But a "macOS Fast" preset does need to point at its built templates, or the
+	// platform check demands the stock macos.zip and reports "No export template
+	// found". Record whatever already exists; build nothing.
+	if (preset.is_valid() && p_export_platform.is_valid() && p_export_platform->get_os_name() == "macOS") {
+		_apply_default_bundle_identifier(preset);
+	}
+	if (preset.is_valid() && p_export_platform.is_valid() && _is_fast_platform(p_export_platform)) {
+		// Only macOS needs the preset to name its template: its platform check looks
+		// the archive up through custom_template. Linux and Windows Fast resolve it
+		// through find_export_template, and a leftover custom_template there makes the
+		// stock exporter validate a stale file ("Mismatching custom export template
+		// executable architecture: found invalid").
+		const bool macos = p_export_platform->get_os_name() == "macOS";
+		for (int i = 0; i < 2; i++) {
+			const bool debug = i == 1;
+			const String key = debug ? "custom_template/debug" : "custom_template/release";
+			if (macos) {
+				const String path = _compiled_template_path(debug);
+				if (!path.is_empty() && FileAccess::exists(path) && String(preset->get(key)) != path) {
+					preset->set(key, path);
+				}
+			} else if (!String(preset->get(key)).is_empty()) {
+				preset->set(key, "");
+			}
+		}
+	}
+}
+
+// Absolute, normalized form of a folder setting, which may be written as res://.
+static String _absolute_dir(const String &p_path) {
+	String path = p_path.strip_edges();
+	if (path.begins_with("res://")) {
+		path = ProjectSettings::get_singleton()->globalize_path(path);
+	}
+	return path.simplify_path().trim_suffix("/");
+}
+
+// PCK encryption only encrypts files that match the include filters, so an
+// enabled-but-empty preset would export a plaintext pack. The export dialog
+// defaults the field to "*"; do the same for paths that never open the dialog
+// (CLI exports, Export All).
+static void _ensure_pck_encryption_filters(const Ref<EditorExportPreset> &p_preset) {
+	if (p_preset.is_valid() && p_preset->get_enc_pck() && p_preset->get_enc_in_filters_str().strip_edges().is_empty()) {
+		p_preset->set_enc_in_filters_str("*");
+	}
+}
+
+// The generated key file (in each profile tree) embeds the per-export pack key.
+// Older build scripts do not track that value, so an existing tree would keep a
+// previous export's key and the template would not be able to decrypt the pack
+// that was encrypted with the new key. Remove the generated files so the build
+// regenerates them (and relinks the template) every time.
+static void _invalidate_generated_encryption_keys(const String &p_engine_root) {
+	const String profiles = p_engine_root.path_join("out").path_join("grit-profiles");
+	Ref<DirAccess> dir = DirAccess::open(profiles);
+	if (dir.is_null()) {
+		return;
+	}
+	dir->list_dir_begin();
+	for (String name = dir->get_next(); !name.is_empty(); name = dir->get_next()) {
+		if (!dir->current_is_dir() || name.begins_with(".")) {
+			continue;
+		}
+		DirAccess::remove_absolute(profiles.path_join(name).path_join("core").path_join("script_encryption_key.gen.cpp"));
+	}
+	dir->list_dir_end();
+}
+
+static bool _is_inside(const String &p_path, const String &p_root) {
+	return !p_path.is_empty() && (p_path == p_root || p_path.begins_with(p_root + "/"));
+}
+
+// Builds an export template that contains the project's generated code, by
+// running tools/grit_build.py inside the engine source tree. One resolver decides
+// which tree that is (the toolchain's declared source first, a checkout next to
+// the editor as a fallback); nothing is downloaded here.
+String GritExportPlugin::_resolve_engine_root() const {
+	if (!resolved_engine_root.is_empty()) {
+		return resolved_engine_root;
+	}
+	String error;
+	const String root = GritProvisioner::ensure_engine(&error);
+	if (!root.is_empty()) {
+		resolved_engine_root = root;
+		return resolved_engine_root;
+	}
+	if (!error.is_empty()) {
+		ERR_PRINT("Grit: " + error);
+	}
+	return String();
+}
+
+void GritExportPlugin::export_platform_added(const Ref<EditorExportPreset> &p_preset) {
+	if (p_preset.is_null()) {
+		return;
+	}
+	const Ref<EditorExportPlatform> platform = p_preset->get_platform();
+	if (platform.is_null()) {
+		return;
+	}
+	const String os_name = platform->get_os_name();
+	if (os_name != "macOS" && os_name != "Linux" && os_name != "Windows") {
+		return;
+	}
+	// Only this editor's own platform: a Fast template is a native build.
+	if (os_name != OS::get_singleton()->get_name()) {
+		ERR_PRINT(vformat("Grit: \"%s\" cannot be built by an editor running on %s.", platform->get_name(), OS::get_singleton()->get_name()));
+		return;
+	}
+
+	if (os_name == "macOS") {
+		_apply_default_bundle_identifier(p_preset);
+		// This engine's templates are arm64 (the tree is built with arch=arm64). A new
+		// preset defaults to "universal", which would ask for a binary no template
+		// here contains, so pick the architecture that can be built.
+		if (String(p_preset->get("binary_format/architecture")) != "arm64") {
+			p_preset->set("binary_format/architecture", "arm64");
+			print_line("Grit: set this preset's architecture to arm64, because templates are built with arch=arm64.");
+		}
+	}
+
+	// Every platform here is a Fast platform, and each is only registered on its own
+	// host, so the template can always be built natively. Build both variants now so
+	// the first export does not spend minutes compiling.
+	const bool grit_enabled = _grit_enabled(p_preset);
+	for (int i = 0; i < 2; i++) {
+		const bool debug = i == 1;
+		String expected = _compiled_template_path(debug);
+		const String mode_name = grit_enabled ? "compiled" : "VM-only";
+		if (!_template_needs_rebuild(expected, grit_enabled)) {
+			print_line(vformat("Grit: the %s %s template already exists and is newer than the project's scripts; not rebuilding it.", debug ? "debug" : "release", mode_name));
+			continue;
+		}
+		print_line(vformat("Grit: building the %s %s template for this project.", debug ? "debug" : "release", mode_name));
+		String built;
+		Error build_error = OK;
+		if (grit_enabled) {
+			build_error = _generate_and_build(debug, built);
+		} else {
+			const String vm_dir = ProjectSettings::get_singleton()->globalize_path(GLOBAL_GET(SETTING_GENERATED_DIRECTORY)).get_base_dir().path_join("vm");
+			DirAccess::make_dir_recursive_absolute(vm_dir);
+			build_error = _build_template(vm_dir, debug, built, false);
+		}
+		if (build_error != OK) {
+			ERR_PRINT(vformat("Grit: the %s %s template could not be built; the export will report this again.", debug ? "debug" : "release", mode_name));
+		}
+	}
+}
+
+void GritExportPlugin::export_dialog_opened() {
+	// The preset for this editor's own platform is created here so the window shows
+	// something usable. Nothing is downloaded: the toolchain carries the engine
+	// source.
+	_ensure_native_preset();
+}
+
+void GritExportPlugin::_ensure_native_preset() {
+	EditorExport *exporter = EditorExport::get_singleton();
+	if (!exporter) {
+		return;
+	}
+	// This editor's own platform, plus HTML5: wasm is cross-compiled from every
+	// host, so the web preset is offered everywhere.
+	const Vector<String> wanted = { OS::get_singleton()->get_name() + " Fast", "HTML5 Fast" };
+	for (const String &name : wanted) {
+		Ref<EditorExportPlatform> platform;
+		for (int i = 0; i < exporter->get_export_platform_count(); i++) {
+			const Ref<EditorExportPlatform> candidate = exporter->get_export_platform(i);
+			if (candidate.is_valid() && candidate->get_name() == name) {
+				platform = candidate;
+				break;
+			}
+		}
+		if (platform.is_null()) {
+			continue;
+		}
+		bool exists = false;
+		for (int i = 0; i < exporter->get_export_preset_count(); i++) {
+			const Ref<EditorExportPreset> existing = exporter->get_export_preset(i);
+			if (existing.is_valid() && existing->get_platform() == platform) {
+				exists = true;
+				break;
+			}
+		}
+		if (exists) {
+			continue;
+		}
+		const Ref<EditorExportPreset> preset = platform->create_preset();
+		if (preset.is_null()) {
+			continue;
+		}
+		preset->set_name(name);
+		preset->set_runnable(true);
+		if (name == "HTML5 Fast") {
+			// No threads by default: it needs cross-origin isolation on the server.
+			preset->set("variant/thread_support", false);
+			preset->set("variant/extensions_support", false);
+		} else {
+			preset->set("binary_format/architecture", OS::get_singleton()->get_name() == "macOS" ? "arm64" : "x86_64");
+		}
+		// The exporter refuses to run without a texture format.
+		preset->set("texture_format/s3tc_bptc", true);
+		if (name == "macOS Fast") {
+			// macOS refuses to export without a bundle identifier, and an empty
+			// field only surfaces as a validation error later.
+			_apply_default_bundle_identifier(preset);
+		}
+		exporter->add_export_preset(preset, 0);
+		exporter->save_presets();
+		print_line("Grit: added the \"" + name + "\" preset.");
+	}
+}
+void GritExportPlugin::export_platform_removed(const Ref<EditorExportPreset> &p_preset) {
+	if (p_preset.is_null()) {
+		return;
+	}
+	const Ref<EditorExportPlatform> platform = p_preset->get_platform();
+	if (platform.is_null() || platform->get_os_name() != "macOS") {
+		return;
+	}
+	print_line("Grit: export preset removed; cleaning up its templates.");
+
+	// Every template this fork builds lives in the project's exports directory, so a
+	// deleted preset takes its own with it. Only the shared, global locations that
+	// older layouts used are listed as legacy candidates.
+	Vector<String> candidates;
+	candidates.push_back(_compiled_template_path(false));
+	// Older layouts kept the template elsewhere; remove those too if they exist.
+	candidates.push_back(EditorPaths::get_singleton()->get_export_templates_dir().path_join(GODOT_VERSION_FULL_CONFIG).path_join("macos_fast.zip"));
+	const String engine_root = _resolve_engine_root();
+	if (!engine_root.is_empty()) {
+		const String safe = _safe_project_name();
+		candidates.push_back(engine_root.path_join("bin/grit_templates").path_join(safe + "_release_compiled.zip"));
+		candidates.push_back(engine_root.path_join("bin/grit_templates").path_join(safe + "_debug_compiled.zip"));
+	}
+	for (const String &path : candidates) {
+		if (path.is_empty() || !FileAccess::exists(path)) {
+			continue;
+		}
+		if (DirAccess::remove_absolute(path) == OK) {
+			print_line("Grit: removed the export template " + path);
+		} else {
+			ERR_PRINT("Grit: could not remove the export template " + path);
+		}
+	}
+}
+
+
+
+Error GritExportPlugin::_build_template(const String &p_generated_dir, bool p_debug, String &r_template_path, bool p_grit) {
+	// PCK encryption (white-box keystream): the export encrypts the pack with a
+	// random 256-bit pack key generated here, and the template is built with that
+	// very key baked into its white-box AES tables. At pack-open the game asks the
+	// tables for AES block encryptions and decodes the CFB stream through them, so
+	// the pack key never exists in the exported process. The user key comes from
+	// the preset, or from GODOT_SCRIPT_ENCRYPTION_KEY for CI (which wins, like
+	// EditorExportPlatform::_get_script_encryption_key()); it keys the table layout
+	// and the isolated build tree, not the pack.
+	String script_encryption_key;
+	bool encrypt_pck = false;
+	{
+		const Ref<EditorExportPreset> key_preset = get_export_preset();
+		if (key_preset.is_valid()) {
+			encrypt_pck = key_preset->get_enc_pck();
+			// Read the user's key, not the data key this plugin injected for the export.
+			script_encryption_key = script_key_env_injected ? previous_script_key_env : OS::get_singleton()->get_environment("GODOT_SCRIPT_ENCRYPTION_KEY");
+			if (script_encryption_key.is_empty()) {
+				script_encryption_key = key_preset->get_script_encryption_key();
+			}
+			script_encryption_key = script_encryption_key.strip_edges().to_lower();
+			if (encrypt_pck && script_encryption_key.length() != 64) {
+				ERR_PRINT("Grit: PCK encryption is on but there is no 256-bit AES key. Set the 64-character hexadecimal key in the export window's Encryption section (or GODOT_SCRIPT_ENCRYPTION_KEY).");
+				return ERR_INVALID_PARAMETER;
+			}
+			if (!script_encryption_key.is_empty() && (script_encryption_key.length() != 64 || !script_encryption_key.is_valid_hex_number(false))) {
+				ERR_PRINT(vformat("Grit: the script encryption key must be exactly 64 hexadecimal characters (the current key is %d characters).", script_encryption_key.length()));
+				return ERR_INVALID_PARAMETER;
+			}
+		}
+	}
+	// Link-time optimization for this template. Only the preset decides; the
+	// helper applies the default policy when this is "auto".
+	String lto_mode = "auto";
+	{
+		const Ref<EditorExportPreset> lto_preset = get_export_preset();
+		if (lto_preset.is_valid() && lto_preset->has("grit/lto")) {
+			const String requested = String(lto_preset->get("grit/lto")).strip_edges().to_lower();
+			if (requested == "none" || requested == "thin" || requested == "full") {
+				lto_mode = requested;
+			}
+		}
+	}
+	// Optimization level for this template: None, Speed or Size.
+	String optimize_mode = "speed";
+	{
+		const Ref<EditorExportPreset> optimize_preset = get_export_preset();
+		if (optimize_preset.is_valid() && optimize_preset->has("grit/optimize")) {
+			const String requested = String(optimize_preset->get("grit/optimize")).strip_edges().to_lower();
+			if (requested == "none" || requested == "speed" || requested == "size") {
+				optimize_mode = requested;
+			}
+		}
+	}
+	const String engine_root = _resolve_engine_root();
+	if (engine_root.is_empty()) {
+		ERR_PRINT(vformat("Grit: could not find the Fast_Godot source tree for \"%s\". Install the build tools from the export window (the toolchain carries the engine source), or run an editor built from a checkout, then export again.", OS::get_singleton()->get_executable_path()));
+		return ERR_UNCONFIGURED;
+	}
+	const String script = engine_root.path_join("tools/grit_build.py");
+	if (!FileAccess::exists(script)) {
+		ERR_PRINT(vformat("Grit: the engine tree at \"%s\" has no tools/grit_build.py. It is older than this editor; use the current toolchain bundle or checkout.", engine_root));
+		return ERR_FILE_NOT_FOUND;
+	}
+	// Encryption needs a helper that passes the key to SCons, and the LTO option
+	// needs one that reads it. Toolchains created before either read this file
+	// from an older 4.7.2 snapshot; refuse rather than silently ignoring the
+	// setting (an encryption-less template cannot decrypt its own pack, and an
+	// ignored LTO mode would just be a lie in the preset).
+	const String helper_source = FileAccess::get_file_as_string(script);
+	// GRIT_WB_KEYSTREAM: the helper knows the white-box keystream form, which is the
+	// only encrypted-template form there is (the earlier wrapped form was retired on
+	// 11-21). Refuse an older helper instead of building a template this editor's
+	// export cannot feed.
+	const bool keystream_mode = helper_source.find("GRIT_WB_KEYSTREAM") != -1;
+	if (!script_encryption_key.is_empty()) {
+		if (helper_source.find("SCRIPT_AES256_ENCRYPTION_KEY") == -1 || !keystream_mode) {
+			ERR_PRINT("Grit: the toolchain's build helper predates the white-box keystream PCK encryption this editor produces. Re-download the build tools with this editor; an older toolchain builds a template that cannot decrypt its own pack.");
+			return ERR_UNAVAILABLE;
+		}
+	}
+	if (lto_mode != "auto" && helper_source.find("GRIT_LTO") == -1) {
+		ERR_PRINT("Grit: the toolchain's build helper does not support the LTO option. Re-download the build tools with this editor, or set the preset's LTO option back to Automatic.");
+		return ERR_UNAVAILABLE;
+	}
+	if (optimize_mode != "speed" && helper_source.find("GRIT_OPTIMIZE") == -1) {
+		ERR_PRINT("Grit: the toolchain's build helper does not support the Optimize option. Re-download the build tools with this editor, or set the preset's Optimize option back to Speed.");
+		return ERR_UNAVAILABLE;
+	}
+	String pack_key_hex;
+	if (encrypt_pck) {
+		uint8_t data_key[32];
+		if (CryptoCore::generate_random(data_key, sizeof(data_key)) != OK) {
+			ERR_PRINT("Grit: could not generate the PCK data key.");
+			return ERR_CANT_CREATE;
+		}
+		// No wrapping: the template bakes this key into its tables, and the pack is
+		// encrypted with the very same key, so there is nothing to unwrap.
+		pack_key_hex = String::hex_encode_buffer(data_key, 32);
+		// The stock exporter encrypts the pack with this key, and the template holds
+		// it inside its tables and decodes the CFB stream through them.
+		if (!script_key_env_injected) {
+			previous_script_key_env = OS::get_singleton()->get_environment("GODOT_SCRIPT_ENCRYPTION_KEY");
+			script_key_env_injected = true;
+		}
+		OS::get_singleton()->set_environment("GODOT_SCRIPT_ENCRYPTION_KEY", pack_key_hex);
+		memset(data_key, 0, sizeof(data_key)); // TODO(4.8): upstream removed SecureMemory
+	}
+	// The helper reads both as files (the export build does not inherit the editor's
+	// environment). The user key also keys the isolated template tree; the pack key
+	// changes every export and only triggers a rebuild of the generated file.
+	const String key_path = p_generated_dir.path_join("script_encryption_key.txt");
+	{
+		Ref<FileAccess> key_file = FileAccess::open(key_path, FileAccess::WRITE);
+		if (key_file.is_null()) {
+			ERR_PRINT("Grit: could not write the script encryption key next to the generated sources.");
+			return ERR_CANT_CREATE;
+		}
+		key_file->store_string(script_encryption_key);
+		key_file->close();
+	}
+	// Retired: older exports wrote the wrapped key under this name. Nothing reads it
+	// any more; drop a leftover so it cannot be mistaken for this export's key.
+	const String legacy_key_path = p_generated_dir.path_join("script_wrapped_key.txt");
+	if (FileAccess::exists(legacy_key_path)) {
+		DirAccess::remove_absolute(legacy_key_path);
+	}
+	const String pack_key_path = p_generated_dir.path_join("script_pack_key.txt");
+	{
+		Ref<FileAccess> pack_key_file = FileAccess::open(pack_key_path, FileAccess::WRITE);
+		if (pack_key_file.is_null()) {
+			ERR_PRINT("Grit: could not write the per-export PCK pack key next to the generated sources.");
+			return ERR_CANT_CREATE;
+		}
+		pack_key_file->store_string(pack_key_hex);
+		pack_key_file->close();
+	}
+	// The template belongs to the project (<project>/exports), under whichever name the
+	// target platform resolves. Nothing is written into the preset's custom_template
+	// fields, and stock templates are never touched.
+	const String out_dir = ProjectSettings::get_singleton()->globalize_path("res://exports");
+	DirAccess::make_dir_recursive_absolute(out_dir);
+	// The compiled template is a per-project build artifact: hide the cache from the
+	// editor's filesystem (and therefore from the exported pack).
+	if (!FileAccess::exists(out_dir.path_join(".gdignore"))) {
+		Ref<FileAccess> ignore = FileAccess::open(out_dir.path_join(".gdignore"), FileAccess::WRITE);
+		if (ignore.is_valid()) {
+			ignore->store_string("");
+		}
+	}
+	const String final_path = _compiled_template_path(p_debug);
+	{
+		const Ref<EditorExportPreset> out_preset = get_export_preset();
+		const Ref<EditorExportPlatform> out_platform = out_preset.is_valid() ? out_preset->get_platform() : Ref<EditorExportPlatform>();
+		const bool macos_target = out_platform.is_valid() && out_platform->get_os_name() == "macOS";
+		r_template_path = macos_target ? final_path.get_basename() : final_path;
+	}
+
+	List<String> args;
+	args.push_back(engine_root);
+	args.push_back(p_generated_dir);
+	args.push_back(p_debug ? "debug" : "release");
+	args.push_back(r_template_path);
+	Ref<EditorExportPreset> build_preset = get_export_preset();
+	Ref<EditorExportPlatform> platform = build_preset.is_valid() ? build_preset->get_platform() : Ref<EditorExportPlatform>();
+	const String platform_name = platform.is_valid() ? platform->get_name() : String();
+		String plat_id = platform_name.replace(" Fast", "");
+	if (plat_id == "macOS") {
+		plat_id = "macos";
+	} else if (plat_id == "Linux") {
+		plat_id = "linuxbsd";
+	} else if (plat_id == "Windows") {
+		plat_id = "windows";
+	} else if (plat_id == "HTML5") {
+		plat_id = "web";
+	} else {
+		plat_id = plat_id.to_lower();
+	}
+	// A Fast template is a native build and always has been; this refuses outright
+	// rather than starting one. A preset can be copied in from another project, and
+	// its platform string would otherwise be trusted.
+	const String native_os = OS::get_singleton()->get_name();
+	const String native_id = native_os == "macOS" ? "macos" : (native_os == "Linux" ? "linuxbsd" : native_os.to_lower());
+	// HTML5 is the one target that is not native: Emscripten cross-compiles to wasm
+	// from every host, which is why its preset exists on all of them.
+	if (plat_id != "web" && plat_id != native_id) {
+		ERR_PRINT(vformat("Grit: this editor runs on %s and can only build %s templates; this preset asks for %s.", native_os, native_id, plat_id));
+		return ERR_UNAVAILABLE;
+	}
+
+	// Arch for a *native* build of this platform. Nothing is cross-compiled: a Fast
+	// template is only ever built for the platform the editor runs on.
+	String arch = plat_id == "web" ? String("wasm32") : String("arm64");
+	if (plat_id != "macos" && plat_id != "web") {
+		const Ref<EditorExportPreset> arch_preset = get_export_preset();
+		arch = arch_preset.is_valid() ? String(arch_preset->get("binary_format/architecture")) : String();
+		if (arch.is_empty()) {
+			arch = "x86_64";
+		}
+	}
+
+	args.push_back(plat_id);
+
+	// The template is always a real SCons build in an isolated copy (see
+	// grit_build.py): Grit is only compiled into a template when
+	// grit_generated points at this project's sources, so there is no Grit-free
+	// binary to relink against. A project without a profile gets the default
+	// module set, written out as an empty profile. Hand it over as a file:
+	// OS::execute does not inherit the editor's environment.
+	// A project may point at a build profile of its own; otherwise the template is
+	// built with the full engine. Validate it here so a bad file fails the export
+	// with a readable error instead of dying inside SCons.
+	String profile_json = "{\n\t\"type\": \"build_profile\"\n}\n";
+	const String profile_setting = String(ProjectSettings::get_singleton()->get_setting(SETTING_BUILD_PROFILE, "")).strip_edges();
+	if (!profile_setting.is_empty()) {
+		const String profile_path = profile_setting.begins_with("res://") ? ProjectSettings::get_singleton()->globalize_path(profile_setting) : profile_setting;
+		Error profile_error = OK;
+		const String profile_source = FileAccess::get_file_as_string(profile_path, &profile_error);
+		if (profile_error != OK || profile_source.strip_edges().is_empty()) {
+			ERR_PRINT(vformat("Grit: could not read the engine compilation profile \"%s\". Choose a readable .build/.gdbuild file in Project Settings > Grit > Export > Build Profile.", profile_setting));
+			return ERR_FILE_CANT_READ;
+		}
+		const Variant parsed_profile = JSON::parse_string(profile_source);
+		if (parsed_profile.get_type() != Variant::DICTIONARY || !Dictionary(parsed_profile).has("type") || String(Dictionary(parsed_profile)["type"]) != "build_profile") {
+			ERR_PRINT(vformat("Grit: \"%s\" is not an engine compilation profile: it needs \"type\": \"build_profile\". Save one with the editor's build profile tool (.build/.gdbuild).", profile_setting));
+			return ERR_INVALID_DATA;
+		}
+		print_line("Grit: using the build profile at " + profile_setting);
+		profile_json = profile_source;
+	}
+	String build_profile = p_generated_dir.path_join("build_profile.json");
+	{
+		Ref<FileAccess> profile_file = FileAccess::open(build_profile, FileAccess::WRITE);
+		if (profile_file.is_valid()) {
+			profile_file->store_string(profile_json);
+			profile_file->close();
+		} else {
+			build_profile = String();
+			ERR_PRINT("Grit: could not write the build profile next to the generated sources.");
+			return ERR_CANT_CREATE;
+		}
+	}
+	args.push_back(build_profile);
+	args.push_back(arch);
+	// Legacy argument for helpers that predate the Optimize option: the web
+	// platform reads "optimized" as -O3 and anything else as -Os. Native platforms
+	// ignore it, and newer helpers use the explicit mode passed further down.
+	String web_optimization = optimize_mode == "size" ? "size" : "optimized";
+	args.push_back(web_optimization);
+
+	args.push_back(key_path);
+	args.push_back(pack_key_path);
+	// "auto" | "none" | "thin" | "full" and "none" | "speed" | "size": the last
+	// arguments on purpose, so an older helper simply ignores them.
+	args.push_back(lto_mode);
+	args.push_back(optimize_mode);
+	// The 11th argument is the pack key itself when this says "keystream" (the only
+	// encrypted-template form); empty when the template is not encrypted.
+	args.push_back(encrypt_pck ? "keystream" : "");
+	// "vm" tells the helper to build without `grit_generated`, which is what makes
+	// the engine compile its fallback (empty) registry instead of this project's code.
+	args.push_back(p_grit ? "" : "vm");
+	// The web template defaults to single-threaded so an export runs from any static
+	// host. The preset can opt in (variant/thread_support), which needs COOP/COEP on
+	// the host; the helper builds the template to match the generated HTML.
+	args.push_back(plat_id == "web" && build_preset.is_valid() && bool(build_preset->get("variant/thread_support")) ? "threads" : "");
+
+	print_line("Grit: building the compiled template (compiles the generated code and links it).");
+
+	// Run the build as a child process and follow its log, so the editor stays
+	// responsive and the modal progress reports what is happening.
+	// The helper writes build.log. It must not be last_build.log: this loop keeps a
+	// read handle on the file it tails, and on Windows that denies the helper's write,
+	// which failed every editor-driven build with a bare exit 1.
+	const String log_path = engine_root.path_join("bin/grit").path_join(p_debug ? "debug" : "release").path_join("build.log");
+	// Empty the log before spawning. The helper truncates it as well, but the poll
+	// below can run before it does, and would then show the previous build's last
+	// line as if it belonged to this one.
+	{
+		Ref<FileAccess> stale_log = FileAccess::open(log_path, FileAccess::WRITE);
+		if (stale_log.is_valid()) {
+			stale_log->close();
+		}
+	}
+	// The helper is Python: the toolchain bundle already ships an interpreter, and
+	// this way no platform needs a shell, rsync or coreutils.
+	const String python = GritProvisioner::python_for_build();
+	if (python.is_empty()) {
+		ERR_PRINT("Grit: no Python interpreter found to run the build helper.");
+		return ERR_CANT_CREATE;
+	}
+	if (!script_encryption_key.is_empty()) {
+		_invalidate_generated_encryption_keys(engine_root);
+	}
+	GritProvisioner::write_build_env(engine_root);
+	ProcessID pid = 0;
+	List<String> python_args;
+	python_args.push_back(script);
+	for (const String &arg : args) {
+		python_args.push_back(arg);
+	}
+	const Error spawn = OS::get_singleton()->create_process(python, python_args, &pid);
+	if (spawn != OK) {
+		ERR_PRINT("Grit: could not start the build helper " + script + " through " + python);
+		return ERR_CANT_CREATE;
+	}
+
+	// No cancel button: a click needs a GUI frame, and this export is synchronous.
+	// Esc is polled instead, which only needs the event queue to be pumped.
+	EditorProgress progress("grit_build", TTR("Building compiled export (Esc to cancel)"), 100, false);
+	int shown_percent = -1;
+	String shown_line;
+	int lines_seen = 0;
+	bool cancel_requested = false;
+	while (OS::get_singleton()->is_process_running(pid)) {
+		String current_line;
+		// The read handle must not outlive the read: on Windows a reader without
+		// share-write denies the helper's open of the same log, and the helper only
+		// retries for a few seconds. Keeping this in its own scope releases the
+		// handle before the delay below, which leaves the helper a window to open
+		// the file (a helper that lost the startup race otherwise fails with
+		// "Permission denied" before it even reads build_env.json).
+		{
+			Ref<FileAccess> log_file = FileAccess::open(log_path, FileAccess::READ);
+			if (log_file.is_valid()) {
+				const PackedStringArray lines = log_file->get_as_text().split("\n");
+				lines_seen = lines.size();
+				for (int i = lines.size() - 1; i >= 0; i--) {
+					const String line = lines[i].strip_edges();
+					if (!line.is_empty()) {
+						current_line = line.left(120);
+						break;
+					}
+				}
+			}
+		}
+		// SCons does not report a percentage here, so advance on log activity:
+		// monotonic, capped below 100 until the process actually exits.
+		const int percent = CLAMP(5 + lines_seen / 20, 5, 95);
+		const bool changed = percent != shown_percent || current_line != shown_line;
+		// The export runs on the main thread and blocks it, so nothing else
+		// dispatches input events. Without pumping here no key event ever reaches
+		// Input, and Esc is only noticed if it happens to be held across a
+		// repaint — which is why a tap appeared to need two presses.
+		if (DisplayServer::get_singleton()) {
+			DisplayServer::get_singleton()->process_events();
+		}
+		// Ask the helper to cancel: it owns its scons child, so we never have to
+		// signal another process (which Godot's process bookkeeping rejects).
+		if (Input::get_singleton()->is_key_pressed(Key::ESCAPE) && !cancel_requested) {
+			Ref<FileAccess> cf = FileAccess::open(log_path.get_base_dir().path_join("cancel_build"), FileAccess::WRITE);
+			if (cf.is_valid()) {
+				cf->store_string("1");
+				cf->close();
+			}
+			cancel_requested = true;
+			print_line("Grit: cancelling the build...");
+		}
+		progress.step(current_line, percent, changed);
+		shown_percent = percent;
+		shown_line = current_line;
+		// Poll often enough not to miss a key tap.
+		OS::get_singleton()->delay_usec(30000);
+	}
+	const int exit_code = OS::get_singleton()->get_process_exit_code(pid);
+	if (cancel_requested || exit_code == 3) {
+		ERR_PRINT("Grit: build cancelled.");
+		return ERR_SKIP;
+	}
+	if (exit_code != 0) {
+		ERR_PRINT("Grit: template build failed (exit " + itos(exit_code) + ") running \"" + python + "\" \"" + script + "\" for engine \"" + engine_root + "\".");
+		Ref<FileAccess> log_file = FileAccess::open(log_path, FileAccess::READ);
+		if (log_file.is_valid()) {
+			const String tail = log_file->get_as_text().right(4000);
+			ERR_PRINT(tail.right(2000));
+		}
+		return ERR_CANT_CREATE;
+	}
+	if (platform_name.begins_with("macOS")) {
+		r_template_path += ".zip";
+	}
+	_write_template_mode(final_path, p_grit);
+	print_line("Grit: compiled executable written to " + r_template_path + ".");
+	return OK;
+}
+
+// Code generation plus the template build. Runs from prepare_export() before the
+// platform starts, so a failure can stop the export cleanly instead of producing
+// a VM app; _export_begin() calls it too for export paths that do not prepare.
+Error GritExportPlugin::_generate_and_build(bool p_debug, String &r_template_path) {
+	// The export window's "Strip Scripts" checkbox wins; the project setting is the
+	// fallback for command-line exports and "Export All".
+	bool strip_requested = bool(ProjectSettings::get_singleton()->get_setting(OPTION_STRIP_SCRIPTS, false));
+	if (EditorSettings *editor_settings = EditorSettings::get_singleton()) {
+		// A non-BOOL default means "not stored by the export window": no error, and
+		// the project setting above stays in charge.
+		const Variant stored = editor_settings->get_project_metadata("export_options", "strip_scripts", String());
+		if (stored.get_type() == Variant::BOOL) {
+			strip_requested = bool(stored);
+		}
+	}
+	const bool strip = strip_requested && !p_debug;
+	if (strip_requested && p_debug) {
+		print_line("Grit: scripts are only stripped in release exports, this debug export keeps them.");
+	}
+
+	const String output_directory = ProjectSettings::get_singleton()->globalize_path(GLOBAL_GET(SETTING_GENERATED_DIRECTORY));
+	GritProjectCompiler compiler;
+	GritProjectCompiler::Report report;
+	const Error error = compiler.compile(output_directory, strip, report);
+	if (error != OK) {
+		ERR_PRINT("Grit: native code generation failed.");
+		return error;
+	}
+
+	stripped_sources = report.stripped_sources;
+	const PackedByteArray pack_fingerprint = GritRegistry::make_pack_fingerprint(report.fingerprint, strip).to_utf8_buffer();
+	customization_hash = GritRegistry::make_pack_fingerprint(report.fingerprint, strip).hash64();
+	prepared_fingerprint = pack_fingerprint;
+	print_line(vformat("Grit: generated C++ written to \"%s\".", output_directory));
+
+	return _build_template(output_directory, p_debug, r_template_path);
+}
+
+// Newest modification time of anything that can affect the generated code, so a
+// template built before the last script edit is treated as stale.
+static void _newest_project_source(const String &p_dir, uint64_t &r_newest) {
+	Ref<DirAccess> dir = DirAccess::open(p_dir);
+	if (dir.is_null()) {
+		return;
+	}
+	dir->list_dir_begin();
+	for (String name = dir->get_next(); !name.is_empty(); name = dir->get_next()) {
+		if (name.begins_with(".")) {
+			continue;
+		}
+		const String path = p_dir.path_join(name);
+		if (dir->current_is_dir()) {
+			_newest_project_source(path, r_newest);
+		} else if (name.ends_with(".gd") || name.ends_with(".tscn") || name.ends_with(".tres") || name.ends_with(".cs")) {
+			const uint64_t modified = FileAccess::get_modified_time(path);
+			if (modified > r_newest) {
+				r_newest = modified;
+			}
+		}
+	}
+	dir->list_dir_end();
+}
+
+bool GritExportPlugin::_template_needs_rebuild(const String &p_template_path, bool p_grit) const {
+	if (p_template_path.is_empty() || !FileAccess::exists(p_template_path)) {
+		return true;
+	}
+	if (!_template_matches_mode(p_template_path, p_grit)) {
+		// Built for the other mode: a compiled binary cannot stand in for a VM-only
+		// export (it carries native code), and the reverse would run on the VM while
+		// the preset asked for native code.
+		return true;
+	}
+	uint64_t newest = 0;
+	_newest_project_source("res://", newest);
+	return newest > FileAccess::get_modified_time(p_template_path);
+}
+
+// Fast template file name for a target platform, matching what its Fast export
+// platform resolves.
+static String _fast_template_name(const String &p_os, bool p_debug, const String &p_arch) {
+	const String target = p_debug ? "debug" : "release";
+	if (p_os == "Windows") {
+		return "windows_fast_" + target + "_" + p_arch + ".exe";
+	}
+	if (p_os == "Linux") {
+		return "linux_fast_" + target + "." + p_arch;
+	}
+	return "macos_fast.zip";
+}
+
+String GritExportPlugin::_compiled_template_path(bool p_debug) const {
+	const Ref<EditorExportPreset> preset = get_export_preset();
+	const Ref<EditorExportPlatform> platform = preset.is_valid() ? preset->get_platform() : Ref<EditorExportPlatform>();
+	// HTML5 takes one zip of wasm/js/html for both variants, like macOS does.
+	if (platform.is_valid() && platform->get_name() == "HTML5 Fast") {
+		return ProjectSettings::get_singleton()->globalize_path("res://exports").path_join(EditorExportPlatformWebFast::TEMPLATE_FILE);
+	}
+	if (platform.is_valid() && platform->get_os_name() != "macOS") {
+		// Other platforms take one binary per target, named the way their platform
+		// expects (windows_fast_release_x86_64.exe, linux_fast_release.x86_64).
+		String arch = preset.is_valid() ? String(preset->get("binary_format/architecture")) : String();
+		if (arch.is_empty()) {
+			arch = "x86_64";
+		}
+		return ProjectSettings::get_singleton()->globalize_path("res://exports").path_join(_fast_template_name(platform->get_os_name(), p_debug, arch));
+	}
+	// macOS packages a single archive for both variants.
+	return EditorExportPlatformMacOSFast::template_path();
+}
+
+Error GritExportPlugin::_prepare_vm(const Ref<EditorExportPreset> &p_preset, bool p_debug) {
+	script_mode = p_preset.is_valid() ? p_preset->get_script_export_mode() : EditorExportPreset::MODE_SCRIPT_BINARY_TOKENS_COMPRESSED;
+	stripped_sources.clear();
+	prepared_compiled = false;
+	prepared_vm = true;
+	prepared_debug = p_debug;
+
+	// Always go through the build: an encrypted export gets a fresh pack key, so the
+	// template's generated key file must be regenerated and the template relinked
+	// (a warm tree does that in a few seconds, exactly like the compiled path).
+	print_line("Grit: Grit is disabled for this export; building a VM-only template (the game runs on the GDScript VM).");
+	// A scratch directory for the key files and profile: it deliberately holds no
+	// generated code, which is what makes the build a plain engine template.
+	const String vm_dir = ProjectSettings::get_singleton()->globalize_path(GLOBAL_GET(SETTING_GENERATED_DIRECTORY)).get_base_dir().path_join("vm");
+	DirAccess::make_dir_recursive_absolute(vm_dir);
+	String built;
+	return _build_template(vm_dir, p_debug, built, false);
+}
+
+Error GritExportPlugin::_prepare_compiled(const Ref<EditorExportPreset> &p_preset, bool p_debug) {
+	script_mode = p_preset.is_valid() ? p_preset->get_script_export_mode() : EditorExportPreset::MODE_SCRIPT_BINARY_TOKENS_COMPRESSED;
+
+	String template_path;
+	const Error build_error = _generate_and_build(p_debug, template_path);
+	if (build_error != OK) {
+		return build_error;
+	}
+
+	// Deliberately nothing is written into the preset: the platform finds its
+	// template in the default templates directory by name.
+	(void)template_path;
+	prepared_compiled = true;
+	prepared_vm = false;
+	prepared_debug = p_debug;
+	return OK;
+}
+
+Error GritExportPlugin::prepare_export(const Ref<EditorExportPreset> &p_preset, bool p_debug, const String &p_path) {
+
+	const Ref<EditorExportPreset> platform_preset = get_export_preset();
+	_ensure_pck_encryption_filters(platform_preset);
+	if (platform_preset.is_valid() && platform_preset->get_platform().is_valid() && platform_preset->get_platform()->get_os_name() == "macOS") {
+		_apply_default_bundle_identifier(platform_preset);
+	}
+	// The source is fetched now, not when the window opened: this is the point where
+	// a build is actually going to happen, so a progress dialog belongs here.
+	String engine_error;
+	if (GritProvisioner::ensure_engine(&engine_error).is_empty()) {
+		ERR_PRINT("Grit: " + engine_error);
+		return ERR_CANT_CREATE;
+	}
+
+	// Neither the engine source nor the toolchain may live inside the project: the
+	// editor's file scan tries to import them, the Grit compiler then tries to
+	// compile the engine's own scripts (which do not parse as project scripts), and
+	// the export would pack either tree as game content.
+	{
+		const String project_root = _absolute_dir(ProjectSettings::get_singleton()->globalize_path("res://"));
+		const String engine_root = _absolute_dir(_resolve_engine_root());
+		if (!engine_root.is_empty() && _is_inside(engine_root, project_root)) {
+			ERR_PRINT(vformat("Grit: the Fast_Godot source tree is inside the project (\"%s\"). Move the checkout (or the toolchain) out of the project folder; otherwise its scripts are scanned, compiled and packed as game content.", engine_root));
+			return ERR_INVALID_DATA;
+		}
+		const String toolchain_root = _absolute_dir(GritProvisioner::configured_toolchain());
+		if (!toolchain_root.is_empty() && _is_inside(toolchain_root, project_root)) {
+			ERR_PRINT(vformat("Grit: the toolchain is inside the project (\"%s\"). Move it out of the project folder and set Editor Settings > Grit > Settings > ToolChain Root Folder Path to the new location; otherwise its files are imported and packed as game content.", toolchain_root));
+			return ERR_INVALID_DATA;
+		}
+		// A tree left behind by an earlier download into the project does just as much
+		// damage even after the setting was pointed elsewhere: Grit compiles every
+		// script under res:// and would die on the engine's script templates. Name it
+		// instead of failing on the first one.
+		Ref<DirAccess> project_dir = DirAccess::open("res://");
+		if (project_dir.is_valid()) {
+			for (const String &name : project_dir->get_directories()) {
+				const String candidate = String("res://") + name;
+				if (FileAccess::exists(candidate.path_join("SConstruct")) && FileAccess::exists(candidate.path_join("tools").path_join("grit_build.py"))) {
+					ERR_PRINT(vformat("Grit: %s is a Fast_Godot source tree inside the project. Move the checkout (or the toolchain) out of the project folder; every script under res:// is treated as project content.", candidate));
+					return ERR_INVALID_DATA;
+				}
+			}
+		}
+	}
+
+	// HTML5 is cross-compiled by Emscripten on every host, so it is exempt.
+	const bool web_target = platform_preset.is_valid() && platform_preset->get_platform().is_valid() && platform_preset->get_platform()->get_name() == "HTML5 Fast";
+	if (web_target) {
+		// The HTML5 Fast template is built with webgpu=yes opengl3=no and this
+		// backend only implements the Forward Mobile renderer. Reject anything else
+		// before the template build, which is the expensive part of the export.
+		const String rendering_method = ProjectSettings::get_singleton()->get("rendering/renderer/rendering_method.web");
+		if (rendering_method != "mobile") {
+			ERR_PRINT(vformat("The HTML5 Fast template only contains the WebGPU Forward Mobile renderer; set rendering/renderer/rendering_method.web to \"mobile\" (currently \"%s\").", rendering_method));
+			return ERR_UNCONFIGURED;
+		}
+	}
+	if (!web_target && platform_preset.is_valid() && platform_preset->get_platform().is_valid() && _is_fast_platform(platform_preset->get_platform()) && !_is_host_platform(platform_preset->get_platform()->get_os_name())) {
+		ERR_PRINT(vformat("Grit: \"%s\" templates are built on a %s host; this build does not cross-compile. Export for that platform from its own editor, or add the stock \"%s\" platform instead.",
+				platform_preset->get_platform()->get_name(),
+				platform_preset->get_platform()->get_os_name(),
+				platform_preset->get_platform()->get_os_name()));
+		return ERR_UNAVAILABLE;
+	}
+	if (!_is_fast_platform(platform_preset.is_valid() ? platform_preset->get_platform() : Ref<EditorExportPlatform>())) {
+		// Only Fast platforms are registered, so this is a preset for a platform that
+		// does not exist here.
+		return OK;
+	}
+	_apply_default_bundle_identifier(p_preset);
+	if (p_preset.is_valid()) {
+		const Ref<EditorExportPlatform> clear_platform = platform_preset.is_valid() ? platform_preset->get_platform() : Ref<EditorExportPlatform>();
+		const bool clear_fast = clear_platform.is_valid() && _is_fast_platform(clear_platform) && clear_platform->get_os_name() != "macOS";
+		for (const char *key : { "custom_template/debug", "custom_template/release" }) {
+			// Native Fast platforms (Linux/Windows) resolve their template themselves;
+			// a stale custom_template makes the exporter reject the file's arch before
+			// the freshly built template is used.
+			if (clear_fast) {
+				p_preset->set(key, "");
+			}
+		}
+	}
+	if (!_grit_enabled(p_preset)) {
+		print_line("Grit: Grit is disabled for this export (preset option or GRIT_DISABLE); the game runs on the GDScript VM.");
+		const Error vm_error = _prepare_vm(p_preset, p_debug);
+		if (vm_error != OK) {
+			ERR_PRINT("Grit: the VM-only template did not build; the export is cancelled and nothing was written.");
+		}
+		return vm_error;
+	}
+	const Error error = _prepare_compiled(p_preset, p_debug);
+	if (error != OK) {
+		ERR_PRINT("Grit: compiled build did not complete; the export is cancelled and nothing was written.");
+	}
+	return error;
+}
+
+void GritExportPlugin::_export_begin(const HashSet<String> &p_features, bool p_debug, const String &p_path, int p_flags) {
+
+
+	const Ref<EditorExportPreset> preset = get_export_preset();
+	if (!_is_fast_platform(preset.is_valid() ? preset->get_platform() : Ref<EditorExportPlatform>())) {
+		// This fork registers only Fast platforms; an extension-provided platform
+		// simply gets no Grit customization.
+		stripped_sources.clear();
+		return;
+	}
+	_ensure_pck_encryption_filters(preset);
+
+	// Grit disabled: nothing is compiled or stripped, and no fingerprint is added.
+	// The template's fallback registry has no native functions, so the game runs
+	// every script on the GDScript VM.
+	if (!_grit_enabled(preset)) {
+		if (prepared_vm && prepared_debug == p_debug) {
+			return;
+		}
+		stripped_sources.clear();
+		if (_prepare_vm(preset, p_debug) != OK) {
+			if (preset.is_valid()) {
+				preset->set(p_debug ? "custom_template/debug" : "custom_template/release", "res://.grit-build-did-not-complete");
+				ERR_PRINT("Grit: the VM-only template did not build; the export is abandoned.");
+			}
+		}
+		return;
+	}
+
+	// The normal path: prepare_export() already generated the code and built the
+	// template, and the platform is about to pack with it.
+	if (prepared_compiled && prepared_debug == p_debug) {
+		add_file(GritRegistry::get_fingerprint_path(), prepared_fingerprint, false);
+		return;
+	}
+
+	// Export paths that never call prepare_export() (they bypass the editor's
+	// dialog). Do the work here and abandon the export if it fails.
+	stripped_sources.clear();
+	const Error error = _prepare_compiled(preset, p_debug);
+	if (error != OK) {
+		if (preset.is_valid()) {
+			// A path that cannot exist: makes the platform refuse the export instead of
+			// packing a game against a stale template.
+			preset->set(p_debug ? "custom_template/debug" : "custom_template/release", "res://.grit-build-did-not-complete");
+			ERR_PRINT("Grit: compiled build did not complete; the export is abandoned. Run it again (or switch the toolbar to VM for a normal export).");
+		}
+		return;
+	}
+	add_file(GritRegistry::get_fingerprint_path(), prepared_fingerprint, false);
+}
+
+void GritExportPlugin::_export_end() {
+	// Restore GODOT_SCRIPT_ENCRYPTION_KEY: the data key we injected for this export
+	// must not leak into the next one (the user's key/preset stays as it was).
+	if (script_key_env_injected) {
+		if (previous_script_key_env.is_empty()) {
+			OS::get_singleton()->unset_environment("GODOT_SCRIPT_ENCRYPTION_KEY");
+		} else {
+			OS::get_singleton()->set_environment("GODOT_SCRIPT_ENCRYPTION_KEY", previous_script_key_env);
+		}
+		script_key_env_injected = false;
+		previous_script_key_env = String();
+	}
+	// Put the preset back exactly as it was found: a compiled export must not
+	// change how a later VM export behaves, and the compiled template path must
+	// never survive in export_presets.cfg.
+	if (templates_saved) {
+		const Ref<EditorExportPreset> preset = get_export_preset();
+		if (preset.is_valid()) {
+			preset->set("custom_template/debug", previous_template_debug);
+			preset->set("custom_template/release", previous_template_release);
+		}
+		templates_saved = false;
+		previous_template_debug = String();
+		previous_template_release = String();
+	}
+	prepared_compiled = false;
+	prepared_vm = false;
+	prepared_debug = false;
+	prepared_fingerprint = PackedByteArray();
+	stripped_sources.clear();
+}
+
+void GritExportPlugin::_export_file(const String &p_path, const String &p_type, const HashSet<String> &p_features) {
+	const String *source = stripped_sources.getptr(p_path);
+	if (!source) {
+		return;
+	}
+	if (script_mode == EditorExportPreset::MODE_SCRIPT_TEXT) {
+		add_file(p_path, source->to_utf8_buffer(), false);
+		skip();
+		return;
+	}
+	const GDScriptTokenizerBuffer::CompressMode compress_mode = script_mode == EditorExportPreset::MODE_SCRIPT_BINARY_TOKENS_COMPRESSED ? GDScriptTokenizerBuffer::COMPRESS_ZSTD : GDScriptTokenizerBuffer::COMPRESS_NONE;
+	const Vector<uint8_t> tokens = GDScriptTokenizerBuffer::parse_code_string(*source, compress_mode);
+	ERR_FAIL_COND_MSG(tokens.is_empty(), vformat("Grit: could not tokenize the stripped \"%s\".", p_path));
+	add_file(p_path.get_basename() + ".gdc", tokens, true);
+}
+
+bool GritExportPlugin::_begin_customize_resources(const Ref<EditorExportPlatform> &p_platform, const Vector<String> &p_features) {
+	for (const KeyValue<String, String> &entry : stripped_sources) {
+		if (entry.key.contains("::")) {
+			return true;
+		}
+	}
+	return false;
+}
+
+Ref<Resource> GritExportPlugin::_customize_resource(const Ref<Resource> &p_resource, const String &p_path) {
+	const Ref<GDScript> script = p_resource;
+	if (script.is_null() || !script->is_built_in()) {
+		return Ref<Resource>();
+	}
+	const String *source = stripped_sources.getptr(script->get_path());
+	if (!source || ResourceCache::get_ref(script->get_path()).ptr() == script.ptr()) {
+		return Ref<Resource>();
+	}
+	script->set_source_code(*source);
+	return script;
+}
+
+uint64_t GritExportPlugin::_get_customization_configuration_hash() const {
+	return customization_hash;
+}
