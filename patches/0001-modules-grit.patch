+	explicit ResumedSlots(GDScriptFunction::CallState *p_state) {
+		slots = reinterpret_cast<Variant *>(const_cast<uint8_t *>(p_state->stack.ptr())) + GDScriptFunction::FIXED_ADDRESSES_MAX;
