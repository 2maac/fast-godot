+_FORCE_INLINE_ int64_t float_to_int(double p_value) {
+#if defined(__aarch64__) || defined(_M_ARM64)
+	// arm64 converts a double with fcvtzs, which saturates: NaN -> 0,
+	// +overflow -> INT64_MAX, -overflow -> INT64_MIN. The VM does exactly this
+	// (a plain cast), so a plain cast here matches it instruction for
+	// instruction - and is cheaper than range checks.
+	return static_cast<int64_t>(p_value);
+#else
+	if (!(p_value >= -9223372036854775808.0 && p_value < 9223372036854775808.0)) {
+		return INT64_MIN;
+	}
+	return static_cast<int64_t>(p_value);
+#endif
