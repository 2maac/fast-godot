+	GritStatement statement = make_statement(GritOpcode::TYPE_TEST);
+	GritOperand source;
+	if (!resolve(p_target, statement.target) || !resolve(p_source, source)) {
+		return;
+	}
+	statement.operands.push_back(source);
+	statement.type = add_type(p_type);
+	append(statement);
+}
