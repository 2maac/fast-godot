+/* IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY   */
+/* CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,   */
+/* TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE      */
+/* SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.                 */
+/**************************************************************************/
+
+#pragma once
+
+#include "core/os/os.h"
+
+// Lightweight main-thread frame profiler for hunt-the-hitch work (mainly the
+// single-threaded HTML5/WebGPU build, where any stall blocks everything).
+//
+// Marks are taken unconditionally (a dozen `get_ticks_usec()` calls per frame is
+// noise), the report is only printed when explicitly enabled with
+// `--frame-profile` / `GODOT_FRAME_PROFILE=1`, or for frames over
+// `AUTO_PRINT_USEC` so a multi-second pause is always reported.
+//
+// The counters are bumped by the rendering driver (WebGPU today) and reset per
+// frame here, so a slow frame can be attributed to the phase and to the kind of
+// GPU object churn that happened in it.
+namespace FrameProf {
+
+enum Phase {
+	PHASE_FRAME_START,
+	PHASE_PHYSICS,
+	PHASE_PROCESS,
+	PHASE_SYNC,
+	PHASE_SCENE_UPDATE,
+	PHASE_PARTICLES,
+	PHASE_PROBES,
+	PHASE_VIEWPORTS,
+	PHASE_CANVAS_UPDATE,
+	PHASE_END_FRAME,
+	PHASE_TAIL,
+	PHASE_MAX,
+};
+
+enum Counter {
+	COUNTER_TEXTURE_CREATE,
+	COUNTER_TEXTURE_UPDATE,
+	COUNTER_BUFFER_CREATE,
+	COUNTER_BUFFER_UPDATE,
+	COUNTER_BIND_GROUP,
+	COUNTER_PIPELINE,
+	COUNTER_SHADER_MODULE,
+	COUNTER_PASS,
+	COUNTER_DRAW,
+	COUNTER_SUBMIT,
+	COUNTER_MAX,
+};
+
+inline constexpr uint64_t AUTO_PRINT_USEC = 2000000; // 2 s: always report such a frame.
+inline constexpr uint64_t SLOW_FRAME_USEC = 40000; // 40 ms: report with --frame-profile.
+
+inline bool enabled = false;
+inline uint64_t marks[PHASE_MAX] = {};
+inline uint64_t counters[COUNTER_MAX] = {};
+inline uint64_t start_counters[COUNTER_MAX] = {};
+
+inline uint64_t _now() {
+	const OS *os = OS::get_singleton();
+	return os ? os->get_ticks_usec() : 0;
+}
+
+inline void begin_frame() {
+	const uint64_t now = _now();
+	// Pre-fill every phase: phases that do not run this frame then report 0.
+	for (int i = 0; i < PHASE_MAX; i++) {
+		marks[i] = now;
+	}
+	for (int i = 0; i < COUNTER_MAX; i++) {
+		start_counters[i] = counters[i];
+	}
+}
+
+inline void mark(Phase p_phase) {
+	marks[p_phase] = _now();
+}
+
+inline void bump(Counter p_counter) {
+	counters[p_counter]++;
+}
+
+inline uint32_t delta(Counter p_counter) {
+	return (uint32_t)(counters[p_counter] - start_counters[p_counter]);
+}
+
+} // namespace FrameProf
