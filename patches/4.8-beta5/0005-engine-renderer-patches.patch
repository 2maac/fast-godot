@@ -0,0 +1,46 @@
+/**************************************************************************/
+/*  grit_script_key.cpp                                                   */
+/**************************************************************************/
+/*                         This file is part of:                          */
+/*                             GODOT ENGINE                               */
+/*                        https://godotengine.org                         */
+/**************************************************************************/
+
+#include "core/crypto/crypto_core.h"
+#include "core/object/script_language.h"
+
+#include <cstring>
+
+// 4.8 port shim for the Fast/HTML5 export's pack-key provider.
+//
+// The 4.7.2 fork generated a white-box keystream provider from core_builders.py
+// so the pack key never appeared as plaintext in the template. Porting that
+// generator to 4.8 is still pending, so this build compiles no key at all:
+// encrypted web templates are unavailable (and report so), while everything
+// else (including the editor and unencrypted exports) works unchanged.
+// TODO(4.8): re-port core_builders.py's white-box provider.
+
+static const uint8_t grit_pack_key[32] = {};
+static const bool grit_pack_key_available = false;
+
+void script_encryption_key_get(uint8_t p_key[32]) {
+	memcpy(p_key, grit_pack_key, 32);
+}
+
+bool script_encryption_key_keystream_available() {
+	return false;
+}
+
+bool script_encryption_key_encrypt_block(const uint8_t p_in[16], uint8_t r_out[16]) {
+	if (!grit_pack_key_available) {
+		return false;
+	}
+	CryptoCore::AESContext ctx;
+	if (ctx.setup(CryptoCore::AESContext::Mode::ENCRYPT, CryptoCore::AESContext::Cipher::ECB, grit_pack_key, 32, nullptr, 0) != OK) {
+		return false;
+	}
+	if (ctx.update(p_in, 16, r_out, 16) != OK) {
+		return false;
+	}
+	return ctx.finish(nullptr, 0) == OK;
+}
