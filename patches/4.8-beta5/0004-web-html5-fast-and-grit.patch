diff --git a/.github/workflows/build-verdict.yml b/.github/workflows/build-verdict.yml
new file mode 100644
index 0000000000..60d8144071
--- /dev/null
+++ b/.github/workflows/build-verdict.yml
@@ -0,0 +1,48 @@
+# Fork-local workflow for the WebGPU patch stack; not intended for upstream.
+#
+# The sync robot pushes a candidate and says it is ready before anything has
+# compiled it, so a red build used to reach nobody but the Actions list. This
+# workflow runs when a baseline run finishes and files the result in the
+# upstream-sync issues: a red candidate or a red webgpu-stack gets an issue
+# naming the failed jobs and the first errors, a green one clears it. The logic
+# is misc/webgpu_scripts/report-build-verdict.sh, which runs by hand too.
+#
+# workflow_run always runs this file from the default branch, so the code that
+# holds the token never comes from the branch under test. The branch name
+# reaches the script through the API, never through an inline expression.
+
+name: WebGPU stack - build verdict
+
+on:
+  workflow_run:
+    workflows: ["WebGPU stack - baseline"]
+    types: [completed]
+  workflow_dispatch:
+    inputs:
+      run_id:
+        description: Baseline run to report
+        required: true
+
+permissions:
+  actions: read
+  contents: read
+  issues: write
+
+concurrency:
+  group: build-verdict
+  cancel-in-progress: false
+
+jobs:
+  report:
+    name: Report the baseline verdict
+    runs-on: ubuntu-24.04
+    env:
+      GH_TOKEN: ${{ github.token }}
+      GH_REPO: ${{ github.repository }}
+      RUN_ID: ${{ github.event.workflow_run.id || inputs.run_id }}
+    steps:
+      - name: Checkout scripts
+        uses: actions/checkout@v6
+
+      - name: Report
+        run: bash misc/webgpu_scripts/report-build-verdict.sh "$RUN_ID"
diff --git a/.github/workflows/landscape-watch.yml b/.github/workflows/landscape-watch.yml
new file mode 100644
index 0000000000..914f3b3263
--- /dev/null
+++ b/.github/workflows/landscape-watch.yml
@@ -0,0 +1,59 @@
+# Fork-local workflow for the WebGPU patch stack; not intended for upstream.
+#
+# The Monday landscape routine files one 'landscape-watch' issue per week and
+# docs/webgpu-sync-protocol.md forbids it from touching any other issue, so
+# the reports accumulated: eight were open on 2026-10-22 and the week's sync
+# result was hard to find among them. This workflow keeps exactly one
+# landscape report open. When a landscape-watch issue is opened (or labeled)
+# it closes every older open issue carrying that label and leaves a pointer
+# to the newer one, so the open list reads: the current report plus the sync
+# robot's current issue, nothing else. Closed reports keep their content;
+# anything still relevant is expected to be carried forward in the new one.
+#
+# A manual dispatch runs the same sweep (the newest open report is kept),
+# which is how the backlog was cleared the first time.
+#
+# GH_REPO pins gh to this fork for the same reason the sync workflow does.
+
+name: WebGPU stack - landscape watch issues
+
+on:
+  issues:
+    types: [opened, labeled]
+  workflow_dispatch:
+
+permissions:
+  issues: write
+
+concurrency:
+  group: landscape-watch-issues
+  cancel-in-progress: false
+
+jobs:
+  supersede:
+    name: Close older landscape reports
+    if: github.event_name == 'workflow_dispatch' || contains(github.event.issue.labels.*.name, 'landscape-watch')
+    runs-on: ubuntu-24.04
+    env:
+      GH_TOKEN: ${{ github.token }}
+      GH_REPO: ${{ github.repository }}
+    steps:
+      - name: Supersede older open landscape-watch issues
+        run: |
+          set -euo pipefail
+          # The newest open report wins: on an issue event that is the issue
+          # that fired, on a manual dispatch it is the highest number.
+          OPEN=$(gh issue list --label landscape-watch --state open --limit 200 --json number --jq 'map(.number) | sort | .[]')
+          if [ -z "$OPEN" ]; then
+            echo "No open landscape-watch issue; nothing to do."
+            exit 0
+          fi
+          KEEP=$(echo "$OPEN" | tail -n 1)
+          CLOSED=0
+          for N in $OPEN; do
+            [ "$N" -lt "$KEEP" ] || continue
+            gh issue close "$N" --comment "Superseded by #$KEEP, the newer landscape report. Anything from this one that is still open is expected to be carried forward there."
+            echo "Closed #$N (superseded by #$KEEP)."
+            CLOSED=$((CLOSED + 1))
+          done
+          echo "Kept #$KEEP open; closed $CLOSED older report(s)."
diff --git a/.github/workflows/tint-builder.yml b/.github/workflows/tint-builder.yml
new file mode 100644
index 0000000000..4e79bc4ff4
--- /dev/null
+++ b/.github/workflows/tint-builder.yml
@@ -0,0 +1,146 @@
+# Fork-local workflow for the WebGPU patch stack; not intended for upstream.
+#
+# Builds the tint SPIR-V -> WGSL translator the shader baker shells out to
+# (GODOT_TINT_PATH), from the same Dawn tag the emdawnwebgpu port pins, for
+# Linux and Windows - and publishes the binaries as permanent release assets
+# (tag tint-<ref>). This removes the bus factor of a hand-built local
+# tint.exe: any machine (or a future CI bake leg) can fetch a bit-identical
+# translator from the repo's releases instead of rebuilding Dawn by hand.
+#
+# Runs on demand only; re-run with a new dawn_ref when the emdawnwebgpu port
+# pin moves (the upstream-sync issue will flag Emscripten pin drift).
+#
+# The build carries one fork patch: tint's WGSL writer already has an option
+# to allow subgroup builtins in non-uniform control flow (Godot's clustered
+# light loop needs it), but the command line never exposed it. The step below
+# adds --allow-non-uniform-subgroup-operations next to the existing
+# --allow-non-uniform-derivatives flag; that binary is what
+# GODOT_TINT_PATH_SUBGROUPS points at. Dawn releases from November 2026 ship
+# the same writer option as --allow-non-uniform-subgroups, declared as
+# `allow_nus`; the inserted option uses its own variable so both spellings
+# coexist and older bake configurations keep working.
+
+name: WebGPU stack - tint builder
+
+on:
+  workflow_dispatch:
+    inputs:
+      dawn_ref:
+        description: "Dawn tag/ref to build tint from"
+        required: true
+        default: "v20250531.224602"
+      release_suffix:
+        description: "Appended to the release tag (tint-<ref><suffix>), so a patched build never overwrites a pristine one"
+        required: false
+        default: ""
+
+permissions:
+  contents: write
+
+jobs:
+  build:
+    name: Build tint (${{ matrix.os }})
+    runs-on: ${{ matrix.os }}
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - os: ubuntu-24.04
+            binary: out/tint
+            asset: tint-linux-x86_64
+          - os: windows-latest
+            binary: out/Release/tint.exe
+            asset: tint-windows-x86_64.exe
+    steps:
+      - name: Checkout Dawn (GitHub mirror)
+        uses: actions/checkout@v6
+        with:
+          repository: google/dawn
+          ref: ${{ github.event.inputs.dawn_ref }}
+
+      - name: Expose the subgroup-uniformity writer option on the command line
+        shell: python
+        run: |
+          import io
+          p = "src/tint/cmd/tint/main.cc"
+          s = io.open(p, encoding="utf-8").read()
+          if "allow-non-uniform-subgroup-operations" in s:
+              print("already present"); raise SystemExit
+          anchor = "opts->wgsl_writer_options.allow_non_uniform_derivatives = true;\n        }\n    });\n"
+          assert s.count(anchor) == 1, "derivatives option block not found - the tint CLI moved, update this step"
+          add = anchor + (
+              "\n"
+              "    auto& allow_nus_ops = options.Add<BoolOption>(\n"
+              '        "allow-non-uniform-subgroup-operations",\n'
+              '        R"(Allow subgroup builtins in non-uniform control flow by inserting a module-scope directive to\n'
+              'suppress any uniformity violations that may be produced)",\n'
+              "        Default{false});\n"
+              "    TINT_DEFER({\n"
+              "        if (allow_nus_ops.value.value_or(false)) {\n"
+              "            opts->wgsl_writer_options.allow_non_uniform_subgroup_operations = true;\n"
+              "        }\n"
+              "    });\n"
+          )
+          s = s.replace(anchor, add)
+          io.open(p, "w", encoding="utf-8", newline="\n").write(s)
+          print("patched", p)
+
+      - name: Configure (tint command-line tools only)
+        run: >
+          cmake -S . -B out
+          -DCMAKE_BUILD_TYPE=Release
+          -DDAWN_FETCH_DEPENDENCIES=ON
+          -DDAWN_ENABLE_D3D11=OFF
+          -DDAWN_ENABLE_D3D12=OFF
+          -DDAWN_ENABLE_METAL=OFF
+          -DDAWN_ENABLE_NULL=OFF
+          -DDAWN_ENABLE_DESKTOP_GL=OFF
+          -DDAWN_ENABLE_OPENGLES=OFF
+          -DDAWN_ENABLE_VULKAN=OFF
+          -DDAWN_BUILD_SAMPLES=OFF
+          -DDAWN_USE_GLFW=OFF
+          -DTINT_BUILD_TESTS=OFF
+          -DTINT_BUILD_CMD_TOOLS=ON
+          -DTINT_BUILD_SPV_READER=ON
+          -DTINT_BUILD_SPV_WRITER=OFF
+          -DTINT_BUILD_WGSL_READER=ON
+          -DTINT_BUILD_WGSL_WRITER=ON
+
+      - name: Build
+        run: cmake --build out --config Release --target tint_cmd_tint_cmd --parallel 4
+
+      - name: Locate and smoke-test the binary
+        id: bin
+        shell: bash
+        run: |
+          BIN="${{ matrix.binary }}"
+          if [ ! -f "$BIN" ]; then
+            # Generator layouts differ; find the tint executable.
+            BIN=$(find out -maxdepth 3 -type f \( -name tint -o -name tint.exe \) | head -1)
+          fi
+          test -n "$BIN" && test -f "$BIN"
+          # Functional smoke: round-trip a trivial shader the way the baker
+          # invokes tint (this tint has no --version flag).
+          printf '@vertex fn m() -> @builtin(position) vec4f { return vec4f(0); }\n' > smoke.wgsl
+          "$BIN" --format wgsl smoke.wgsl
+          cp "$BIN" "${{ matrix.asset }}"
+          echo "asset=${{ matrix.asset }}" >> "$GITHUB_OUTPUT"
+
+      - name: Upload build artifact
+        uses: actions/upload-artifact@v7
+        with:
+          name: ${{ matrix.asset }}
+          path: ${{ steps.bin.outputs.asset }}
+          if-no-files-found: error
+
+      - name: Publish as release asset
+        shell: bash
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          TAG="tint-${{ github.event.inputs.dawn_ref }}${{ github.event.inputs.release_suffix }}"
+          gh release view "$TAG" -R "${{ github.repository }}" >/dev/null 2>&1 || \
+            gh release create "$TAG" -R "${{ github.repository }}" \
+              --title "tint (Dawn ${{ github.event.inputs.dawn_ref }})" \
+              --notes "SPIR-V->WGSL translator built by the tint-builder workflow for the shader baker (GODOT_TINT_PATH). Matches the emdawnwebgpu Dawn pin." || true
+          gh release upload "$TAG" -R "${{ github.repository }}" "${{ steps.bin.outputs.asset }}" --clobber
diff --git a/.github/workflows/upstream-sync.yml b/.github/workflows/upstream-sync.yml
new file mode 100644
index 0000000000..ccafd67055
--- /dev/null
+++ b/.github/workflows/upstream-sync.yml
@@ -0,0 +1,323 @@
+# Fork-local workflow for the WebGPU patch stack; not intended for upstream.
+#
+# Weekly upstream auto-rebase: fetches godotengine/godot master, replays the
+# patch stack onto it, and - only when every patch applies cleanly and
+# check-stack passes - pushes the result to a dated auto-rebase/ candidate
+# branch (plus a backup tag of the pre-rebase head). The baseline workflow
+# then builds the candidate. webgpu-stack itself is NEVER pushed by
+# automation: promotion stays a human step because CI cannot run the
+# local-only gates (tint bakes, strict pixel probe on a real GPU, in-headset
+# checks). Run misc/webgpu_scripts/promote-candidate.sh to promote.
+#
+# A faithful replay carries upstream's own .github/workflows/ updates, and the
+# token GitHub hands to a workflow run is never allowed to push those. Pushing
+# candidates therefore needs a repository secret SYNC_PAT: a fine-grained
+# personal access token for this repository with Contents and Workflows set to
+# read and write.
+#
+# The run's verdict is the REPLAY, not the push: a clean rebase that cannot
+# publish its candidate warns and stays green, because the question this
+# workflow answers - do the patches still apply to upstream master? - has been
+# answered either way, and the replay reproduces locally byte for byte. Without
+# SYNC_PAT the only thing lost is the convenience branch (and the baseline
+# build of it) on weeks when upstream touched a workflow file.
+#
+# Resilience measures:
+# - A conflicted rebase or failed verification opens/updates a FAILED issue
+#   (label: upstream-sync) naming the cause: the conflicting patch and files,
+#   or the commits whose subjects break the [wgpu NN] convention. A fresh
+#   candidate opens/updates a separate "candidate ready" issue with the
+#   promotion checklist and closes any open FAILED issue. The two never
+#   share an issue: a failure appended to good news reads as a footnote.
+# - The baseline workflow runs the subject and check-stack gates on every
+#   push, so a commit that would fail the next replay is reported at once.
+# - This workflow never compiles anything, so a clean replay is not a build.
+#   build-verdict.yml reports the candidate's baseline result in these same
+#   issues, and only a green build closes a "does not build" issue.
+# - A stack whose upstream base is a week old is called out in the next run's
+#   report, in the issue title and at the top of the comment, and a run that
+#   finds nothing new closes what is left open. The human side of all of this
+#   is docs/webgpu-sync-protocol.md.
+# - GH_REPO pins every gh call to this fork. Once the upstream remote exists,
+#   gh's own remote ranking prefers a remote named "upstream", so unpinned
+#   calls resolve to godotengine/godot - which is where the reporting steps
+#   were looking for the label they could not find.
+# - The tracking label is created idempotently every run, and reporting is
+#   non-fatal: an informational report can never turn a clean rebase red
+#   (a real rebase/verify failure still fails the run).
+# - The workflow re-enables itself every run (GitHub disables schedules
+#   after 60 days of repo inactivity).
+# - SYNC_PAT is checked before it is used. Three weeks before it expires, or
+#   as soon as it stops working, a dedicated issue says so and how to renew.
+# - Old candidates/backup tags are pruned (newest 3 kept).
+# - The Emscripten pin is diffed against upstream's web_builds.yml so pin
+#   drift is flagged before it becomes a mysterious build failure.
+
+name: WebGPU stack - upstream sync
+
+on:
+  schedule:
+    - cron: "17 6 * * 1" # Mondays 06:17 UTC
+  workflow_dispatch:
+
+permissions:
+  contents: write
+  issues: write
+  actions: write
+
+concurrency:
+  group: upstream-sync
+  cancel-in-progress: false
+
+jobs:
+  rebase:
+    name: Rebase stack onto upstream master
+    runs-on: ubuntu-24.04
+    env:
+      GH_TOKEN: ${{ github.token }}
+      GH_REPO: ${{ github.repository }}
+    steps:
+      # The token is the one thing here with an expiry date. Left unchecked, a
+      # dead one fails at checkout with an auth error that names nothing;
+      # caught first, the replay still runs on the default token and the
+      # report says what to renew.
+      - name: Check the push token
+        id: token
+        env:
+          SYNC_PAT: ${{ secrets.SYNC_PAT }}
+        run: |
+          RENEW="Create a fine-grained token for this repository with Contents and Workflows set to read and write, then update the SYNC_PAT secret under Settings, Secrets and variables, Actions."
+          STATE=dead
+          NOTE="SYNC_PAT is not set, so candidates that carry upstream workflow changes cannot be pushed, and a candidate pushed without it starts no baseline build. $RENEW"
+          if [ -n "$SYNC_PAT" ]; then
+            HEADERS=$(curl -sS -D - -o /dev/null -H "Authorization: Bearer $SYNC_PAT" "https://api.github.com/repos/$GH_REPO" | tr -d '\r' || true)
+            CODE=$(printf '%s\n' "$HEADERS" | awk 'NR==1 {print $2}')
+            NOTE="SYNC_PAT was rejected (HTTP 401): it has expired or been revoked. This run falls back to the default token, which cannot push upstream workflow changes and starts no baseline build. $RENEW"
+            # Only a 401 condemns the token. A network or API hiccup says
+            # nothing about it, and a false alarm teaches people to ignore this.
+            if [ "$CODE" != 401 ]; then
+              STATE=ok
+              NOTE=""
+              EXPIRY=$(printf '%s\n' "$HEADERS" | sed -n 's/^github-authentication-token-expiration: //Ip')
+              if [ -n "$EXPIRY" ]; then
+                DAYS=$(( ($(date -d "$EXPIRY" +%s) - $(date +%s)) / 86400 ))
+                echo "SYNC_PAT expires $EXPIRY ($DAYS days)."
+                if [ "$DAYS" -le 21 ]; then
+                  NOTE="SYNC_PAT expires on $EXPIRY, in $DAYS days. When it does, the sync cannot publish a candidate that carries upstream workflow changes, and no candidate gets a baseline build. $RENEW"
+                fi
+              else
+                echo "SYNC_PAT check answered HTTP ${CODE:-none} with no expiry date."
+              fi
+            fi
+          fi
+          echo "SYNC_PAT state: $STATE"
+          echo "state=$STATE" >> "$GITHUB_OUTPUT"
+          echo "note=$NOTE" >> "$GITHUB_OUTPUT"
+
+      - name: Checkout stack
+        uses: actions/checkout@v6
+        with:
+          ref: webgpu-stack
+          fetch-depth: 0
+          token: ${{ steps.token.outputs.state == 'ok' && secrets.SYNC_PAT || github.token }}
+
+      - name: Keep the schedule alive
+        run: |
+          gh api -X PUT "repos/${{ github.repository }}/actions/workflows/upstream-sync.yml/enable" || true
+
+      - name: Ensure the tracking label exists
+        run: |
+          gh label create upstream-sync \
+            --color 1d76db \
+            --description "Automated upstream rebase status" \
+            --force || echo "::warning::could not ensure the upstream-sync label; issue reporting may be skipped"
+
+      - name: Report the push token
+        continue-on-error: true
+        env:
+          NOTE: ${{ steps.token.outputs.note }}
+        run: |
+          TITLE="Upstream sync: SYNC_PAT needs renewing"
+          NUM=$(gh issue list --label upstream-sync --state open --json number,title --jq "[.[] | select(.title == \"$TITLE\")] | .[0].number // empty" 2>/dev/null || echo "")
+          if [ -z "$NOTE" ]; then
+            if [ -n "$NUM" ]; then
+              gh issue close "$NUM" --comment "Resolved: SYNC_PAT is valid again." || true
+            fi
+            exit 0
+          fi
+          echo "::warning::$NOTE"
+          if [ -z "$NUM" ]; then
+            gh issue create --title "$TITLE" --label upstream-sync --body "$NOTE" || echo "::warning::could not create the token issue"
+          else
+            gh issue comment "$NUM" --body "$NOTE" || echo "::warning::could not update the token issue"
+          fi
+
+      - name: Fetch upstream
+        run: |
+          git remote add upstream https://github.com/godotengine/godot.git
+          git fetch upstream master
+
+      - name: Count new upstream commits
+        id: fresh
+        run: |
+          BASE=$(git merge-base HEAD upstream/master)
+          COUNT=$(git rev-list --count "$BASE"..upstream/master)
+          AGE=$(( ($(date +%s) - $(git log -1 --format=%ct "$BASE")) / 86400 ))
+          echo "count=$COUNT" >> "$GITHUB_OUTPUT"
+          echo "base_age=$AGE" >> "$GITHUB_OUTPUT"
+          echo "Upstream is $COUNT commit(s) ahead of the stack's base, which is $AGE day(s) old."
+
+      - name: Check the Emscripten pin against upstream
+        id: empin
+        run: |
+          UP=$(git show upstream/master:.github/workflows/web_builds.yml | grep -oE "EM_VERSION: *[0-9.]+" | grep -oE "[0-9.]+" | head -1 || true)
+          OURS=$(grep -oE "EM_VERSION: *[0-9.]+" .github/workflows/web-baseline.yml | grep -oE "[0-9.]+" | head -1 || true)
+          echo "upstream=$UP ours=$OURS"
+          if [ -n "$UP" ] && [ -n "$OURS" ] && [ "$UP" != "$OURS" ]; then
+            echo "drift=Emscripten pin drift: upstream web_builds.yml uses $UP, our baseline pins $OURS." >> "$GITHUB_OUTPUT"
+          else
+            echo "drift=" >> "$GITHUB_OUTPUT"
+          fi
+
+      - name: Rebase
+        if: steps.fresh.outputs.count != '0'
+        id: rebase
+        run: |
+          git config user.name "upstream-sync[bot]"
+          git config user.email "upstream-sync[bot]@users.noreply.github.com"
+          STAMP=$(date -u +%Y%m%d)
+          echo "stamp=$STAMP" >> "$GITHUB_OUTPUT"
+          # -f because the tag name is dated, not per-run: a second run on the
+          # same day (a re-run after a failure, which is exactly when this
+          # matters) would otherwise die on "tag already exists". The tag
+          # records the head this run rebased FROM, so moving it to the current
+          # head is what recovery wants.
+          git tag -f "backup/auto-$STAMP" HEAD
+          if ! git rebase upstream/master; then
+            PATCH=$(git log -1 --format=%s REBASE_HEAD 2>/dev/null || echo '(unknown patch)')
+            FILES=$(git diff --name-only --diff-filter=U | tr '\n' ' ')
+            echo "::error::Rebase conflicted on: $PATCH (files: $FILES)"
+            echo "cause=Patch '$PATCH' conflicted on: $FILES" >> "$GITHUB_OUTPUT"
+            git rebase --abort || true
+            exit 1
+          fi
+
+      # The same two checks run on every push in the baseline workflow's
+      # check-stack job, so a commit that breaks them is reported within
+      # minutes of landing rather than at the next scheduled replay.
+      - name: Verify stack integrity
+        if: steps.fresh.outputs.count != '0'
+        id: verify
+        run: |
+          PATCHES=$(git log --oneline upstream/master..HEAD | wc -l)
+          STRAYS=$(git log --format=%s upstream/master..HEAD | grep -v "^\[wgpu " || true)
+          echo "Patches: $PATCHES"
+          if [ -n "$STRAYS" ]; then
+            echo "::error::commit(s) without a [wgpu NN] subject on the stack: $STRAYS"
+            echo "cause=Commit(s) without a [wgpu NN] subject on webgpu-stack (reword or fold them before the next replay): $(echo "$STRAYS" | tr '\n' ';')" >> "$GITHUB_OUTPUT"
+            exit 1
+          fi
+          if ! bash misc/webgpu_scripts/check-stack.sh; then
+            echo "cause=check-stack.sh failed after a clean replay - see the run log for the offending patch and file." >> "$GITHUB_OUTPUT"
+            exit 1
+          fi
+
+      - name: Push candidate branch and backup tag
+        id: candidate
+        if: steps.fresh.outputs.count != '0'
+        run: |
+          STAMP=${{ steps.rebase.outputs.stamp }}
+          git push --force origin "backup/auto-$STAMP" || echo "::warning::could not push the backup tag"
+          if git push --force origin "HEAD:auto-rebase/$STAMP"; then
+            echo "pushed=yes" >> "$GITHUB_OUTPUT"
+            echo "Candidate: auto-rebase/$STAMP (baseline CI builds it next)."
+          else
+            echo "pushed=no" >> "$GITHUB_OUTPUT"
+            echo "::warning::The replay is clean but the candidate branch could not be pushed. A rejection naming 'workflows permission' means upstream changed a file under .github/workflows/ and this run's default token may not push those - add the SYNC_PAT secret described in the workflow header to restore automatic candidates. Rebase locally in the meantime: the replay is deterministic and reproduces exactly."
+          fi
+
+      - name: Prune old candidates and backup tags (keep newest 3)
+        if: steps.fresh.outputs.count != '0' && steps.candidate.outputs.pushed == 'yes'
+        run: |
+          git ls-remote --heads origin "auto-rebase/*" | awk '{print $2}' | sed 's|refs/heads/||' | sort | head -n -3 | while read -r b; do
+            echo "pruning branch $b"; git push origin --delete "$b" || true
+          done
+          git ls-remote --tags origin "backup/auto-*" | awk '{print $2}' | sed 's|refs/tags/||' | grep -v '\^{}' | sort | head -n -3 | while read -r t; do
+            echo "pruning tag $t"; git push origin --delete "$t" || true
+          done
+
+      # Reporting is informational and must never fail the run: continue-on-error
+      # keeps a clean rebase green even if the GitHub issue API hiccups, and the
+      # guards keep the step itself green in the normal case.
+      - name: Report candidate ready
+        if: success() && steps.fresh.outputs.count != '0'
+        continue-on-error: true
+        run: |
+          STAMP=${{ steps.rebase.outputs.stamp }}
+          COUNT=${{ steps.fresh.outputs.count }}
+          DRIFT="${{ steps.empin.outputs.drift }}"
+          if [ "${{ steps.candidate.outputs.pushed }}" = "yes" ]; then
+            L1="Candidate \`auto-rebase/$STAMP\` is pushed ($COUNT new upstream commits; clean replay, check-stack OK). The patches apply; nothing has compiled them yet. Baseline CI is building it and reports here when it finishes."
+            L2="Once that is green, promote locally with \`bash misc/webgpu_scripts/promote-candidate.sh $STAMP\` and run the local gates (tint bake, strict probe, headset spot-check) before force-with-lease pushing."
+          else
+            L1="The stack replayed cleanly onto upstream ($COUNT new upstream commits, check-stack OK), but the candidate branch could not be pushed - see the run log for the rejection. Nothing is broken: the replay is deterministic and reproduces locally."
+            L2="Rebase locally (\`git fetch upstream && git rebase upstream/master\`) and run the local gates. To restore automatic candidates, add the SYNC_PAT secret described in the workflow header."
+          fi
+          BODY=$(printf '%s\n\n%s\n\n%s' "$L1" "$L2" "$DRIFT")
+          # Each outcome has its own issue: a failure is never appended to an
+          # open "candidate ready" issue, where it reads as a footnote on
+          # good news and goes unnoticed (two failures did, in October 2026).
+          NUM=$(gh issue list --label upstream-sync --state open --json number,title --jq '[.[] | select(.title | startswith("Upstream sync: candidate ready"))] | .[0].number // empty' 2>/dev/null || echo "")
+          # A candidate is useful for one week. When the stack has sat on the
+          # same upstream base for longer, say so where it is read first (the
+          # title and the top of the comment), so an unpromoted candidate stops
+          # being a footnote under good news. The age is the base's, not the
+          # issue's: an issue can outlive a promotion, and on 2026-11-02 one
+          # would have called a two-day-old stack unpromoted for two weeks.
+          # See docs/webgpu-sync-protocol.md.
+          AGE=${{ steps.fresh.outputs.base_age }}
+          TITLE="Upstream sync: candidate ready"
+          if [ "$AGE" -ge 7 ]; then
+            TITLE="Upstream sync: candidate ready (unpromoted for $AGE days)"
+            STALE="**Unpromoted for $AGE days.** That is how old the stack's upstream base is; every week of drift makes the next hand rebase larger. Promote this week."
+            BODY=$(printf '%s\n\n%s' "$STALE" "$BODY")
+          fi
+          if [ -z "$NUM" ]; then
+            gh issue create --title "$TITLE" --label upstream-sync --body "$BODY" || echo "::warning::could not create the tracking issue (rebase result is unaffected)"
+          else
+            gh issue edit "$NUM" --title "$TITLE" || true
+            gh issue comment "$NUM" --body "$BODY" || echo "::warning::could not update the tracking issue (rebase result is unaffected)"
+          fi
+          # A clean replay resolves a failed replay. It does not resolve a
+          # candidate that did not build: only a green build can.
+          for F in $(gh issue list --label upstream-sync --state open --json number,title --jq '.[] | select(.title | startswith("Upstream sync: FAILED - needs manual rebase")) | .number' 2>/dev/null); do
+            gh issue close "$F" --comment "Resolved: the $STAMP replay is clean (see the candidate-ready issue)." || true
+          done
+
+      # With nothing new upstream there is nothing to promote: whatever an open
+      # issue offered or reported is already settled by the stack's own head.
+      - name: Report stack current
+        if: success() && steps.fresh.outputs.count == '0'
+        continue-on-error: true
+        run: |
+          for F in $(gh issue list --label upstream-sync --state open --json number,title --jq '.[] | select(.title | startswith("Upstream sync: candidate ready") or startswith("Upstream sync: FAILED - needs manual rebase")) | .number' 2>/dev/null); do
+            gh issue close "$F" --comment "Resolved: webgpu-stack already sits on upstream's head, so there is nothing to promote." || true
+          done
+
+      - name: Report failure
+        if: failure()
+        continue-on-error: true
+        # The cause quotes commit subjects; it reaches the shell through the
+        # environment, never through an inline expression, so it is text.
+        env:
+          CAUSE: ${{ steps.rebase.outputs.cause || steps.verify.outputs.cause || 'Cause not captured - see the run log.' }}
+          DRIFT: ${{ steps.empin.outputs.drift }}
+        run: |
+          L1="The scheduled upstream rebase FAILED (run: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}). The stack itself is untouched; resolve locally (backup tag was pushed if the rebase step ran)."
+          BODY=$(printf '%s\n\n**Cause:** %s\n\n%s' "$L1" "$CAUSE" "$DRIFT")
+          NUM=$(gh issue list --label upstream-sync --state open --json number,title --jq '[.[] | select(.title | startswith("Upstream sync: FAILED - needs manual rebase"))] | .[0].number // empty' 2>/dev/null || echo "")
+          if [ -z "$NUM" ]; then
+            gh issue create --title "Upstream sync: FAILED - needs manual rebase" --label upstream-sync --body "$BODY" || echo "::warning::could not create the tracking issue"
+          else
+            gh issue comment "$NUM" --body "$BODY" || echo "::warning::could not update the tracking issue"
+          fi
diff --git a/.github/workflows/web-baseline.yml b/.github/workflows/web-baseline.yml
new file mode 100644
index 0000000000..1b01afbaaf
--- /dev/null
+++ b/.github/workflows/web-baseline.yml
@@ -0,0 +1,341 @@
+# Fork-local workflow for the WebGPU patch stack; not intended for upstream.
+# Stage 0.5 of the staged CI plan in docs/webgpu-testing.md.
+# No driver exists yet: the stock leg is the size baseline, the rd leg
+# builds with use_rendering_device=yes (RD stack linked in, dormant).
+# Re-check the Emscripten pin against upstream .github/workflows/web_builds.yml on every upstream sync.
+
+name: WebGPU stack - baseline
+
+on:
+  push:
+    branches:
+      - webgpu-stack
+      - webgpu-dev
+      - "auto-rebase/**"
+  pull_request:
+    branches:
+      - webgpu-stack
+  workflow_dispatch:
+
+# SIZE CONTRACT: the web-template build flags below define the size baseline.
+# Changing any of them invalidates all previously recorded WASM size deltas.
+env:
+  SCONS_CACHE: .scons_cache
+  SCONS_FLAGS: >-
+    dev_mode=yes
+    debug_symbols=no
+    use_closure_compiler=yes
+  EM_VERSION: 6.0.12
+
+jobs:
+  web-template:
+    name: web-template (${{ matrix.leg }})
+    runs-on: ubuntu-24.04
+    timeout-minutes: 90
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - leg: stock
+            threads: "yes"
+            suffix: ""
+            extra_flags: ""
+          - leg: stock-single
+            threads: "no"
+            suffix: ".nothreads"
+            extra_flags: ""
+          - leg: rd
+            threads: "yes"
+            suffix: ""
+            extra_flags: webgpu=yes
+          - leg: rd-single
+            threads: "no"
+            suffix: ".nothreads"
+            extra_flags: webgpu=yes
+
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v6
+
+      - name: Set up Emscripten
+        uses: emscripten-core/setup-emsdk@v16
+        with:
+          version: ${{ env.EM_VERSION }}
+          no-cache: true
+
+      - name: Restore SCons cache
+        uses: actions/cache/restore@v5
+        with:
+          path: ${{ env.SCONS_CACHE }}
+          key: web-template-${{ matrix.leg }}-${{ runner.os }}-${{ github.sha }}
+          restore-keys: |
+            web-template-${{ matrix.leg }}-${{ runner.os }}-
+
+      - name: Install build dependencies
+        run: |
+          python -m pip install --upgrade pip
+          python -m pip install scons
+          sudo apt-get update
+          sudo apt-get install -y brotli
+
+      - name: Build web template (${{ matrix.leg }}, threads=${{ matrix.threads }})
+        run: |
+          scons platform=web target=template_release ${{ env.SCONS_FLAGS }} threads=${{ matrix.threads }} "cache_path=${{ env.SCONS_CACHE }}" redirect_build_objects=no ${{ matrix.extra_flags }}
+
+      - name: Record WASM size
+        run: |
+          mkdir -p sizes
+          bash misc/webgpu_scripts/wasm-size.sh bin sizes/wasm-sizes.txt
+          {
+            echo "### WASM sizes (${{ matrix.leg }})"
+            echo
+            echo '```'
+            cat sizes/wasm-sizes.txt
+            echo '```'
+          } >> "$GITHUB_STEP_SUMMARY"
+
+      - name: Save SCons cache
+        uses: actions/cache/save@v5
+        if: always()
+        with:
+          path: ${{ env.SCONS_CACHE }}
+          key: web-template-${{ matrix.leg }}-${{ runner.os }}-${{ github.sha }}
+
+      # Stage 1: boot the template loader headlessly, assert WebGPU pre-init
+      # feature detection and the WebGL fallback warning. Loader JS is
+      # identical across legs, so run it once on the stock leg.
+      - name: Loader smoke test
+        if: startsWith(matrix.leg, 'stock')
+        run: |
+          cd platform/web
+          npm i --no-save playwright
+          npx playwright install --with-deps chromium
+          node ../../misc/webgpu_scripts/loader-smoke.mjs ../../bin
+
+      # Stage 2: call the exported _godot_webgpu_probe() with a software
+      # WebGPU adapter and assert the presented clear color on the probe
+      # canvas. Skips gracefully when the runner cannot deliver an adapter.
+      - name: WebGPU probe smoke test
+        if: startsWith(matrix.leg, 'rd')
+        run: |
+          cd platform/web
+          npm i --no-save playwright
+          npx playwright install --with-deps chromium
+          node ../../misc/webgpu_scripts/loader-smoke.mjs ../../bin probe
+
+      - name: Upload WASM sizes
+        uses: actions/upload-artifact@v7
+        with:
+          name: wasm-sizes-${{ matrix.leg }}-${{ github.sha }}
+          path: sizes/
+
+      - name: Upload the template for the WebXR glue smoke test
+        if: startsWith(matrix.leg, 'stock')
+        uses: actions/upload-artifact@v7
+        with:
+          name: ${{ matrix.leg }}-template-${{ github.sha }}
+          path: bin/godot.web.template_release.wasm32${{ matrix.suffix }}.zip
+          retention-days: 1
+
+  # Expensive (~1h cold). Disable this job if runner minutes matter; web-template is the required gate.
+  linux-editor:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 120
+
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v6
+
+      - name: Restore SCons cache
+        uses: actions/cache/restore@v5
+        with:
+          path: ${{ env.SCONS_CACHE }}
+          key: linux-editor-${{ runner.os }}-${{ github.sha }}
+          restore-keys: |
+            linux-editor-${{ runner.os }}-
+
+      - name: Install build dependencies
+        run: |
+          python -m pip install --upgrade pip
+          python -m pip install scons
+          sudo apt-get update
+          sudo apt-get install -y build-essential pkg-config libx11-dev libxcursor-dev libxinerama-dev libgl1-mesa-dev libglu1-mesa-dev libasound2-dev libpulse-dev libudev-dev libxi-dev libxrandr-dev libwayland-dev mesa-vulkan-drivers
+
+      - name: Build Linux editor
+        run: |
+          scons platform=linuxbsd target=editor dev_mode=yes "cache_path=${{ env.SCONS_CACHE }}" redirect_build_objects=no
+
+      # The bake is where SPIR-V becomes WGSL, so it is the only place an
+      # upstream shader change shows up as something WebGPU cannot express.
+      # Translation failures are not fatal by design - the variant is excluded
+      # and the renderer takes another path - so nothing notices unless the
+      # exclusions are counted against a baseline. That is this gate.
+      - name: Fetch tint
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          # Published by the tint-builder workflow, pinned BY TAG and hash.
+          # Dawn v20261113.214538 carries the reader fix for the
+          # texture-parameter assert (85b7901) that kept the rewritten SPIR-V
+          # reader from translating the scene shaders; with the bake's
+          # preprocessing passes it translates every variant on its own, so
+          # no fallback translator is configured. Move this pin only together
+          # with GODOT_TINT_PATH locally and a zero-exclusion census.
+          gh release download tint-v20261113.214538 --repo "$GITHUB_REPOSITORY" --pattern 'tint-linux-x86_64' --dir "$RUNNER_TEMP" --clobber
+          printf '%s  %s\n' '43bbfe5fc0e4a9480a6daac1349612103806a73a932788af029a172054d94589' "$RUNNER_TEMP/tint-linux-x86_64" | sha256sum --check
+          chmod +x "$RUNNER_TEMP/tint-linux-x86_64"
+
+      - name: Bake the fixture project
+        env:
+          GODOT_TINT_PATH: ${{ runner.temp }}/tint-linux-x86_64
+        run: |
+          set -o pipefail
+          sudo apt-get install -y xvfb
+          EDITOR=$(ls bin/godot.linuxbsd.editor.* | grep -v '\.console' | head -1)
+          echo "editor: $EDITOR"
+          FIXTURE=misc/webgpu_scripts/bake_fixture
+
+          # Import first so the export is not also the first resource scan.
+          "$EDITOR" --headless --path "$FIXTURE" --import || true
+
+          # The shader baker only runs under a real RenderingDevice renderer,
+          # so this must NOT be headless: a dummy renderer silently bakes
+          # nothing and still reports success. lavapipe (mesa-vulkan-drivers)
+          # provides the Vulkan device and xvfb the display.
+          xvfb-run -a "$EDITOR" --path "$FIXTURE" \
+            --export-pack "Web" "$RUNNER_TEMP/fixture.pck" \
+            --rendering-method mobile --rendering-driver vulkan --verbose \
+            2>&1 | tee "$RUNNER_TEMP/bake.log"
+
+          test -s "$RUNNER_TEMP/fixture.pck" || { echo "::error::the bake produced no pack"; exit 1; }
+          bash misc/webgpu_scripts/check-bake-census.sh "$RUNNER_TEMP/bake.log"
+
+          # The clustered renderer bakes a different (larger) shader family
+          # with its own exclusion census; without this leg, an upstream
+          # change could break a Forward+ shader and only surface at the next
+          # local promotion. Same fixture, renderer flipped for the bake.
+          sed -i 's/"mobile"/"forward_plus"/g' "$FIXTURE/project.godot"
+          rm -rf "$FIXTURE/.godot/exported" "$FIXTURE/.godot/shader_cache"
+          xvfb-run -a "$EDITOR" --path "$FIXTURE" \
+            --export-pack "Web" "$RUNNER_TEMP/fixture-fplus.pck" \
+            --rendering-method forward_plus --rendering-driver vulkan --verbose \
+            2>&1 | tee "$RUNNER_TEMP/bake-fplus.log"
+
+          test -s "$RUNNER_TEMP/fixture-fplus.pck" || { echo "::error::the Forward+ bake produced no pack"; exit 1; }
+          bash misc/webgpu_scripts/check-bake-census.sh "$RUNNER_TEMP/bake-fplus.log" \
+            misc/webgpu_scripts/bake_fixture/expected-exclusions-forward-plus.txt
+
+      # No template is needed to pack, and the GL renderer means no bake.
+      - name: Pack the WebXR glue fixture
+        run: |
+          EDITOR=$(ls bin/godot.linuxbsd.editor.* | grep -v '\.console' | head -1)
+          FIXTURE=misc/webgpu_scripts/webxr_fixture
+          "$EDITOR" --headless --path "$FIXTURE" --import || true
+          "$EDITOR" --headless --path "$FIXTURE" --export-pack "Web" "$RUNNER_TEMP/glue.pck"
+          test -s "$RUNNER_TEMP/glue.pck" || { echo "::error::the glue fixture produced no pack"; exit 1; }
+
+      - name: Upload the glue fixture
+        uses: actions/upload-artifact@v7
+        with:
+          name: glue-fixture-${{ github.sha }}
+          path: ${{ runner.temp }}/glue.pck
+          retention-days: 1
+
+      - name: Upload bake logs
+        if: always()
+        uses: actions/upload-artifact@v7
+        with:
+          name: bake-logs-${{ github.sha }}
+          path: |
+            ${{ runner.temp }}/bake.log
+            ${{ runner.temp }}/bake-fplus.log
+          if-no-files-found: ignore
+
+      - name: Save SCons cache
+        uses: actions/cache/save@v5
+        if: always()
+        with:
+          path: ${{ env.SCONS_CACHE }}
+          key: linux-editor-${{ runner.os }}-${{ github.sha }}
+
+  # The one check of the JS glue short of a headset: a real XRSession from IWER,
+  # an emulated WebXR runtime. Both Closure-built thread modes are required;
+  # the single-thread leg deliberately has no SharedArrayBuffer isolation.
+  webxr-glue-smoke:
+    needs: [web-template, linux-editor]
+    runs-on: ubuntu-24.04
+    timeout-minutes: 15
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - leg: stock
+            suffix: ""
+            no_isolation: "0"
+          - leg: stock-single
+            suffix: ".nothreads"
+            no_isolation: "1"
+
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v6
+
+      - name: Fetch the template
+        uses: actions/download-artifact@v8
+        with:
+          name: ${{ matrix.leg }}-template-${{ github.sha }}
+          path: ${{ runner.temp }}/artifacts
+
+      - name: Fetch the fixture
+        uses: actions/download-artifact@v8
+        with:
+          name: glue-fixture-${{ github.sha }}
+          path: ${{ runner.temp }}/artifacts
+
+      - name: Run the fixture in an emulated session
+        env:
+          GLUE_NO_ISOLATION: ${{ matrix.no_isolation }}
+        run: |
+          unzip -q "$RUNNER_TEMP/artifacts/godot.web.template_release.wasm32${{ matrix.suffix }}.zip" -d "$RUNNER_TEMP/template"
+          cd platform/web
+          npm i --no-save playwright iwer@2.7.0
+          npx playwright install --with-deps chromium
+          node ../../misc/webgpu_scripts/glue-smoke.mjs "$RUNNER_TEMP/template" "$RUNNER_TEMP/artifacts/glue.pck"
+
+  # The checks the upstream-sync workflow runs after a replay, run on every
+  # push instead, so a commit that would block the next Monday replay is
+  # reported within minutes of landing (one blocked two syncs in a row in
+  # October 2026 before anyone noticed).
+  check-stack:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 15
+
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v6
+        with:
+          fetch-depth: 0
+
+      # Full history, not a depth: the range upstream/master..HEAD is only the
+      # stack when the merge-base is present, and a shallow fetch stops short
+      # of it as soon as upstream is further ahead than the depth (475 commits
+      # in October 2026 against a depth of 200), which turns the range into
+      # all of Godot's history.
+      - name: Fetch upstream base
+        run: |
+          git remote add upstream https://github.com/godotengine/godot.git
+          git fetch --no-tags upstream master
+
+      # webgpu-dev is exempt by design: it holds what the stack rules exclude.
+      - name: Every stack commit carries a [wgpu NN] subject
+        if: github.ref == 'refs/heads/webgpu-stack' || startsWith(github.ref, 'refs/heads/auto-rebase/')
+        run: |
+          STRAYS=$(git log --format=%s upstream/master..HEAD | grep -v "^\[wgpu " || true)
+          if [ -n "$STRAYS" ]; then
+            echo "::error::commit(s) without a [wgpu NN] subject - the next upstream replay will refuse the stack: $STRAYS"
+            exit 1
+          fi
+          echo "$(git rev-list --count upstream/master..HEAD) patch(es), all [wgpu NN]"
+
+      - name: Check patch boundaries
+        run: bash misc/webgpu_scripts/check-stack.sh
diff --git a/WEBGPU_DRIVER_MIGRATION.md b/WEBGPU_DRIVER_MIGRATION.md
