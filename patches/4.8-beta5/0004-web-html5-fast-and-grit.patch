+    if not os.path.isfile(os.path.join(engine, "tools", "grit_build.py")):
+        fail("Grit: %s does not look like a Fast_Godot checkout (no "
+             "tools/grit_build.py)." % engine, 2)
+    if not toolchain:
+        toolchain = read_env(engine).get("toolchain_root") or ""
+    if toolchain:
+        toolchain = os.path.abspath(toolchain)
+    if toolchain and not os.path.isdir(toolchain):
+        fail("Grit: toolchain folder not found: %s" % toolchain, 2)
+    env = dict(os.environ)
+    python = toolchain_python(toolchain)
+    paths = []
+    scons = toolchain_scons(toolchain)
+    if scons:
+        env["PYTHONPATH"] = scons
+    # Production defaults (no debug symbols, static C++ runtime, LTO "auto" would
+    # be overridden by the explicit lto=none below) for editor builds too.
+    extra = ["production=yes", "lto=none"]
+
+    if platform == "windows":
+        mingw = os.path.join(toolchain, "mingw64", "bin")
+        if os.path.isdir(mingw):
+            paths.insert(0, mingw)
+        elif not which("gcc", env):
+            fail("Grit: no MinGW compiler; point --toolchain at a "
+                 "Fast_Godot_Toolchain_win64 bundle.", 5)
+        libffi = os.path.join(toolchain, "libffi", "3.8.0", "mingw64")
+        # detect.py asks MINGW_PREFIX for the MinGW headers (D3D12); setting it here
+        # keeps this build's signatures identical to the batch launcher's.
+        env["MINGW_PREFIX"] = os.path.join(toolchain, "mingw64")
+        winrt = os.path.join(toolchain, "winrt")
+        if os.path.isdir(winrt):
+            extra += ["winrt=yes", "winrt_path=" + winrt]
+        else:
+            extra += ["winrt=no"]
+        extra += ["use_mingw=yes", "use_volk=yes", "vulkan=yes", "accesskit=no"]
+        if os.path.isdir(libffi):
+            extra.append("cffi_libffi_path=" + libffi)
+        else:
+            fail("Grit: the toolchain has no libffi/3.8.0/mingw64 prefix, which CFFI "
+                 "needs on Windows.", 5)
+        angle = os.path.join(toolchain, "angle")
+        if os.path.isdir(angle):
+            # The toolchain ships the static ANGLE libraries; no download needed.
+            extra.append("angle_libs=" + angle)
+        elif options["deps"]:
+            install_angle(engine, python)
+        mesa = os.path.join(toolchain, "mesa-x86_64-gcc")
+        agility = os.path.join(toolchain, "agility_sdk")
+        if os.path.isdir(mesa) and os.path.isdir(agility):
+            # Bundled D3D12 drops: no download and no LOCALAPPDATA dependency.
+            extra += ["mesa_libs=" + os.path.join(toolchain, "mesa"), "agility_sdk_path=" + agility]
+        elif options["deps"]:
+            install_d3d12(engine, python, os.path.join(toolchain, "mingw64") if toolchain else "")
+    elif platform == "linuxbsd":
+        gcc_bin = os.path.join(toolchain, "gcc", "bin")
+        compiler = os.path.join(toolchain, "compiler")
+        if os.path.isfile(os.path.join(gcc_bin, "g++")):
+            extra += [
+                "CC=" + os.path.join(gcc_bin, "gcc"),
+                "CXX=" + os.path.join(gcc_bin, "g++"),
+            ]
+            paths.insert(0, gcc_bin)
+        elif os.path.isfile(os.path.join(compiler, "clang")):
+            extra += [
+                "CC=" + os.path.join(compiler, "clang"),
+                "CXX=" + os.path.join(compiler, "clang++"),
+                "use_static_cpp=no",
+            ]
+            paths.insert(0, compiler)
+        elif not which("g++", env):
+            fail("Grit: no C++ compiler; use a toolchain built with "
+                 "tools/toolchain/make_linux_gcc.sh.", 5)
+        libffi = os.path.join(toolchain, "libffi", "linux-x86_64")
+        if os.path.isdir(os.path.join(libffi, "include")):
+            extra.append("cffi_libffi_path=" + libffi)
+        extra.append("use_volk=yes")
+    elif platform == "macos":
+        if not which("xcrun", env):
+            fail("Grit: macOS builds need the Xcode Command Line Tools (xcrun).", 5)
+        moltenvk = os.path.join(toolchain, "moltenvk")
+        if os.path.isdir(os.path.join(moltenvk, "macOS", "lib", "MoltenVK.xcframework")):
+            extra += ["vulkan=yes", "vulkan_sdk_path=" + moltenvk]
+        # Keep clang's module cache inside the tree: TMPDIR is not writable in some
+        # sandboxes, and the shared cache also speeds up repeated builds.
+        if not any(arg.startswith("ccflags=") for arg in options["extra"]):
+            extra.append("ccflags=-fmodules-cache-path=" + os.path.join(engine, "out", "clangmods"))
+    else:
+        fail("Grit: unknown platform %s" % platform, 2)
+
+    if paths:
+        env["PATH"] = os.pathsep.join(paths + [env.get("PATH", "")])
+    command = [python, "-m", "SCons", "platform=" + platform, "target=editor",
+               "-j" + str(options["jobs"])] + extra + options["extra"]
+    announce("Grit: " + " ".join(command))
+    return subprocess.call(command, cwd=engine, env=env)
+
+
+def cli_export(kind, rest):
+    """Explicit CLI forms; the editor uses the positional form without a command."""
+    if kind == "html5_export":
+        if len(rest) < 5:
+            fail("usage: grit_build.py html5_export <engine> <generated> <target> "
+                 "<out> <profile> [optimized|size]", 2)
+        engine, generated, target, out, profile = rest[:5]
+        optimization = rest[5] if len(rest) > 5 else "optimized"
+        return export_main(["grit_build.py", engine, generated, target, out, "web",
+                            profile, "wasm32", optimization])
+    if len(rest) < 7:
+        fail("usage: grit_build.py native_export <engine> <generated> <target> <out> "
+             "<platform> <profile> <arch> [optimized|size]", 2)
+    return export_main(["grit_build.py"] + rest[:8])
+
+
+def main(argv):
+    if len(argv) > 1 and argv[1] == "editor":
+        return build_editor(argv[2:])
+    if len(argv) > 1 and argv[1] in ("native_export", "html5_export"):
+        return cli_export(argv[1], argv[2:])
+    return export_main(argv)
+
+
+if __name__ == "__main__":
+    try:
+        sys.exit(main(sys.argv))
+    except SystemExit:
+        raise
+    except Exception:
+        import traceback
+        try:
+            with open(os.path.join(os.path.dirname(os.path.abspath(sys.argv[1])) if len(sys.argv) > 1 else ".", "bin", "grit", "helper_error.txt"), "w", encoding="utf-8") as diag:
+                diag.write("argv: %r\n\n" % (sys.argv,))
+                traceback.print_exc(file=diag)
+        except OSError:
+            pass
+        traceback.print_exc()
+        sys.stdout.flush()
+        print("Grit: internal error in the build helper", flush=True)
+        sys.exit(1)
diff --git a/tools/grit_stage_editor.sh b/tools/grit_stage_editor.sh
new file mode 100755
index 0000000000..c5f7f4fda0
--- /dev/null
+++ b/tools/grit_stage_editor.sh
@@ -0,0 +1,80 @@
+#!/usr/bin/env bash
+# Stages the built editor for testing, so feature tests never run the binary that
+# sits in the build tree.
+#
+#   grit_stage_editor.sh <engine_root> [templates_dir]
+#
+# Why: a build profile or a plain template build regenerates shared headers in
+# the source tree (core/disabled_classes.gen.h, modules/modules_enabled.gen.h).
+# Objects live in per-target directories, but anything rebuilt while a different
+# module set is on disk is compiled against that set — which is how a tree-shaken
+# build once left a 493-class editor. A staged copy is immune: it was built and
+# verified once, and nothing later in the tree can change it.
+#
+# The staging directory contains everything the editor needs to run:
+#   Fast_Godot.app             a real app bundle (misc/dist/macos_tools.app plus
+#                              the built binary at Contents/MacOS/Godot)
+#   home/                      created by run.sh: a private HOME for tests, so the
+#                              staged editor never shares config or shader cache
+#   run.sh                     test launcher: same binary, HOME pinned to home/
+#   VERIFIED                   git revision + class count it was verified with
+#
+# Override the location with GRIT_EDITOR_STAGE.
+set -euo pipefail
+ENGINE="${1:?usage: grit_stage_editor.sh <engine_root> [templates_dir]}"
+TEMPLATES_SRC="${2:-${GRIT_TEMPLATES_SRC:-}}"
+STAGE="${GRIT_EDITOR_STAGE:-$ENGINE/out/editor-staging}"
+BIN="$ENGINE/bin/godot.macos.editor.arm64"
+
+[ -f "$BIN" ] || {
+	echo "Grit: $BIN not built yet (scons platform=macos target=editor)" >&2
+	exit 1
+}
+
+REV="$(git -C "$ENGINE" rev-parse --short HEAD 2>/dev/null || echo unknown)"
+
+APP_NAME="${GRIT_EDITOR_APP_NAME:-Fast_Godot}"
+APP="$STAGE/$APP_NAME.app"
+rm -rf "$STAGE"
+mkdir -p "$STAGE"
+# Stage the editor as the product ships: an app bundle, not a bare Mach-O.
+cp -R "$ENGINE/misc/dist/macos_tools.app" "$APP"
+mkdir -p "$APP/Contents/MacOS"
+cp "$BIN" "$APP/Contents/MacOS/Godot"
+chmod +x "$APP/Contents/MacOS/Godot"
+# Ad-hoc sign: an unsigned bundle still runs locally, but LaunchServices is
+# happier with a signature and it costs a second.
+codesign --force --sign - "$APP" >/dev/null 2>&1 || echo "Grit: ad-hoc codesign failed (the bundle will still run locally)" >&2
+
+# No export templates are staged: this fork keeps them inside the project
+# (<project>/exports/), so the editor builds or installs one per project the first
+# time a platform is added.
+
+# Verify the copy, not the tree binary: this is the build under test.
+cat > /tmp/grit_stage_check.gd <<'CHECK'
+extends SceneTree
+func _initialize() -> void:
+	print("classes=", ClassDB.get_class_list().size())
+	print("3d=", ClassDB.class_exists("StandardMaterial3D"))
+	quit()
+CHECK
+# Throwaway HOME: verification must not write into the user's real config.
+VERIFY_HOME="$(mktemp -d)"
+CHECK_OUT="$(HOME="$VERIFY_HOME" "$APP/Contents/MacOS/Godot" --headless --script /tmp/grit_stage_check.gd 2>&1 | grep -E 'classes=|3d=' || true)"
+CLASSES="$(printf '%s\n' "$CHECK_OUT" | sed -n 's/^classes=//p')"
+echo "Grit: staged $STAGE (rev $REV)"
+echo "$CHECK_OUT"
+
+if [ "${CLASSES:-0}" -lt 1000 ] 2>/dev/null; then
+	echo "Grit: WARNING staged editor reports ${CLASSES} classes; expected ~1078. The tree build is broken — rebuild before staging." >&2
+	exit 2
+fi
+echo "Grit: staged editor verified (classes=$CLASSES)"
+
+# The bundle has to be self-contained: nothing beside it, nothing pinned to this
+# machine's paths inside it.
+rm -rf "$VERIFY_HOME"
+LEFT="$(ls "$STAGE" | grep -v "\.app$" || true)"
+if [ -n "$LEFT" ]; then
+	echo "Grit: WARNING the staging directory has entries besides the app: $LEFT" >&2
+fi
diff --git a/tools/smoke_webgpu.js b/tools/smoke_webgpu.js
new file mode 100644
index 0000000000..bb77e2c3fb
--- /dev/null
+++ b/tools/smoke_webgpu.js
@@ -0,0 +1,95 @@
+#!/usr/bin/env node
+// Headless smoke test for the WebGPU web export.
+//
+// Serves nothing itself: start a static server in the export directory first,
+// e.g. `cd test_project/build-fast && python3 -m http.server 8125 --bind 127.0.0.1`.
+//
+// Usage:
+//   NODE_PATH=/tmp/node-test/node_modules node tools/smoke_webgpu.js
+//   PORT=8125 WAIT_MS=25000 SHOT=/tmp/grit.png node tools/smoke_webgpu.js
+//
+// Environment:
+//   PORT       server port                 (default 8125)
+//   CHROME     Chrome for Testing binary   (default /tmp/chrome-test/chrome-mac-arm64/...)
+//   WAIT_MS    settle time after ready     (default 20000; the debug template
+//              needs ~20 s of shader warm-up before it holds 60 FPS)
+//   TIMEOUT_MS ready timeout               (default 150000)
+//   SHOT       screenshot path             (default /tmp/webgpu_smoke.png)
+//
+// Requires `playwright-core` on NODE_PATH (the port's test harness lives in
+// /tmp/node-test; `npm i playwright-core` anywhere works).
+
+const { chromium } = require("playwright-core");
+const fs = require("fs");
+
+const PORT = process.env.PORT || "8125";
+const CHROME =
+  process.env.CHROME ||
+  "/tmp/chrome-test/chrome-mac-arm64/Google Chrome for Testing.app/Contents/MacOS/Google Chrome for Testing";
+const WAIT_MS = Number(process.env.WAIT_MS || 20000);
+const TIMEOUT_MS = Number(process.env.TIMEOUT_MS || 150000);
+const SHOT = process.env.SHOT || "/tmp/webgpu_smoke.png";
+
+(async () => {
+  if (!fs.existsSync(CHROME)) {
+    console.error(`Chrome for Testing not found at ${CHROME} (set CHROME=...)`);
+    process.exit(2);
+  }
+  const browser = await chromium.launch({
+    headless: true,
+    executablePath: CHROME,
+    args: ["--enable-unsafe-webgpu", "--no-first-run", "--no-default-browser-check"],
+  });
+  const page = await browser.newPage({ viewport: { width: 960, height: 540 } });
+
+  const errors = [];
+  page.on("console", (m) => {
+    const text = m.text();
+    if (m.type() === "error" || text.includes("GPUValidationError")) {
+      errors.push(text);
+      console.log("[console:error]", text.split("\n")[0]);
+    }
+  });
+  page.on("pageerror", (e) => {
+    errors.push("pageerror: " + e.message);
+    console.log("[pageerror]", e.message);
+  });
+
+  await page.goto(`http://127.0.0.1:${PORT}/index.html`, { waitUntil: "load", timeout: 60000 });
+  console.log("[probe] navigator.gpu =", await page.evaluate(() => !!navigator.gpu));
+
+  let ready = false;
+  try {
+    await page.waitForFunction(() => window.__webgpu_test_ready === true, null, { timeout: TIMEOUT_MS });
+    ready = true;
+  } catch (e) {
+    console.log("[wait] timed out:", e.message.split("\n")[0]);
+  }
+  if (ready) await page.waitForTimeout(WAIT_MS);
+
+  const state = await page.evaluate(() => ({
+    ready: window.__webgpu_test_ready === true,
+    fps: window.__webgpu_fps || 0,
+    draws: window.__webgpu_draws || 0,
+    title: document.title,
+    notice: (document.getElementById("status-notice") || {}).textContent || "",
+    statusVisible: !!document.getElementById("status"),
+  }));
+  console.log("[state]", JSON.stringify(state));
+  await page.screenshot({ path: SHOT });
+
+  // Ignore the favicon 404 and the engine's benign shader-log warnings.
+  const gpuErrors = errors.filter((e) => e.includes("GPUValidationError") || e.includes("WebGPU uncaptured error"));
+  const otherErrors = errors.filter(
+    (e) => !gpuErrors.includes(e) && !e.includes("404") && !e.includes("Compilation log") && !e.includes("code is unreachable"),
+  );
+  console.log(`[gpu-errors] ${gpuErrors.length} [other-errors] ${otherErrors.length} [screenshot] ${SHOT}`);
+
+  const pass = ready && gpuErrors.length === 0 && otherErrors.length === 0 && state.fps >= 50;
+  console.log(pass ? "RESULT: PASS" : "RESULT: FAIL");
+  await browser.close();
+  process.exit(pass ? 0 : 1);
+})().catch((e) => {
+  console.error("FATAL", e);
+  process.exit(1);
+});
diff --git a/tools/stage_editor.sh b/tools/stage_editor.sh
new file mode 100755
index 0000000000..b32ffb71d0
--- /dev/null
+++ b/tools/stage_editor.sh
@@ -0,0 +1,47 @@
+#!/bin/bash
+# Stage the editor built from this tree into the local staging app bundle.
+#
+# The staging bundle is a local, gitignored artifact (out/editor-staging) used
+# for manually testing exports. Every editor rebuild should be staged here:
+# this copies the binary over the bundle's executable, strips the Dropbox/Finder
+# metadata that makes codesign fail, and ad-hoc re-signs the bundle.
+#
+# Usage: ./tools/stage_editor.sh
+#        STAGE_DIR=/path/to/editor-staging ./tools/stage_editor.sh
+set -euo pipefail
+ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+STAGE="${STAGE_DIR:-$ROOT/out/editor-staging}"
+APP="$STAGE/Fast_Godot.app"
+SRC="$ROOT/bin/godot.macos.editor.arm64"
+DST="$APP/Contents/MacOS/Godot"
+
+if [ ! -x "$SRC" ]; then
+    echo "Missing editor build: $SRC (build it with tools/grit_build.py editor)" >&2
+    exit 1
+fi
+if [ ! -d "$APP" ]; then
+    # Recreate the bundle skeleton from the editor app template. This keeps the
+    # staging folder self-contained: a build can be staged even after the app was
+    # moved out (e.g. copied to /Applications for a quick run).
+    TEMPLATE="$ROOT/misc/dist/macos_tools.app"
+    if [ ! -d "$TEMPLATE" ]; then
+        echo "Missing staging app bundle: $APP (and template $TEMPLATE)" >&2
+        exit 1
+    fi
+    echo "[stage] recreating $APP from $TEMPLATE"
+    mkdir -p "$STAGE"
+    ditto "$TEMPLATE" "$APP"
+fi
+mkdir -p "$APP/Contents/MacOS"
+
+cp -p "$SRC" "$DST"
+
+# Dropbox and Finder add xattrs/resource forks that make codesign refuse the
+# bundle ("resource fork, Finder information, or similar detritus not allowed").
+xattr -cr "$APP"
+codesign --force --deep --sign - "$APP"
+codesign --verify --strict "$APP"
+
+VERSION="$("$DST" --headless --version 2>&1 | tail -1)"
+echo "[stage] $DST"
+echo "[stage] $VERSION"
diff --git a/tools/toolchain/download_toolchain.cmd b/tools/toolchain/download_toolchain.cmd
new file mode 100755
index 0000000000..04a5a4d239
--- /dev/null
+++ b/tools/toolchain/download_toolchain.cmd
@@ -0,0 +1,150 @@
+@echo off
+setlocal EnableExtensions EnableDelayedExpansion
+rem Downloads a complete Fast_Godot toolchain from the original sources into
+rem %USERPROFILE%\fast_godot_toolchain (or the folder given as %1).
+rem Uses only curl.exe, tar.exe and certutil.exe, which ship with Windows 10/11.
+rem Emscripten is the one exception: emsdk is a Python program and installs
+rem Emscripten itself with the Python downloaded here.
+rem Progress is printed as "GRIT_PROGRESS <percent> <label>" and the result as
+rem "GRIT_DONE <folder>" / "GRIT_ERROR <text>", which the editor reads.
+
+set "DEST=%~1"
+set "PROG=%~2"
+if not defined DEST set "DEST=%USERPROFILE%\fast_godot_toolchain"
+if not exist "%DEST%" mkdir "%DEST%"
+set "TMP=%DEST%\.download"
+if exist "%TMP%" rmdir /s /q "%TMP%"
+mkdir "%TMP%"
+
+call :fetch "https://github.com/astral-sh/python-build-standalone/releases/download/20261110/cpython-3.12.16+20261110-x86_64-pc-windows-msvc-install_only.tar.gz" "e23fe5b16926de1d81661b1a97352e89fb167549c55a6825796ccd0f32ec7f1b" "%TMP%\python.tar.gz" "10" "Python" || goto :fail
+tar.exe -xzf "%TMP%\python.tar.gz" -C "%DEST%" || goto :fail
+
+call :fetch "https://files.pythonhosted.org/packages/42/b9/b7a5c88f348a0c34594d88100872c55fa1cae863ccb222c1c438341b5503/scons-4.11.1.tar.gz" "4210d1a80a62e986029208117991b6347ccaaaab37b67463a3ff31ee065dc487" "%TMP%\scons.tar.gz" "18" "SCons" || goto :fail
+if not exist "%DEST%\scons\4.11.1" mkdir "%DEST%\scons\4.11.1"
+tar.exe -xzf "%TMP%\scons.tar.gz" -C "%DEST%\scons\4.11.1" || goto :fail
+
+call :fetch "https://github.com/brechtsanders/winlibs_mingw/releases/download/16.2.0posix-23.1.3-14.0.0-ucrt-r3/winlibs-x86_64-posix-seh-gcc-16.2.0-mingw-w64ucrt-14.0.0-r3.zip" "3c69305081e4a647144339a936244fcf7d3d9e558319e1ad7be2cd2886d4b6a1" "%TMP%\mingw.zip" "28" "MinGW-w64" || goto :fail
+tar.exe -xf "%TMP%\mingw.zip" -C "%DEST%" || goto :fail
+
+call :fetch "https://repo.msys2.org/mingw/mingw64/mingw-w64-x86_64-libffi-3.8.0-1-any.pkg.tar.zst" "6dad7f3c6c900d3c64a4fe0c2764b405e678b22df3521d2284ffaeff0198b84b" "%TMP%\libffi.pkg.tar.zst" "48" "libffi" || goto :fail
+if exist "%TMP%\libffi" rmdir /s /q "%TMP%\libffi"
+mkdir "%TMP%\libffi"
+tar.exe -xf "%TMP%\libffi.pkg.tar.zst" -C "%TMP%\libffi" || goto :fail
+mkdir "%DEST%\libffi\3.8.0\mingw64\include" 2>nul
+mkdir "%DEST%\libffi\3.8.0\mingw64\lib" 2>nul
+copy /y "%TMP%\libffi\mingw64\include\*.h" "%DEST%\libffi\3.8.0\mingw64\include\" >nul || goto :fail
+copy /y "%TMP%\libffi\mingw64\lib\libffi*.a" "%DEST%\libffi\3.8.0\mingw64\lib\" >nul || goto :fail
+rem libffi's dlopen/dlclose/dl* symbols collide with SDL's dlmalloc: rename them.
+set "FFI=%DEST%\libffi\3.8.0\mingw64\lib"
+powershell -NoProfile -Command "$nm='%DEST%\mingw64\bin\nm.exe'; $ar='%DEST%\mingw64\bin\objcopy.exe'; $f='%FFI%\libffi.a'; $r='%TMP%\redefines.txt'; & $nm --defined-only $f | Where-Object { $_ -match '^[0-9a-f]+ [A-Za-z] dl' } | ForEach-Object { $p = $_ -split '\s+'; $p[2] + ' ffi_' + $p[2] } | Set-Content -Encoding ascii $r; if (Test-Path $r) { & $ar --redefine-syms=$r $f }"
+if errorlevel 1 goto :fail
+
+call :fetch "https://github.com/godotengine/godot-angle-static/releases/download/chromium/7219/godot-angle-static-x86_64-gcc-release.zip" "ebf94e32334b04fa76b3907727c7a69c35adb713cf0a5d194c83c7ad955217bd" "%TMP%\angle.zip" "58" "ANGLE" || goto :fail
+if not exist "%DEST%\angle" mkdir "%DEST%\angle"
+tar.exe -xf "%TMP%\angle.zip" -C "%DEST%\angle" || goto :fail
+
+call :fetch "https://github.com/godotengine/godot-nir-static/releases/download/25.3.1-3/godot-nir-static-x86_64-gcc-release.zip" "dc98a962ac90613a4fccf29082d34b12fcb97bf3819517125bc3d1c86ed31afc" "%TMP%\mesa.zip" "66" "Mesa NIR" || goto :fail
+if not exist "%DEST%\mesa-x86_64-gcc" mkdir "%DEST%\mesa-x86_64-gcc"
+tar.exe -xf "%TMP%\mesa.zip" -C "%DEST%\mesa-x86_64-gcc" || goto :fail
+
+call :fetch "https://www.nuget.org/api/v2/package/Microsoft.Direct3D.D3D12/1.618.5" "0027fc24f947c48dbded13ada7d280be221eb651644e23a8a476f0f1f0a079dd" "%TMP%\agility.nupkg" "74" "Agility SDK" || goto :fail
+if not exist "%DEST%\agility_sdk" mkdir "%DEST%\agility_sdk"
+tar.exe -xf "%TMP%\agility.nupkg" -C "%DEST%\agility_sdk" || goto :fail
+
+call :fetch "https://github.com/godotengine/winrt-mingw/releases/download/72/winrt-headers.zip" "9310868d0a82d11b7ae1943c4f35c202c6c9a692ee2deec4bde241fbe2639961" "%TMP%\winrt.zip" "82" "WinRT headers" || goto :fail
+if not exist "%DEST%\winrt" mkdir "%DEST%\winrt"
+tar.exe -xf "%TMP%\winrt.zip" -C "%DEST%\winrt" || goto :fail
+
+call :fetch "https://github.com/emscripten-core/emsdk/archive/refs/tags/4.0.11.tar.gz" "058f97f3d408e6438c0128de63fc83b085a1a1c8f8e2ef992edee01281af9546" "%TMP%\emsdk.tar.gz" "88" "emsdk" || goto :fail
+if exist "%DEST%\emsdk" rmdir /s /q "%DEST%\emsdk"
+mkdir "%DEST%\emsdk"
+tar.exe -xzf "%TMP%\emsdk.tar.gz" -C "%DEST%\emsdk" --strip-components=1 || goto :fail
+pushd "%DEST%\emsdk"
+"%DEST%\python\python.exe" emsdk.py install 4.0.11 >nul || goto :fail
+"%DEST%\python\python.exe" emsdk.py activate 4.0.11 >nul || goto :fail
+popd
+
+call :progress 90 "Engine source"
+rem The toolchain carries the engine source tree at engine\source. The editor
+rem unpacks it there and runs this script from it, so there is nothing to copy; a
+rem manual run from a checkout copies the tree it runs from instead. The folder
+rem has no revision in its name: the toolchain works with any 4.7.x editor.
+set "ENGINE_ROOT=%~dp0..\.."
+set "ENGINE_DEST=%DEST%\engine\source"
+if exist "%ENGINE_DEST%\SConstruct" goto :engine_ready
+if not exist "%ENGINE_ROOT%\SConstruct" goto :fail
+if not exist "%ENGINE_ROOT%\tools\grit_build.py" goto :fail
+if exist "%ENGINE_DEST%" rmdir /s /q "%ENGINE_DEST%"
+mkdir "%ENGINE_DEST%"
+tar.exe -cf "%TMP%\engine.tar" -C "%ENGINE_ROOT%" --exclude=.git --exclude=./bin --exclude=./out --exclude=./.godot --exclude=./compile_commands.json --exclude=./.sconsign.dblite --exclude=./.sconsign5.dblite --exclude=./.scons_env.json --exclude=./.scons_node_count --exclude=__pycache__ --exclude=.DS_Store . || goto :fail
+tar.exe -xf "%TMP%\engine.tar" -C "%ENGINE_DEST%" || goto :fail
+del /q "%TMP%\engine.tar" 2>nul
+if not exist "%ENGINE_DEST%\SConstruct" goto :fail
+:engine_ready
+call :progress 96 "verifying"
+for %%F in (
+  "%DEST%\python\python.exe"
+  "%DEST%\scons\4.11.1\scons-4.11.1\SCons\__init__.py"
+  "%DEST%\mingw64\bin\gcc.exe"
+  "%DEST%\libffi\3.8.0\mingw64\lib\libffi.a"
+  "%DEST%\angle\libEGL.windows.x86_64.a"
+  "%DEST%\mesa-x86_64-gcc\bin\libNIR.windows.x86_64.a"
+  "%DEST%\agility_sdk\build\native\bin\x64\D3D12Core.dll"
+  "%DEST%\winrt\winrt\Windows.Foundation.h"
+  "%DEST%\emsdk\upstream\emscripten\emcc.bat"
+  "%ENGINE_DEST%\SConstruct"
+) do (
+  if not exist %%F ( echo GRIT_ERROR missing %%F & goto :fail )
+)
+
+> "%DEST%\toolchain.json" (
+  echo {
+  echo   "name": "Fast_Godot_Toolchain_win64",
+  echo   "format": 1,
+  echo   "engineVersion": "4.7.2-stable",
+  echo   "platform": "windows",
+  echo   "arch": "x86_64",
+  echo   "engine": "engine/source",
+  echo   "python": "python",
+  echo   "scons": "scons/4.11.1/scons-4.11.1",
+  echo   "mingw": "mingw64",
+  echo   "libffi": "libffi/3.8.0/mingw64",
+  echo   "angle": "angle",
+  echo   "mesa": "mesa-x86_64-gcc",
+  echo   "agility_sdk": "agility_sdk",
+  echo   "winrt": "winrt",
+  echo   "emsdk": "emsdk"
+  echo }
+)
+
+rmdir /s /q "%TMP%"
+call :progress 100 "toolchain ready"
+echo GRIT_DONE %DEST%
+if defined PROG echo GRIT_DONE %DEST%>>"%PROG%"
+endlocal & exit /b 0
+
+:fetch
+rem %1 url, %2 sha256, %3 file, %4 percent, %5 label
+call :progress %~4 "%~5"
+curl.exe -sSfL --retry 3 -o "%~3" "%~1" || ( echo GRIT_ERROR could not download %~1 & if defined PROG echo GRIT_ERROR could not download %~1>>"%PROG%" & exit /b 1 )
+set "GOT="
+for /f "delims=" %%H in ('certutil -hashfile "%~3" SHA256 ^| findstr /r "^[0-9a-fA-F][0-9a-fA-F]*$"') do (
+  set "H=%%H"
+  set "H=!H: =!"
+  if not defined GOT set "GOT=!H!"
+)
+set "WANT=%~2"
+if /i not "!GOT!"=="!WANT!" ( echo GRIT_ERROR checksum mismatch for %~1 & if defined PROG echo GRIT_ERROR checksum mismatch for %~1>>"%PROG%" & exit /b 1 )
+exit /b 0
+
+:fail
+echo GRIT_ERROR the download failed
+if defined PROG echo GRIT_ERROR the download failed>>"%PROG%"
+rmdir /s /q "%TMP%" 2>nul
+endlocal & exit /b 1
+
+:progress
+rem %1 percent, %2 label
+echo GRIT_PROGRESS %~1 %~2
+if defined PROG echo GRIT_PROGRESS %~1 %~2>>"%PROG%"
+exit /b 0
diff --git a/tools/toolchain/download_toolchain.sh b/tools/toolchain/download_toolchain.sh
new file mode 100755
index 0000000000..57ce8fee47
--- /dev/null
+++ b/tools/toolchain/download_toolchain.sh
@@ -0,0 +1,198 @@
+#!/bin/sh
+# Downloads a complete Fast_Godot toolchain from the original sources into
+# <dest> (default: ~/fast_godot_toolchain). No Python is used to download or unpack
+# anything: curl, tar and (on Linux) ar/dpkg-deb do the work. Emscripten is the one
+# exception: emsdk is a Python program and installs Emscripten itself, using the
+# toolchain interpreter that was just downloaded.
+#
+# Progress is reported on stdout as "GRIT_PROGRESS <percent> <label>", errors as
+# "GRIT_ERROR <text>", and success as "GRIT_DONE <path>"; the editor reads those.
+#
+# usage: download_toolchain.sh [dest] [progress-file]
+set -e
+
+here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+dest=${1:-${HOME:-/tmp}/fast_godot_toolchain}
+prog=${2:-}
+os=$(uname -s)
+arch=$(uname -m)
+
+progress() {
+	printf 'GRIT_PROGRESS %s %s\n' "$1" "$2"
+	if [ -n "$prog" ]; then
+		printf 'GRIT_PROGRESS %s %s\n' "$1" "$2" >> "$prog"
+	fi
+}
+fail() {
+	printf 'GRIT_ERROR %s\n' "$1"
+	[ -n "$prog" ] && printf 'GRIT_ERROR %s\n' "$1" >> "$prog"
+	exit 1
+}
+sha256() {
+	if command -v sha256sum >/dev/null 2>&1; then
+		sha256sum "$1" | cut -d' ' -f1
+	elif command -v shasum >/dev/null 2>&1; then
+		shasum -a 256 "$1" | cut -d' ' -f1
+	else
+		return 1
+	fi
+}
+fetch() {
+	url=$1
+	sum=$2
+	out=$3
+	curl -sSfL --retry 3 -o "$out" "$url" || fail "could not download $url"
+	got=$(sha256 "$out") || fail "no sha256 tool"
+	[ "$got" = "$sum" ] || fail "checksum mismatch for $url"
+}
+
+tmp=$(mktemp -d)
+trap 'rm -rf "$tmp"' EXIT
+mkdir -p "$dest"
+cd "$dest"
+
+progress 5 "Python and SCons"
+if [ "$os" = "Darwin" ]; then
+	if [ "$arch" = "arm64" ]; then
+		PY_SHA="e956e60bc9465d577ef8062059aa05cd3a2665b4b8678a2ed24e432368330b8f"
+		PY_URL="https://github.com/astral-sh/python-build-standalone/releases/download/20261110/cpython-3.12.16%2B20261110-aarch64-apple-darwin-install_only.tar.gz"
+	else
+		PY_SHA="83f2922437e6d546d0fcdb8c11f150a8e52787e8d9ea8651b1974e20908eb1bc"
+		PY_URL="https://github.com/astral-sh/python-build-standalone/releases/download/20261110/cpython-3.12.16%2B20261110-x86_64-apple-darwin-install_only.tar.gz"
+	fi
+else
+	PY_SHA="c2f87d4b4e8db3abddb0f116c6ccfc503d0cbdbb9ee8faacddad1b679ec12e99"
+	PY_URL="https://github.com/astral-sh/python-build-standalone/releases/download/20261110/cpython-3.12.16%2B20261110-x86_64-unknown-linux-gnu-install_only.tar.gz"
+fi
+fetch "$PY_URL" "$PY_SHA" "$tmp/python.tar.gz"
+tar -xzf "$tmp/python.tar.gz" -C "$dest"
+
+SCONS_URL="https://files.pythonhosted.org/packages/42/b9/b7a5c88f348a0c34594d88100872c55fa1cae863ccb222c1c438341b5503/scons-4.11.1.tar.gz"
+SCONS_SHA="4210d1a80a62e986029208117991b6347ccaaaab37b67463a3ff31ee065dc487"
+mkdir -p "$dest/scons/4.11.1"
+fetch "$SCONS_URL" "$SCONS_SHA" "$tmp/scons.tar.gz"
+tar -xzf "$tmp/scons.tar.gz" -C "$dest/scons/4.11.1"
+
+if [ "$os" = "Linux" ]; then
+	progress 20 "libffi"
+	LIBFFI_URL="http://archive.ubuntu.com/ubuntu/pool/main/libf/libffi/libffi-dev_3.3-4_amd64.deb"
+	LIBFFI_SHA="8c83e874ec75c223774eb0aa083022496a8199f88471f1cb46f5de473d748f71"
+	fetch "$LIBFFI_URL" "$LIBFFI_SHA" "$tmp/libffi.deb"
+	mkdir -p "$tmp/ffi"
+	if command -v dpkg-deb >/dev/null 2>&1; then
+		dpkg-deb -x "$tmp/libffi.deb" "$tmp/ffi"
+	else
+		(cd "$tmp/ffi" && ar p "$tmp/libffi.deb" data.tar.* | tar -x)
+	fi
+	mkdir -p "$dest/libffi/linux-x86_64/include" "$dest/libffi/linux-x86_64/lib"
+	for inc in "$tmp/ffi/usr/include" "$tmp/ffi/usr/include/x86_64-linux-gnu"; do
+		[ -d "$inc" ] || continue
+		cp "$inc"/*ffi*.h "$dest/libffi/linux-x86_64/include/" 2>/dev/null || true
+	done
+	[ -f "$dest/libffi/linux-x86_64/include/ffi.h" ] || fail "libffi headers were not found in the package"
+	cp "$tmp/ffi/usr/lib/x86_64-linux-gnu/libffi.a" "$dest/libffi/linux-x86_64/lib/"
+
+	progress 35 "GCC 9, glibc 2.31 sysroot and wayland-scanner"
+	bash "$here/make_linux_gcc.sh" "$dest"
+else
+	progress 35 "MoltenVK"
+	MOLTENVK_URL="https://github.com/KhronosGroup/MoltenVK/releases/download/v1.4.2/MoltenVK-macos.tar"
+	MOLTENVK_SHA="f95765a6229cb7b915990a2890ce12ebe36a730b021545d3d52ae69ce4c4024e"
+	fetch "$MOLTENVK_URL" "$MOLTENVK_SHA" "$tmp/moltenvk.tar"
+	mkdir -p "$tmp/mv"
+	tar -xf "$tmp/moltenvk.tar" -C "$tmp/mv" MoltenVK/MoltenVK/static/MoltenVK.xcframework
+	rm -rf "$dest/moltenvk"
+	mkdir -p "$dest/moltenvk/macOS/lib"
+	mv "$tmp/mv/MoltenVK/MoltenVK/static/MoltenVK.xcframework" "$dest/moltenvk/macOS/lib/"
+fi
+
+progress 60 "Emscripten 4.0.11 (emsdk)"
+EMSDK_URL="https://github.com/emscripten-core/emsdk/archive/refs/tags/4.0.11.tar.gz"
+EMSDK_SHA="058f97f3d408e6438c0128de63fc83b085a1a1c8f8e2ef992edee01281af9546"
+fetch "$EMSDK_URL" "$EMSDK_SHA" "$tmp/emsdk.tar.gz"
+mkdir -p "$tmp/emsdk"
+tar -xzf "$tmp/emsdk.tar.gz" -C "$tmp/emsdk"
+rm -rf "$dest/emsdk"
+mv "$tmp/emsdk"/emsdk-4.0.11 "$dest/emsdk"
+python="$dest/python/bin/python3"
+[ -x "$python" ] || fail "the downloaded Python is missing"
+"$python" "$dest/emsdk/emsdk.py" install 4.0.11 >/dev/null
+"$python" "$dest/emsdk/emsdk.py" activate 4.0.11 >/dev/null
+
+progress 82 "Engine source"
+# The toolchain carries the engine source tree at engine/source. The editor
+# unpacks it there and runs this script from it, so there is nothing to copy; a
+# manual run from a checkout copies the tree it runs from instead. The folder has
+# no revision in its name: the toolchain works with any 4.7.x editor.
+engine_root=$(CDPATH= cd -- "$here/../.." && pwd)
+engine_dest="$dest/engine/source"
+if [ -f "$engine_dest/SConstruct" ] && [ -f "$engine_dest/tools/grit_build.py" ]; then
+	progress 82 "Engine source (already in the toolchain)"
+else
+	[ -f "$engine_root/SConstruct" ] || fail "cannot find the Fast_Godot source tree at $engine_root"
+	[ -f "$engine_root/tools/grit_build.py" ] || fail "the tree at $engine_root is not a Fast_Godot checkout"
+	rm -rf "$engine_dest"
+	mkdir -p "$engine_dest"
+	# Stream the working tree (not version-control data or build outputs) straight
+	# into the bundle; no temporary archive is needed.
+	(
+		cd "$engine_root" &&
+		tar -cf - \
+			--exclude=.git --exclude=./bin --exclude=./out --exclude=./.godot \
+			--exclude=./compile_commands.json --exclude=./.sconsign.dblite \
+			--exclude=./.sconsign5.dblite --exclude=./.scons_env.json \
+			--exclude=./.scons_node_count --exclude=__pycache__ --exclude=.DS_Store \
+			. 2>/dev/null
+	) | tar -xf - -C "$engine_dest" || fail "could not copy the engine source into the toolchain"
+	[ -f "$engine_dest/SConstruct" ] && [ -f "$engine_dest/tools/grit_build.py" ] || fail "the engine source copy is incomplete"
+fi
+
+progress 90 "verifying"
+for f in "$dest/python/bin/python3" "$dest/scons/4.11.1/scons-4.11.1/SCons/__init__.py" "$dest/emsdk/upstream/emscripten/emcc" "$engine_dest/SConstruct"; do
+	[ -e "$f" ] || fail "missing $f"
+done
+if [ "$os" = "Linux" ]; then
+	[ -x "$dest/gcc/bin/gcc" ] || fail "missing the GCC wrappers"
+	[ -x "$dest/gcc/bin/wayland-scanner" ] || fail "missing wayland-scanner"
+else
+	[ -d "$dest/moltenvk/macOS/lib/MoltenVK.xcframework" ] || fail "missing MoltenVK"
+fi
+
+if [ "$os" = "Linux" ]; then
+	cat > "$dest/toolchain.json" <<JSON
+{
+  "name": "Fast_Godot_Toolchain_linux_x86_64",
+  "format": 1,
+  "engineVersion": "4.7.2-stable",
+  "platform": "linux",
+  "arch": "x86_64",
+  "engine": "engine/source",
+  "python": "python",
+  "scons": "scons/4.11.1/scons-4.11.1",
+  "gcc": "gcc",
+  "libffi": "libffi/linux-x86_64",
+  "emsdk": "emsdk"
+}
+JSON
+else
+	cat > "$dest/toolchain.json" <<JSON
+{
+  "name": "Fast_Godot_Toolchain_macos_$arch",
+  "format": 1,
+  "engineVersion": "4.7.2-stable",
+  "platform": "macos",
+  "arch": "$arch",
+  "engine": "engine/source",
+  "python": "python",
+  "scons": "scons/4.11.1/scons-4.11.1",
+  "moltenvk": "moltenvk",
+  "emsdk": "emsdk"
+}
+JSON
+fi
+
+progress 100 "toolchain ready"
+printf 'GRIT_DONE %s\n' "$dest"
+if [ -n "$prog" ]; then
+	printf 'GRIT_DONE %s\n' "$dest" >> "$prog"
+fi
