+Error FileAccessEncrypted::open_and_parse_keystream(Ref<FileAccess> p_base, BlockEncryptFunc p_block_encrypt, bool p_with_magic) {
+	ERR_FAIL_COND_V_MSG(file.is_valid(), ERR_ALREADY_IN_USE, vformat("Can't open file while another file from path '%s' is open.", file->get_path_absolute()));
+	ERR_FAIL_NULL_V(p_block_encrypt, ERR_INVALID_PARAMETER);
+
+	pos = 0;
+	eofed = false;
+	use_magic = p_with_magic;
+	writing = false;
+	key.clear(); // No key exists in this process.
+
+	if (use_magic) {
+		uint32_t magic = p_base->get_32();
+		ERR_FAIL_COND_V(magic != ENCRYPTED_HEADER_MAGIC, ERR_FILE_UNRECOGNIZED);
+	}
+
+	unsigned char md5d[16];
+	p_base->get_buffer(md5d, 16);
+	length = p_base->get_64();
+
+	iv.resize(16);
+	p_base->get_buffer(iv.ptrw(), 16);
+
+	base = p_base->get_position();
+	ERR_FAIL_COND_V(p_base->get_length() < base + length, ERR_FILE_CORRUPT);
+	uint64_t ds = length;
+	if (ds % 16) {
+		ds += 16 - (ds % 16);
+	}
+	data.resize(ds);
+	uint64_t blen = p_base->get_buffer(data.ptrw(), ds);
+	ERR_FAIL_COND_V(blen != ds, ERR_FILE_CORRUPT);
+
+	// AES-CFB(128) decryption: keystream block i = E(prev ciphertext block), with
+	// the IV standing in for block -1. Only block encryption is needed, so the
+	// white-box tables can drive it without ever materialising the key.
+	uint8_t prev[16];
+	memcpy(prev, iv.ptr(), 16);
+	for (uint64_t off = 0; off < ds; off += 16) {
+		uint8_t keystream[16];
+		if (!p_block_encrypt(prev, keystream)) {
+			SecureMemory::zero(keystream, sizeof(keystream));
+			SecureMemory::zero(prev, sizeof(prev));
+			data.clear();
+			ERR_FAIL_V_MSG(ERR_UNAVAILABLE, "The white-box keystream provider refused a block (a debugger may be attached).");
+		}
+		uint8_t cipher[16];
+		memcpy(cipher, data.ptr() + off, 16);
+		for (int i = 0; i < 16; i++) {
+			data.write[off + i] ^= keystream[i];
+		}
+		memcpy(prev, cipher, 16);
+		SecureMemory::zero(keystream, sizeof(keystream));
+		SecureMemory::zero(cipher, sizeof(cipher));
+	}
+	SecureMemory::zero(prev, sizeof(prev));
+	data.resize(length);
+
+	unsigned char hash[16];
+	ERR_FAIL_COND_V(CryptoCore::md5(data.ptr(), data.size(), hash) != OK, ERR_BUG);
+	ERR_FAIL_COND_V_MSG(String::md5(hash) != String::md5(md5d), ERR_FILE_CORRUPT, "The MD5 sum of the decrypted file does not match the expected value. It could be that the file is corrupt, or that the template does not match the pack key it was built for.");
+
+	file = p_base;
+	return OK;
+}
+
