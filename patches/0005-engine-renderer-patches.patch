+void ShaderBakerExportPlugin::_bake_wgsl_cache() {
+	if (wgsl_spv_files.is_empty() && wgsl_spv_files_force_depth.is_empty()) {
+		_cleanup_wgsl_bake();
+		return;
+	}
+
+	const String tint_cli = _find_tint_convert_cli();
+	if (tint_cli.is_empty()) {
+		WARN_PRINT("Shader baker: bin/tint_convert_cli not found; shaders will be translated to WGSL at runtime instead of being baked.");
+		_cleanup_wgsl_bake();
+		return;
+	}
+
+	HashMap<uint64_t, String> baked;
+	uint32_t failed_translations = 0;
+	const uint32_t force_depth_entries = wgsl_spv_files_force_depth.size();
+	const uint32_t total_entries = wgsl_spv_files.size() + force_depth_entries;
+
+	for (int pass = 0; pass < 2; pass++) {
+		const bool force_depth = pass == 1;
+		const HashMap<uint64_t, String> &files = force_depth ? wgsl_spv_files_force_depth : wgsl_spv_files;
+		if (files.is_empty()) {
+			continue;
+		}
+
+		// The CLI mirrors the driver's depth-image typing only when asked to.
+		if (force_depth) {
+			OS::get_singleton()->set_environment("TINT_FORCE_DEPTH", "1");
+		} else {
+			OS::get_singleton()->unset_environment("TINT_FORCE_DEPTH");
+		}
+
+		LocalVector<Pair<uint64_t, String>> items;
+		for (const KeyValue<uint64_t, String> &E : files) {
+			items.push_back({ E.key, E.value });
+		}
+
+		constexpr uint32_t BATCH_SIZE = 256;
+		for (uint32_t start = 0; start < items.size(); start += BATCH_SIZE) {
+			List<String> args;
+			args.push_back("--batch");
+			HashMap<String, uint64_t> path_to_hash;
+			for (uint32_t i = start; i < items.size() && i < start + BATCH_SIZE; i++) {
+				args.push_back(items[i].second);
+				path_to_hash[items[i].second] = items[i].first;
+			}
+
+			String pipe;
+			int exit_code = -1;
+			const Error err = OS::get_singleton()->execute(tint_cli, args, &pipe, &exit_code, false);
+			if (err != OK || exit_code != 0) {
+				WARN_PRINT(vformat("Shader baker: tint_convert_cli failed (exit %d), skipping %d stages.", exit_code, (int)path_to_hash.size()));
+				continue;
+			}
+
+			const Variant parsed = JSON::parse_string(pipe);
+			if (parsed.get_type() != Variant::DICTIONARY) {
+				WARN_PRINT("Shader baker: could not parse the tint_convert_cli batch output; skipping this batch.");
+				continue;
+			}
+
+			const Dictionary results = parsed;
+			for (const KeyValue<String, uint64_t> &E : path_to_hash) {
+				const Variant *result = results.getptr(E.key);
+				if (result == nullptr) {
+					continue;
+				}
+				if (result->get_type() == Variant::STRING) {
+					baked[E.value] = String(*result);
+				} else if (result->get_type() == Variant::DICTIONARY) {
+					failed_translations++;
+				}
+			}
+		}
+	}
+
+	OS::get_singleton()->unset_environment("TINT_FORCE_DEPTH");
+
+	// The export cache only re-customizes changed resources, so a run may only see
+	// a subset of the shaders. Keep every translated stage on disk (next to the
+	// mirrored shader cache files) and pack the union, like the `file_cache` list
+	// the cache files themselves use.
+	const String wgsl_store_dir = shader_cache_export_path.path_join("wgsl");
+	DirAccess::make_dir_recursive_absolute(wgsl_store_dir);
+	for (const KeyValue<uint64_t, String> &E : baked) {
+		Ref<FileAccess> wgsl_file = FileAccess::open(wgsl_store_dir.path_join(String::num_uint64(E.key) + ".wgsl"), FileAccess::WRITE);
+		if (wgsl_file.is_valid()) {
+			wgsl_file->store_buffer((const uint8_t *)E.value.utf8().get_data(), E.value.utf8().length());
+		}
+	}
+
+	// Merge everything translated so far (union of this and previous exports).
+	{
+		Ref<DirAccess> store = DirAccess::open(wgsl_store_dir);
+		if (store.is_valid()) {
+			for (const String &file_name : store->get_files()) {
+				if (!file_name.ends_with(".wgsl")) {
+					continue;
+				}
+				const uint64_t hash = _parse_uint64(file_name.trim_suffix(".wgsl"));
+				if (baked.has(hash)) {
+					continue;
+				}
+				Ref<FileAccess> f = FileAccess::open(wgsl_store_dir.path_join(file_name), FileAccess::READ);
+				if (f.is_valid() && f->get_length() > 0) {
+					Vector<uint8_t> text;
+					text.resize((int64_t)f->get_length());
+					f->get_buffer(text.ptrw(), text.size());
+					baked[hash] = String::utf8((const char *)text.ptr(), text.size());
+				}
+			}
+		}
+	}
+
+	if (baked.is_empty()) {
+		WARN_PRINT("Shader baker: no WGSL could be baked; the runtime will translate shaders at startup.");
+	} else {
+		const Vector<uint8_t> blob = WgslCacheBlob::encode(baked);
+		add_file(WgslCacheBlob::PATH, blob, false);
+		print_verbose(vformat("Shader baker: baked WGSL for %d shader stages (%d KiB, %d untranslatable).", (int)baked.size(), (int)(blob.size() / 1024), (int)failed_translations));
+	}
+
+	_cleanup_wgsl_bake();
+}
+
+void ShaderBakerExportPlugin::_cleanup_wgsl_bake() {
+	// Remove the staged SPIR-V and forget the maps.
+	for (const KeyValue<uint64_t, String> &E : wgsl_spv_files) {
+		DirAccess::remove_absolute(E.value);
+	}
+	for (const KeyValue<uint64_t, String> &E : wgsl_spv_files_force_depth) {
+		DirAccess::remove_absolute(E.value);
+	}
+	wgsl_spv_files.clear();
+	wgsl_spv_files_force_depth.clear();
+
+	if (!wgsl_bake_root.is_empty()) {
+		DirAccess::remove_absolute(wgsl_bake_root.path_join("normal"));
+		DirAccess::remove_absolute(wgsl_bake_root.path_join("force_depth"));
+		DirAccess::remove_absolute(wgsl_bake_root);
+		wgsl_bake_root = String();
+	}
+}
