+
+	for (int set = 0; set < p_data.uniform_sets.size(); set++) {
+		const Vector<WGSLUniform> &src_set = p_data.uniform_sets[set];
+		ERR_FAIL_COND_V_MSG(src_set.is_empty(), RID(),
+				vformat("shader_create_from_wgsl: uniform set %d is empty; WebGPU uniform sets must contain at least one binding.", set));
+		Vector<ShaderUniform> &dst_set = reflection.uniform_sets.write[set];
+		dst_set.resize(src_set.size());
+		for (int i = 0; i < src_set.size(); i++) {
+			const WGSLUniform &src = src_set[i];
+			ERR_FAIL_COND_V_MSG(src.type == UNIFORM_TYPE_MAX, RID(),
+					vformat("shader_create_from_wgsl: set %d binding %d has no uniform type.", set, src.binding));
+			ERR_FAIL_COND_V_MSG(src.type == UNIFORM_TYPE_SAMPLER_WITH_TEXTURE, RID(),
