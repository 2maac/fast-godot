+
+#pragma once
+
+#include "core/templates/rid.h"
+#include "core/templates/span.h"
+#include "servers/rendering/renderer_rd/effects/spatial_upscaler.h"
+
+namespace RendererRD {
+
+// Milestone 1 of the pmndrs/upscaler port: the spatial upscaling path
+// (EASU -> RCAS) running as hand-written WGSL compute shaders on the raw-WGSL
+// RenderingDevice path (WebGPU only).
+//
+// It is selected instead of FSR1 when the viewport's 3D scaling mode is
+// VIEWPORT_SCALING_3D_MODE_PMNDRS_SPATIAL and this class reports itself
+// available. On every other driver (or when the raw-WGSL shaders cannot be
+// created) the renderer falls back to RendererRD::FSR, which is the
+// pre-existing behaviour.
+//
+// Contract references:
+//   docs/PMNDRS_UPSCALER_SPATIAL.md  (WGSL provenance, constants layout,
+//                                     per-pass bindings, dispatch math)
+//   docs/WGSL_COMPUTE_PATH.md        (raw-WGSL RD API)
+class PmndrsSpatial : public SpatialUpscaler {
+public:
+	PmndrsSpatial();
+	~PmndrsSpatial();
+
+	virtual const Span<char> get_label() const final { return "pmndrs Upscaler (spatial)"; }
+	virtual void ensure_context(Ref<RenderSceneBuffersRD> p_render_buffers) final;
+	virtual void process(Ref<RenderSceneBuffersRD> p_render_buffers, RID p_source_rd_texture, RID p_destination_texture) final;
+
+	// True when the raw-WGSL shaders and both compute pipelines could be
+	// created. When false the renderer must keep using RendererRD::FSR.
+	bool is_available() const { return available; }
+
+	// FsrConstants payload size in bytes (see docs/PMNDRS_UPSCALER_SPATIAL.md
+	// §5.2). The GPU buffer is 256 bytes (WebGPU uniform offset alignment);
+	// only the first 96 bytes are read by the shaders.
+	static constexpr uint32_t FSR_CONSTANTS_SIZE = 96;
+	static constexpr uint32_t FSR_CONSTANTS_BUFFER_SIZE = 256;
+
+private:
+
+	// Ring of constants uniform buffers. process() is called once per viewport
+	// per frame, all inside one RD frame, and buffer_update() must never touch
+	// a buffer that an already-recorded dispatch uses, so each process() takes
+	// a fresh slot. 64 slots is >= 2 * (viewports * frames in flight) + slack.
+	static constexpr uint32_t CONSTANTS_RING_SIZE = 64;
+
+	// Byte-exact CPU mirror of the WGSL `FsrConstants` struct (96 bytes, WGSL
+	// uniform layout). Do not repack/reorder, do not use alignas(16).
+	struct FsrConstants {
+		float render_size[2]; // offset 0: render (input) resolution in px.
+		float display_size[2]; // offset 8: display (output) resolution in px.
+		float render_size_inv[2]; // offset 16: 1/renderSize (unused, written anyway).
+		float display_size_inv[2]; // offset 24: 1/displaySize (EASU source mapping).
+		float jitter[2]; // offset 32: spatial path has no jitter.
+		float jitter_prev[2]; // offset 40.
+		float motion_scale[2]; // offset 48: unused on the spatial path.
+		float depth_near_far[2]; // offset 56: unused on the spatial path.
+		float sharpness; // offset 64: RCAS attenuation, 1 = sharpest.
+		float max_accumulation; // offset 68: unused.
+		float exposure; // offset 72: unused when FLAG_INPUT_REINHARD is clear.
+		float delta_time; // offset 76: unused.
+		uint32_t flags; // offset 80: FLAG_* bits; 0 on the spatial path.
+		uint32_t frame_index; // offset 84: unused.
+		uint32_t debug_mode; // offset 88: unused.
+		uint32_t pad; // offset 92: unused.
+	};
+	static_assert(sizeof(FsrConstants) == FSR_CONSTANTS_SIZE, "FsrConstants must match the WGSL struct layout (96 bytes).");
+
+	bool available = false;
+	bool warned_about_destination = false;
+
+	RID easu_shader;
+	RID rcas_shader;
+	RID easu_pipeline;
+	RID rcas_pipeline;
+
+	RID constants_buffers[CONSTANTS_RING_SIZE];
+	uint32_t constants_ring_index = 0;
+
+	bool _create_pipelines();
+	void _ensure_intermediate(Ref<RenderSceneBuffersRD> p_render_buffers);
+	void _free_resources();
+};
+
+} // namespace RendererRD
