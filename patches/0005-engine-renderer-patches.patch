+// Locates the host Tint CLI used to pre-translate shaders. It is built next to
+// the editor by the web toolchain (drivers/webgpu/tint_cli/build.sh).
+static String _find_tint_convert_cli() {
+	String from_env = OS::get_singleton()->get_environment("WGPU_TINT_CLI");
+	if (!from_env.is_empty() && FileAccess::exists(from_env)) {
+		return from_env;
+	}
+
+	// bin/tint_convert_cli next to the binary, then walk up (covers both
+	// bin/godot.macos.editor.* and out/editor-staging/Fast_Godot.app/Contents/MacOS/Godot).
+	String dir = OS::get_singleton()->get_executable_path().get_base_dir();
+	for (int i = 0; i < 6 && !dir.is_empty() && dir != "/"; i++) {
+		for (const String &candidate : { dir.path_join("tint_convert_cli"), dir.path_join("bin").path_join("tint_convert_cli") }) {
+			if (FileAccess::exists(candidate)) {
+				return candidate;
+			}
+		}
+		dir = dir.get_base_dir();
+	}
+	return String();
+}
+
+// File names store the 64-bit hash in decimal; String::to_int() is signed and
+// would wrap for hashes with the top bit set.
+static uint64_t _parse_uint64(const String &p_text) {
+	uint64_t value = 0;
+	for (int i = 0; i < p_text.length(); i++) {
+		const char32_t c = p_text[i];
+		if (c < '0' || c > '9') {
+			break;
+		}
+		value = value * 10 + (uint64_t)(c - '0');
+	}
+	return value;
+}
