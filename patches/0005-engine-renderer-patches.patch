@@ -167,6 +167,15 @@ def get_version_info(module_version_string="", silent=False):
 def get_git_info():
     os.chdir(base_folder)
 
+    # Isolated build trees (e.g. Grit's per-profile copies) do not carry .git, so
+    # they would otherwise compile an empty GODOT_VERSION_HASH. That value feeds
+    # ShaderRD's cache keys, so a mismatch makes editor-baked shader caches
+    # invisible at runtime. Callers that know the canonical revision (the editor
+    # exports VERSION_HASH to Grit as "engine_id") pin it here.
+    pinned_hash = os.environ.get("GODOT_VERSION_HASH_OVERRIDE")
+    if pinned_hash:
+        return {"git_hash": pinned_hash, "git_timestamp": 0}
+
     # Parse Git hash if we're in a Git repo.
     git_hash = ""
     git_folder = ".git"
