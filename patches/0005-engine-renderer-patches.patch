+def _wb_xtime(a):
+    a <<= 1
+    return (a ^ 0x11B) & 0xFF if a & 0x100 else a
+
+
+def _wb_gmul(a, b):
+    result = 0
+    while b:
+        if b & 1:
+            result ^= a
+        a = _wb_xtime(a)
+        b >>= 1
+    return result
+
