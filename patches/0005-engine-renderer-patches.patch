+#include "pmndrs_upscaler.h"
+
+#include "pmndrs_upscaler_wgsl.h"
+
+#include "core/string/print_string.h"
+#include "core/templates/local_vector.h"
+#include "servers/rendering/renderer_rd/storage_rd/render_scene_buffers_rd.h"
+#include "servers/rendering/renderer_rd/uniform_set_cache_rd.h"
+#include "servers/rendering/rendering_device.h"
+
+using namespace RendererRD;
+
+namespace {
+
+// The WGSL declares `@group(0) @binding(0) var<uniform> C : FsrConstants;`.
+// The shader container rewrites the authored binding numbers to the WebGPU
+// driver's doubled convention (@binding(2*N)); the RD reflection keeps the
+// authored numbers, which is what both WGSLUniform::binding and
+// RD::Uniform::binding must use here.
+RD::WGSLUniform _wgsl_uniform_buffer(uint32_t p_binding) {
+	RD::WGSLUniform u;
+	u.type = RD::UNIFORM_TYPE_UNIFORM_BUFFER;
+	u.binding = p_binding;
+	u.length = PmndrsSpatial::FSR_CONSTANTS_SIZE;
+	return u;
+}
+
+RD::WGSLUniform _wgsl_sampled_texture(uint32_t p_binding) {
+	RD::WGSLUniform u;
+	u.type = RD::UNIFORM_TYPE_TEXTURE;
+	u.binding = p_binding;
+	u.length = 1;
+	u.texture_type = RD::TEXTURE_TYPE_2D;
+	// Informational for a sampled binding; the BGL sample type comes from the
+	// WGSL component (`texture_2d<f32>` -> float), never from this format.
+	u.texture_format = RD::DATA_FORMAT_R16G16B16A16_SFLOAT;
+	return u;
+}
+
+RD::WGSLUniform _wgsl_storage_texture(uint32_t p_binding) {
+	RD::WGSLUniform u;
+	u.type = RD::UNIFORM_TYPE_IMAGE;
+	u.binding = p_binding;
+	u.length = 1;
+	// `texture_storage_2d<rgba16float, write>`: write-only storage access.
+	// This also drives RD's read/write tracking for the binding.
+	u.writable = true;
+	u.texture_type = RD::TEXTURE_TYPE_2D;
+	u.texture_format = RD::DATA_FORMAT_R16G16B16A16_SFLOAT;
+	return u;
+}
+
+} // namespace
+
+PmndrsSpatial::PmndrsSpatial() {
+	// The raw-WGSL shader path only exists on WebGPU. On every other driver
+	// (or when an older build has no such feature) stay inert: the renderer
+	// will keep selecting FSR1.
+	ERR_FAIL_NULL(RD::get_singleton());
+	if (!RD::get_singleton()->has_feature(RD::SUPPORTS_RAW_WGSL_COMPUTE)) {
+		return;
+	}
+
+	// The WGSL hard-codes `texture_storage_2d<rgba16float, ...>` for both
+	// storage bindings, so RGBA16F must be usable as a sampled + storage image.
+	if (!RD::get_singleton()->texture_is_format_supported_for_usage(
+				RD::DATA_FORMAT_R16G16B16A16_SFLOAT,
+				RD::TEXTURE_USAGE_SAMPLING_BIT | RD::TEXTURE_USAGE_STORAGE_BIT)) {
+		return;
+	}
+
+	if (!_create_pipelines()) {
+		_free_resources();
+		return;
+	}
+
+	for (uint32_t i = 0; i < CONSTANTS_RING_SIZE; i++) {
+		constants_buffers[i] = RD::get_singleton()->uniform_buffer_create(FSR_CONSTANTS_BUFFER_SIZE);
+		if (constants_buffers[i].is_null()) {
+			ERR_PRINT("pmndrs spatial upscaler: failed to create the constants uniform buffer ring.");
+			_free_resources();
+			return;
+		}
+	}
+
+	available = true;
+
+	static bool announced = false;
+	if (!announced) {
+		announced = true;
+		print_line("[PMNDRS] spatial upscaler active (EASU+RCAS, raw WGSL)");
+	}
+}
+
+PmndrsSpatial::~PmndrsSpatial() {
+	_free_resources();
+}
+
+bool PmndrsSpatial::_create_pipelines() {
+	RenderingDevice *rd = RD::get_singleton();
+	ERR_FAIL_NULL_V(rd, false);
+
+	// Pass 1 - EASU: render-res RGBA16F color -> display-res RGBA16F storage image.
+	RD::WGSLShaderData easu_data;
+	easu_data.name = "PMNDRS_EASU";
+	easu_data.code = pmndrs_easu_wgsl;
+	easu_data.workgroup_size[0] = 8;
+	easu_data.workgroup_size[1] = 8;
+	easu_data.workgroup_size[2] = 1;
+	easu_data.uniform_sets.resize(1);
+	easu_data.uniform_sets.write[0].push_back(_wgsl_uniform_buffer(0));
+	easu_data.uniform_sets.write[0].push_back(_wgsl_sampled_texture(1));
+	easu_data.uniform_sets.write[0].push_back(_wgsl_storage_texture(2));
+
+	easu_shader = rd->shader_create_from_wgsl(easu_data);
+	if (easu_shader.is_null()) {
+		WARN_PRINT("pmndrs spatial upscaler: failed to create the EASU WGSL shader.");
+		return false;
+	}
+	easu_pipeline = rd->compute_pipeline_create(easu_shader);
+	if (easu_pipeline.is_null()) {
+		WARN_PRINT("pmndrs spatial upscaler: failed to create the EASU compute pipeline.");
+		return false;
+	}
+
+	// Pass 2 - RCAS: display-res EASU output -> display-res RGBA16F storage image.
+	// Binding 2 (`exposureTex`) is statically present but never read while
+	// FLAG_INPUT_REINHARD (bit 8) is clear; it still has to be bound.
+	RD::WGSLShaderData rcas_data;
+	rcas_data.name = "PMNDRS_RCAS";
+	rcas_data.code = pmndrs_rcas_wgsl;
+	rcas_data.workgroup_size[0] = 8;
+	rcas_data.workgroup_size[1] = 8;
+	rcas_data.workgroup_size[2] = 1;
+	rcas_data.uniform_sets.resize(1);
+	rcas_data.uniform_sets.write[0].push_back(_wgsl_uniform_buffer(0));
+	rcas_data.uniform_sets.write[0].push_back(_wgsl_sampled_texture(1));
+	rcas_data.uniform_sets.write[0].push_back(_wgsl_sampled_texture(2));
+	rcas_data.uniform_sets.write[0].push_back(_wgsl_storage_texture(3));
+	rcas_data.uniform_sets.write[0].push_back(_wgsl_sampled_texture(4));
+
+	rcas_shader = rd->shader_create_from_wgsl(rcas_data);
+	if (rcas_shader.is_null()) {
+		WARN_PRINT("pmndrs spatial upscaler: failed to create the RCAS WGSL shader.");
+		return false;
+	}
+	rcas_pipeline = rd->compute_pipeline_create(rcas_shader);
+	if (rcas_pipeline.is_null()) {
+		WARN_PRINT("pmndrs spatial upscaler: failed to create the RCAS compute pipeline.");
+		return false;
+	}
+
+	return true;
+}
+
+void PmndrsSpatial::_free_resources() {
+	RenderingDevice *rd = RD::get_singleton();
+	if (rd == nullptr) {
+		return;
+	}
+
+	if (easu_pipeline.is_valid()) {
+		rd->free_rid(easu_pipeline);
+		easu_pipeline = RID();
+	}
+	if (rcas_pipeline.is_valid()) {
+		rd->free_rid(rcas_pipeline);
+		rcas_pipeline = RID();
+	}
+	if (easu_shader.is_valid()) {
+		rd->free_rid(easu_shader);
+		easu_shader = RID();
+	}
+	if (rcas_shader.is_valid()) {
+		rd->free_rid(rcas_shader);
+		rcas_shader = RID();
+	}
+	for (uint32_t i = 0; i < CONSTANTS_RING_SIZE; i++) {
+		if (constants_buffers[i].is_valid()) {
+			rd->free_rid(constants_buffers[i]);
+			constants_buffers[i] = RID();
+		}
+	}
+}
+
+void PmndrsSpatial::_ensure_intermediate(Ref<RenderSceneBuffersRD> p_render_buffers) {
+	ERR_FAIL_COND(p_render_buffers.is_null());
+
+	if (p_render_buffers->has_texture(SNAME("PMNDRS"), SNAME("easu_output"))) {
+		return;
+	}
+
+	// Display-resolution RGBA16F intermediate written by EASU and sampled by
+	// RCAS. One layer: the shaders only see a 2D texture and process() runs
+	// once per view sequentially, exactly like FSR1's upscale_texture.
+	const uint32_t usage_bits = RD::TEXTURE_USAGE_SAMPLING_BIT | RD::TEXTURE_USAGE_STORAGE_BIT;
+	RID texture = p_render_buffers->create_texture(SNAME("PMNDRS"), SNAME("easu_output"),
+			RD::DATA_FORMAT_R16G16B16A16_SFLOAT, usage_bits, RD::TEXTURE_SAMPLES_1,
+			p_render_buffers->get_target_size(), 1, 1, true, true);
+	ERR_FAIL_COND_MSG(texture.is_null(), "pmndrs spatial upscaler: failed to create the EASU intermediate texture.");
+}
+
+void PmndrsSpatial::ensure_context(Ref<RenderSceneBuffersRD> p_render_buffers) {
+	if (!available) {
+		return;
+	}
+	_ensure_intermediate(p_render_buffers);
+}
+
+void PmndrsSpatial::process(Ref<RenderSceneBuffersRD> p_render_buffers, RID p_source_rd_texture, RID p_destination_texture) {
+	if (!available || p_render_buffers.is_null()) {
+		return;
+	}
+
+	RenderingDevice *rd = RD::get_singleton();
+	ERR_FAIL_NULL(rd);
+	UniformSetCacheRD *uniform_set_cache = UniformSetCacheRD::get_singleton();
+	ERR_FAIL_NULL(uniform_set_cache);
+
+	if (p_source_rd_texture.is_null() || p_destination_texture.is_null()) {
+		return;
+	}
+
+	const Size2i render_size = p_render_buffers->get_internal_size();
+	const Size2i display_size = p_render_buffers->get_target_size();
+	if (render_size.x <= 0 || render_size.y <= 0 || display_size.x <= 0 || display_size.y <= 0) {
+		return;
+	}
+
+	// Both shaders hard-code `rgba16float` for their storage output, and the
+	// destination has to be writable through a storage image. The renderer's
+	// spatial-upscaler slot already substitutes a storage-capable RGBA16F
+	// intermediate when the render target itself is not storage-capable
+	// (WebGPU), so a mismatch here means this slot cannot host the effect;
+	// leave the frame untouched.
+	const RD::TextureFormat destination_format = rd->texture_get_format(p_destination_texture);
+	if (destination_format.format != RD::DATA_FORMAT_R16G16B16A16_SFLOAT ||
+			!(destination_format.usage_bits & RD::TEXTURE_USAGE_STORAGE_BIT)) {
+		if (!warned_about_destination) {
+			warned_about_destination = true;
+			WARN_PRINT("pmndrs spatial upscaler: destination texture is not a storage-capable RGBA16F image; skipping upscale.");
+		}
+		return;
+	}
+
+	_ensure_intermediate(p_render_buffers);
+	RID easu_output = p_render_buffers->get_texture(SNAME("PMNDRS"), SNAME("easu_output"));
+	if (easu_output.is_null()) {
+		return;
+	}
+
+	// Constants: written to a fresh ring slot *before* the compute list opens.
+	// buffer_update() is not allowed while a compute list is recording, and a
+	// shared buffer would let another viewport/frame overwrite the values an
+	// already-recorded dispatch reads.
+	FsrConstants constants;
+	memset(&constants, 0, sizeof(constants));
+	constants.render_size[0] = (float)render_size.x;
+	constants.render_size[1] = (float)render_size.y;
+	constants.display_size[0] = (float)display_size.x;
+	constants.display_size[1] = (float)display_size.y;
+	constants.render_size_inv[0] = 1.0f / (float)render_size.x;
+	constants.render_size_inv[1] = 1.0f / (float)render_size.y;
+	constants.display_size_inv[0] = 1.0f / (float)display_size.x;
+	constants.display_size_inv[1] = 1.0f / (float)display_size.y;
+	// Reuse the FSR sharpness knob (AMD RCAS "stops") with pmndrs' spatial RCAS
+	// convention: peak = exp2(-2 * (1 - sharpness)) == exp2(-stops).
+	constants.sharpness = CLAMP(1.0f - p_render_buffers->get_fsr_sharpness() * 0.5f, 0.0f, 1.0f);
+	constants.flags = 0; // FLAG_INPUT_REINHARD (8) and FLAG_RCAS_DENOISE (512) must stay clear.
+
+	const uint32_t ring_slot = constants_ring_index;
+	constants_ring_index = (constants_ring_index + 1) % CONSTANTS_RING_SIZE;
+	RID constants_buffer = constants_buffers[ring_slot];
+	Error update_error = rd->buffer_update(constants_buffer, 0, sizeof(FsrConstants), &constants);
+	ERR_FAIL_COND(update_error != OK);
+
+	// One uniform set per shader: EASU and RCAS have different binding sets, so
+	// RD's set-format hash differs and a set cannot be shared between them.
+	LocalVector<RD::Uniform> easu_uniforms;
+	easu_uniforms.push_back(RD::Uniform(RD::UNIFORM_TYPE_UNIFORM_BUFFER, 0, constants_buffer));
+	easu_uniforms.push_back(RD::Uniform(RD::UNIFORM_TYPE_TEXTURE, 1, p_source_rd_texture));
+	easu_uniforms.push_back(RD::Uniform(RD::UNIFORM_TYPE_IMAGE, 2, easu_output));
+	RID easu_uniform_set = uniform_set_cache->get_cache_vec(easu_shader, 0, easu_uniforms);
+	if (easu_uniform_set.is_null()) {
+		return;
+	}
+
+	LocalVector<RD::Uniform> rcas_uniforms;
+	rcas_uniforms.push_back(RD::Uniform(RD::UNIFORM_TYPE_UNIFORM_BUFFER, 0, constants_buffer));
+	rcas_uniforms.push_back(RD::Uniform(RD::UNIFORM_TYPE_TEXTURE, 1, easu_output));
+	// `exposureTex` is only loaded when FLAG_INPUT_REINHARD (bit 8) is set, which
+	// the spatial path keeps clear; the binding is statically present, so bind
+	// the EASU output as the placeholder (same as the alpha source below).
+	rcas_uniforms.push_back(RD::Uniform(RD::UNIFORM_TYPE_TEXTURE, 2, easu_output));
+	rcas_uniforms.push_back(RD::Uniform(RD::UNIFORM_TYPE_IMAGE, 3, p_destination_texture));
+	// `alphaSource` is the EASU output again: RCAS passes alpha through.
+	rcas_uniforms.push_back(RD::Uniform(RD::UNIFORM_TYPE_TEXTURE, 4, easu_output));
+	RID rcas_uniform_set = uniform_set_cache->get_cache_vec(rcas_shader, 0, rcas_uniforms);
+	if (rcas_uniform_set.is_null()) {
+		return;
+	}
+
+	// One-time proof-of-use log: the constructor's announcement only says the
+	// effect is *available*; this line fires the first time it actually
+	// upscales a frame (used by the browser verification recipe in
+	// docs/WEBGPU_HANDOFF.md to tell FSR1 and pmndrs apart from the console).
+	static bool announced_running = false;
+	if (!announced_running) {
+		announced_running = true;
+		print_line(vformat("[PMNDRS] spatial upscaler running (EASU+RCAS) %dx%d -> %dx%d, %dx%d groups",
+				render_size.x, render_size.y, display_size.x, display_size.y,
+				((uint32_t)display_size.x + 7u) / 8u, ((uint32_t)display_size.y + 7u) / 8u));
+	}
+
+	// One invocation per display pixel, 8x8 workgroups. Clamp to 1 group so
+	// tiny viewports never produce a zero dispatch.
+	const uint32_t groups_x = MAX(1u, ((uint32_t)display_size.x + 7u) / 8u);
+	const uint32_t groups_y = MAX(1u, ((uint32_t)display_size.y + 7u) / 8u);
+
+	RD::ComputeListID compute_list = rd->compute_list_begin();
+
+	// Pass 1: EASU render -> intermediate.
+	rd->compute_list_bind_compute_pipeline(compute_list, easu_pipeline);
+	rd->compute_list_bind_uniform_set(compute_list, easu_uniform_set, 0);
+	rd->compute_list_dispatch(compute_list, groups_x, groups_y, 1);
+
+	// New usage scope: the intermediate was written by EASU and is sampled by
+	// RCAS. On WebGPU the driver's compute-pass usage guard also splits the pass
+	// here; the explicit barrier keeps the intent deterministic.
+	rd->compute_list_add_barrier(compute_list);
+
+	// Pass 2: RCAS intermediate -> destination.
+	rd->compute_list_bind_compute_pipeline(compute_list, rcas_pipeline);
+	rd->compute_list_bind_uniform_set(compute_list, rcas_uniform_set, 0);
+	rd->compute_list_dispatch(compute_list, groups_x, groups_y, 1);
+
+	rd->compute_list_end();
+}
