+/* CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,   */
+/* TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE      */
+/* SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.                 */
+/**************************************************************************/
+
+// Built in editors too (shader baker), so not guarded by WEBGPU_ENABLED.
+
+#include "rendering_shader_container_webgpu.h"
+
+#ifdef WEBGPU_BAKE_WGSL
+#include "spirv_preprocess.h"
+#include "spirv_to_wgsl.h"
+
+#include <cstdlib>
+#endif
+
+// =========================================================================
+// SPIR-V Storage
+// =========================================================================
+//
+// Architecture decision (see copilot-instructions.md #6):
+//   GLSL → SPIR-V (glslang) → stored directly as WGPUShaderSourceSPIRV.
+//   Dawn's emdawnwebgpu port natively supports WGPUShaderSourceSPIRV;
+//   no WGSL/Tint translation step is needed.
+//
+// Push constant handling:
+//   Godot's push constants are emulated via a uniform buffer at a fixed
+//   bind group slot (default: group 3, binding 0).
+//   The bind group slot is recorded in HeaderData and used by the driver
+//   to create the pipeline layout and bind the ring buffer at draw time.
+
+bool RenderingShaderContainerWebGPU::_set_code_from_spirv(const ReflectShader &p_shader) {
+	const uint32_t stage_count = p_shader.shader_stages.size();
+	shaders.resize(stage_count);
+	stage_wgsl.resize(stage_count);
+
+	for (uint32_t i = 0; i < stage_count; i++) {
+		const ReflectShaderStage &stage = p_shader.shader_stages[i];
+		// Store raw SPIR-V bytes directly — no translation.
+		Vector<uint8_t> spirv_bytes = stage.spirv_data();
+		shaders.write[i].shader_stage = stage.shader_stage;
+		shaders.write[i].code_compression_flags = 0; // No compression.
+		shaders.write[i].code_decompressed_size = 0; // 0 = not compressed (use raw bytes).
+		shaders.write[i].code_compressed_bytes = spirv_bytes;
+
+#ifdef WEBGPU_BAKE_WGSL
+		header_data.flags |= HEADER_FLAG_HAS_WGSL;
+		// Baking: translate now so the browser skips Tint for this stage.
+		//
+		// Tint aborts the process on constructs it cannot lower, and this runs in
+		// the editor's worker threads while exporting: one such variant would kill
+		// the export. Skip those stages (the browser only translates a stage it
+		// actually compiles). See spirv_preprocess::scan_tint_risks().
+		// Scan the PREPROCESSED module: our passes already strip or rewrite some
+		// hazards (Volatile, same-width integer converts), so scanning the raw form
+		// would skip stages unnecessarily.
+		Vector<uint8_t> prepared = spirv_preprocess::prepare_for_tint(spirv_bytes);
+		String risk;
+		if (spirv_preprocess::scan_tint_risks(prepared, risk)) {
+			WARN_PRINT(vformat("WebGPU: not baking WGSL for '%s' stage %d (%s); the browser will translate it if it is ever used.",
+					String(shader_name.get_data()), (int)stage.shader_stage, risk));
+		} else {
+			String error;
+			char *wgsl = webgpu_spirv_to_wgsl_prepared(prepared.ptr(), (int)prepared.size(), &error);
+			if (wgsl) {
+				stage_wgsl[i] = CharString(wgsl);
+				free(wgsl);
+			} else {
+				WARN_PRINT(vformat("WebGPU: SPIR-V to WGSL failed for '%s', left to the browser: %s", String(shader_name.get_data()), error));
+			}
+		}
+#endif
+	}
+
+	// Decide push constant bind group slot.
+	if (p_shader.push_constant_size > 0) {
+		// Convention: push constants use bind group 3, binding PUSH_CONSTANT_RING_BINDING (120).
+		// Chosen high enough to avoid collision with split combined-sampler bindings
+		// (original binding N → sampler@N*2, image@N*2+1; max reasonable N ~20 → max~41).
+		// Must match the binding in spirv_preprocess::convert_push_constants_to_uniforms()
+		// and PUSH_CONSTANT_RING_BINDING in rendering_device_driver_webgpu.h.
+		header_data.push_constant_bind_group = 3;
+		header_data.push_constant_binding = 120; // PUSH_CONSTANT_RING_BINDING
+	} else {
+		header_data.push_constant_bind_group = RenderingShaderContainerWebGPU::NO_PUSH_CONSTANTS;
+		header_data.push_constant_binding = 120; // PUSH_CONSTANT_RING_BINDING
+	}
+
+	return true;
+}
+
+// =========================================================================
+// Serialization
+// =========================================================================
+
+uint32_t RenderingShaderContainerWebGPU::_from_bytes_header_extra_data(const uint8_t *p_bytes) {
+	if (p_bytes) {
+		memcpy(&header_data, p_bytes, sizeof(HeaderData));
+	}
+	return sizeof(HeaderData);
+}
+
+uint32_t RenderingShaderContainerWebGPU::_to_bytes_header_extra_data(uint8_t *p_bytes) const {
+	if (p_bytes) {
+		memcpy(p_bytes, &header_data, sizeof(HeaderData));
+	}
+	return sizeof(HeaderData);
+}
+
+// Per stage: uint32 length, then the WGSL bytes padded to 4.
+uint32_t RenderingShaderContainerWebGPU::_from_bytes_shader_extra_data(const uint8_t *p_bytes, uint32_t p_index) {
+	if (!(header_data.flags & HEADER_FLAG_HAS_WGSL)) {
+		return 0;
+	}
+	uint32_t length = 0;
+	memcpy(&length, p_bytes, sizeof(uint32_t));
+	if (stage_wgsl.size() <= p_index) {
+		stage_wgsl.resize(p_index + 1);
+	}
+	CharString &wgsl = stage_wgsl[p_index];
+	wgsl = CharString();
+	if (length > 0) {
+		wgsl.resize_uninitialized(length + 1);
+		memcpy(wgsl.ptrw(), p_bytes + sizeof(uint32_t), length);
+		wgsl.ptrw()[length] = 0;
+	}
+	return sizeof(uint32_t) + ((length + 3u) & ~3u);
+}
+
+uint32_t RenderingShaderContainerWebGPU::_to_bytes_shader_extra_data(uint8_t *p_bytes, uint32_t p_index) const {
+	if (!(header_data.flags & HEADER_FLAG_HAS_WGSL)) {
+		return 0;
+	}
+	const uint32_t length = p_index < stage_wgsl.size() ? uint32_t(stage_wgsl[p_index].length()) : 0;
+	const uint32_t size = sizeof(uint32_t) + ((length + 3u) & ~3u);
+	if (p_bytes) {
+		memset(p_bytes, 0, size);
+		memcpy(p_bytes, &length, sizeof(uint32_t));
+		if (length > 0) {
+			memcpy(p_bytes + sizeof(uint32_t), stage_wgsl[p_index].get_data(), length);
+		}
+	}
+	return size;
+}
+
+// =========================================================================
+// Public API
+// =========================================================================
+
+RenderingShaderContainerWebGPU::RenderingShaderContainerWebGPU() {
+}
+
+RenderingShaderContainerWebGPU::~RenderingShaderContainerWebGPU() {
+}
+
