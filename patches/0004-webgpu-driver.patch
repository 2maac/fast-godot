+++ b/drivers/webgpu/wgsl_cache_blob.h
@@ -0,0 +1,141 @@
+/**************************************************************************/
+/*  wgsl_cache_blob.h                                                     */
+/**************************************************************************/
+/*                         This file is part of:                          */
+/*                             GODOT ENGINE                               */
+/*                        https://godotengine.org                         */
+/**************************************************************************/
