+				free(wgsl_str);
+				CharString cs = ws.utf8();
+				wgsl_str = (char *)malloc(cs.length() + 1);
+				memcpy(wgsl_str, cs.get_data(), cs.length() + 1);
+			}
+		}
+
+		// When readonly-and-readwrite-storage-textures is not available, convert
