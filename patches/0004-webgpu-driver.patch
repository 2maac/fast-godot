+void RenderingDeviceDriverWebGPU::begin_segment(uint32_t p_frame_index, uint32_t p_frames_drawn) {
+	if (bool(GLOBAL_GET("rendering/webgpu/debug_frames"))) {
+		EM_ASM({
+			console.log('[DBGFRAME] f=' + $0 + ' drawn=' + $1 + ' passes=' + $2 + ' draws=' + $3 +
+				' resAtt=' + $4 + ' resCmd=' + $5 + ' ringOF=' + $6 + ' passFlush=' + $7);
+		}, (int)p_frame_index, (int)p_frames_drawn, (int)_dbg_passes, (int)_dbg_draws,
+				(int)_dbg_resolve_att, (int)_dbg_resolve_cmd, (int)_dbg_ringof, (int)_dbg_pass_flush);
+		_dbg_passes = 0;
+		_dbg_draws = 0;
+		_dbg_resolve_att = 0;
+		_dbg_resolve_cmd = 0;
+		_dbg_ringof = 0;
+		_dbg_pass_flush = 0;
+	}
+	frame_index = p_frame_index;
+	swapchain_pass_cleared = false;
+	frames_drawn = p_frames_drawn;
+
+	// Performance counter tracking (always-on, 1 log/sec is negligible overhead).
+	perf.frames_since_log++;
+	double now = EM_ASM_DOUBLE({ return performance.now(); });
+	if (perf.last_log_time == 0) {
+		perf.last_log_time = now;
+	} else if (now - perf.last_log_time >= 1000.0) {
+		double elapsed = (now - perf.last_log_time) / 1000.0;
+		uint32_t fps = (uint32_t)(perf.frames_since_log / elapsed);
+		uint32_t f = perf.frames_since_log > 0 ? perf.frames_since_log : 1;
+		EM_ASM({
+			console.log('[PERF] fps=' + $0 +
+				' draws/f=' + $1 +
+				' SetBG/f=' + $2 +
+				' PC/f=' + $3 +
+				' RP/f=' + $4 +
+				' SetVB/f=' + $5 +
+				' FI/f=' + $6 +
+				' RingOF/f=' + $7 +
+				' DepthCopy/f=' + ($8 / $9).toFixed(2));
+		}, fps, perf.draw_calls / f, perf.set_bind_group_calls / f,
+				perf.push_constant_writes / f, perf.render_passes / f,
+				perf.set_vertex_buffer_calls / f, perf.first_instance_draws / f,
+				perf.ring_overflows / f, perf.depth_copies, f);
+		const WGCreationStats &cs = _creation_stats;
+		EM_ASM({
+			console.log('[PERF] create: shaders=' + $0 + '/' + $12 + '/' + $1.toFixed(0) + 'ms tint=' + $2 + '/' + $3.toFixed(0) + 'ms baked=' + $13 + ' precompiled=' + $4 + ' disk=' + $11 +
+				' spec_modules=' + $5 + '/' + $6.toFixed(0) + 'ms render_pipelines=' + $7 + '/' + $8.toFixed(0) + 'ms compute_pipelines=' + $9 + '/' + $10.toFixed(0) + 'ms at=' + performance.now().toFixed(0));
+		}, cs.shaders, cs.shader_ms, _spv_to_wgsl_cache_misses, cs.tint_ms, _spv_to_wgsl_precompiled_hits,
+				cs.spec_modules, cs.spec_ms, cs.render_pipelines, cs.render_pipeline_ms, cs.compute_pipelines, cs.compute_pipeline_ms, _spv_to_wgsl_disk_hits, cs.shaders_requested, _spv_to_wgsl_baked_hits);
+		perf.reset();
+		perf.frames_since_log = 0;
+		perf.last_log_time = now;
+	}
+
+	// Reset push constant ring buffer offset and shadow buffer tracking at the start of each segment.
+	push_constant_ring_offset = 0;
+	push_constant_shadow_dirty_start = UINT32_MAX;
+	push_constant_shadow_dirty_end = 0;
+	push_constant_pass_start_offset = 0;
+}
+
+void RenderingDeviceDriverWebGPU::end_segment() {
+	// Nothing to do.
+}
