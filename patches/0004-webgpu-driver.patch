+#include "core/string/ustring.h"
+
+// Translates Godot's SPIR-V to WGSL: runs the spirv_preprocess passes, then
+// Tint. Depends only on the SPIR-V bytes, so the editor's shader baker and the
+// web driver produce the same WGSL. Thread-safe.
+// Returns a malloc'd null-terminated string (caller frees), or nullptr with
+// r_error set.
+char *webgpu_spirv_to_wgsl(const uint8_t *p_spv, int p_size, String *r_error);
+
+// Same, but the caller has already run spirv_preprocess::prepare_for_tint() on the
+// module (lets the bake scan the preprocessed form before handing it to Tint,
+// which aborts the process on constructs it cannot lower).
+char *webgpu_spirv_to_wgsl_prepared(const uint8_t *p_spv, int p_size, String *r_error);
