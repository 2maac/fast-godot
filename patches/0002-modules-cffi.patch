index 00000000000..fea52bbc99f
--- /dev/null
+++ b/modules/cffi/doc_classes/CFFI.xml
@@ -0,0 +1,172 @@
+<?xml version="1.0" encoding="UTF-8" ?>
+<class name="CFFI" inherits="Object" api_type="extension" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/godotengine/godot/master/doc/class.xsd">
+	<brief_description>
+		The global FFI type scope and entrypoint for opening libraries.
+	</brief_description>
+	<description>
+	</description>
+	<tutorials>
+	</tutorials>
+	<methods>
+		<method name="create_function">
+			<return type="CFFICallableFunction" />
+			<param index="0" name="callable" type="Callable" />
+			<param index="1" name="return_type" type="Variant" />
+			<param index="2" name="argument_types" type="Array" default="[]" />
+			<description>
+				Create a new native function from a [Callable] and the function's prototype.
+				This way you can pass Callables to native code as function pointers. You are responsible for keeping the [CFFICallableFunction] alive while native code has access to it.
+				You are responsible for passing the correct return type and array of argument types. Types may be either [CFFIType] or a String, for example [code]"int"[/code] or [code]"const char *"[/code].
+				If [param callable] or any of the passed types are not valid, [code]null[/code] is returned and an error printed.
+			</description>
+		</method>
+		<method name="define_struct">
+			<return type="CFFIStructType" />
+			<param index="0" name="name" type="String" />
+			<param index="1" name="fields" type="Dictionary" />
+			<description>
+				Defines a new struct type.
+				[param name] cannot have any pointer levels.
+				If a struct with the same name is found in the global scope, [code]null[/code] is returned and an error printed.
+			</description>
+		</method>
+		<method name="find_type" qualifiers="const">
+			<return type="CFFIType" />
+			<param index="0" name="name" type="String" />
+			<description>
+				Finds a type by [param name].
+				Pointers and CV qualifiers are supported.
+				This method is called when accessing properties by name, so that [code]CFFI["int"][/code] returns the [CFFIType] for [code]int[/code].
+			</description>
+		</method>
+		<method name="get_function_at">
+			<return type="CFFIFunction" />
+			<param index="0" name="pointer" type="Variant" />
+			<param index="1" name="return_type" type="Variant" />
+			<param index="2" name="argument_types" type="Array" default="[]" />
+			<param index="3" name="is_variadic" type="bool" default="false" />
+			<description>
+				Wraps a raw code address into a [CFFIFunction] that can be invoked from script.
+				Useful for calling functions that are only reachable through a pointer, such as COM/vtable methods, callbacks stored in structs, or functions returned by [code]dlsym[/code] or [code]GetProcAddress[/code].
+				[param pointer] may be an integer address, a [CFFIPointer] or a [CFFIFunction].
+				Types may be either [CFFIType] or a String, for example [code]"int"[/code] or [code]"const char *"[/code].
+				[b]Warning:[/b] You are responsible for passing the correct prototype. An incorrect return type or argument types lead to undefined behavior and may crash your application and/or the Godot editor.
+			</description>
+		</method>
+		<method name="get_pointer">
+			<return type="CFFIPointer" />
+			<param index="0" name="value" type="Variant" />
+			<description>
+				Returns a pointer to the memory of [param value].
+				If [param value] is a [String], returns a pointer to its first character.
+				If [param value] is one of the Packed Array types, returns a pointer to its first element.
+				Instances of [CFFIPointer] are returned as-is.
+				Any other values error and return [code]null[/code].
+				Mostly useful for passing Packed Arrays to [method memcmp], [method memcpy], [method memequal], [method memmove] and [method memset].
+				[b]Warning:[/b] The returned pointer is only valid as long as [param value] is not modified or freed. If [param value] is modified or freed, the pointer may become invalid and dereferencing it leads to undefined behavior. Misuse of pointers may crash your application and/or the Godot editor.
+			</description>
+		</method>
+		<method name="memcmp" qualifiers="static">
+			<return type="int" />
+			<param index="0" name="s1" type="CFFIPointer" />
+			<param index="1" name="s2" type="CFFIPointer" />
+			<param index="2" name="size_bytes" type="int" />
+			<description>
+				Compares the first [param size_bytes] from [param s1] against [param s2].
+				If both [param s1] and [param s2] are [code]null[/code], returns [code]0[/code].
+				If only one of them is [code]null[/code] but the other is not, returns [code]1[/code].
+				If memory pointed to by [param s1] and [param s2] contains the same first [param size_bytes] bytes, returns [code]0[/code], otherwise returns the difference between the first two differing bytes.
+			</description>
+		</method>
+		<method name="memcpy" qualifiers="static">
+			<return type="CFFIPointer" />
+			<param index="0" name="dest" type="CFFIPointer" />
+			<param index="1" name="src" type="CFFIPointer" />
+			<param index="2" name="size_bytes" type="int" />
+			<description>
+				Copies [param size_bytes] bytes of memory from [param src] to [param dest].
+				If either [param src] or [param dest] is [code]null[/code], this function fails and returns [code]null[/code]. Otherwise, [param dest] is returned.
+				[b]Warning:[/b] if memory pointed to by [param dest] and [param src] might overlap, use [method memmove] instead.
+			</description>
+		</method>
+		<method name="memequal" qualifiers="static">
+			<return type="bool" />
+			<param index="0" name="s1" type="CFFIPointer" />
+			<param index="1" name="s2" type="CFFIPointer" />
+			<param index="2" name="size_bytes" type="int" />
+			<description>
+				Compares the first [param size_bytes] from [param s1] against [param s2], returning whether memory pointed to by [param s1] and [param s2] contains the same first [param size_bytes] bytes.
+			</description>
+		</method>
+		<method name="memmove" qualifiers="static">
+			<return type="CFFIPointer" />
+			<param index="0" name="dest" type="CFFIPointer" />
+			<param index="1" name="src" type="CFFIPointer" />
+			<param index="2" name="size_bytes" type="int" />
+			<description>
+				Copies [param size_bytes] bytes of memory from [param src] to [param dest]. Memory pointed to by [param dest] and [param src] may overlap, the copy is always done in a non-destructive manner.
+				If either [param src] or [param dest] is [code]null[/code], this function fails and returns [code]null[/code]. Otherwise, [param dest] is returned.
+			</description>
+		</method>
+		<method name="memset" qualifiers="static">
+			<return type="CFFIPointer" />
+			<param index="0" name="dest" type="CFFIPointer" />
+			<param index="1" name="byte_value" type="int" />
+			<param index="2" name="size_bytes" type="int" />
+			<description>
+				Writes [param size_bytes] bytes of value [param byte_value] to [param dest].
+				If [param dest] is [code]null[/code], this function fails and returns [code]null[/code]. Otherwise, [param dest] is returned.
+			</description>
+		</method>
+		<method name="null_terminated_ascii_buffer" qualifiers="static">
+			<return type="PackedByteArray" />
+			<param index="0" name="str" type="String" />
+			<description>
+				Similar to [method String.to_ascii_buffer], but adds a trailing null character so that the buffer is ready to be passed to C APIs that expect null-terminated strings.
+			</description>
+		</method>
+		<method name="null_terminated_utf8_buffer" qualifiers="static">
+			<return type="PackedByteArray" />
+			<param index="0" name="str" type="String" />
+			<description>
+				Similar to [method String.to_utf8_buffer], but adds a trailing null character so that the buffer is ready to be passed to C APIs that expect null-terminated strings.
+			</description>
+		</method>
+		<method name="null_terminated_utf16_buffer" qualifiers="static">
+			<return type="PackedByteArray" />
+			<param index="0" name="str" type="String" />
+			<description>
+				Similar to [method String.to_utf16_buffer], but adds a trailing null character so that the buffer is ready to be passed to C APIs that expect null-terminated strings.
+			</description>
+		</method>
+		<method name="null_terminated_utf32_buffer" qualifiers="static">
+			<return type="PackedByteArray" />
+			<param index="0" name="str" type="String" />
+			<description>
+				Similar to [method String.to_utf32_buffer], but adds a trailing null character so that the buffer is ready to be passed to C APIs that expect null-terminated strings.
+			</description>
+		</method>
+		<method name="null_terminated_wchar_buffer" qualifiers="static">
+			<return type="PackedByteArray" />
+			<param index="0" name="str" type="String" />
+			<description>
+				Similar to [method String.to_wchar_buffer], but adds a trailing null character so that the buffer is ready to be passed to C APIs that expect null-terminated strings.
+			</description>
+		</method>
+		<method name="open" qualifiers="const">
+			<return type="CFFILibraryHandle" />
+			<param index="0" name="name_or_path" type="String" />
+			<description>
+				Opens a native library by its name or file path.
+				[param name_or_path] may be the name of the library, for example [code]"cffi"[/code], or a file path like [code]"res://some_dir/cffi.dll"[/code].
+				Paths starting with [code]res://[/code] reference files inside the project in editor. In built games, the directory part is ignored and the library is searched for in the executable path.
+				Returns the open library handle or [code]null[/code] if the library could not be opened.
+			</description>
+		</method>
+	</methods>
+	<members>
+		<member name="scope" type="CFFIScope" setter="" getter="get_scope">
+			The global FFI type scope. Contains all built-in types and any struct types defined via [method define_struct].
+		</member>
+	</members>
+</class>
