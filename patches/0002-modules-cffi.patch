diff --git a/modules/cffi/config.py b/modules/cffi/config.py
new file mode 100644
index 00000000000..5448d99696a
--- /dev/null
+++ b/modules/cffi/config.py
@@ -0,0 +1,21 @@
+def can_build(env, platform):
+    # macOS and Linux ship libffi with the system/OS SDK. Windows has none, so a
+    # libffi prefix must be supplied through cffi_libffi_path (vcpkg works).
+    return platform in ("macos", "linuxbsd", "windows")
+
+
+def configure(env):
+    pass
+
+
+def get_opts(platform):
+    from SCons.Variables import PathVariable
+
+    return [
+        PathVariable(
+            "cffi_libffi_path",
+            "Path to a libffi prefix (include/ and lib/libffi) - required on Windows",
+            "",
+            PathVariable.PathAccept,
+        ),
+    ]
diff --git a/modules/cffi/doc_classes/CFFI.xml b/modules/cffi/doc_classes/CFFI.xml
