+<?xml version="1.0" encoding="UTF-8" ?>
+<class name="CFFIFunction" inherits="RefCounted" api_type="extension" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/godotengine/godot/master/doc/class.xsd">
+	<brief_description>
+		Object that represents a native function pointer.
+	</brief_description>
+	<description>
+		[CFFIFunction]s can be invoked from GDScript, stored in struct fields or passed as arguments.
+	</description>
+	<tutorials>
+	</tutorials>
+	<methods>
+		<method name="invoke" qualifiers="const vararg">
+			<return type="Variant" />
+			<description>
+				Invoke the function forwading the passed arguments.
+				The number of arguments must match the function's prototype. If any of the argument values don't match the type defined by the prototype, the call errors and returns [code]null[/code].
+			</description>
+		</method>
+		<method name="invokev">
+			<return type="Variant" />
+			<param index="0" name="args" type="Array" />
+			<description>
+				Invoke the function passing it all arguments in [param args].
+				The number of arguments must match the function's prototype. If any of the argument values don't match the type defined by the prototype, the call errors and returns [code]null[/code].
+			</description>
+		</method>
+	</methods>
+</class>
diff --git a/modules/cffi/doc_classes/CFFILibraryHandle.xml b/modules/cffi/doc_classes/CFFILibraryHandle.xml
new file mode 100644
index 00000000000..629676817ff
--- /dev/null
+++ b/modules/cffi/doc_classes/CFFILibraryHandle.xml
@@ -0,0 +1,36 @@
+<?xml version="1.0" encoding="UTF-8" ?>
+<class name="CFFILibraryHandle" inherits="CFFIScope" api_type="extension" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/godotengine/godot/master/doc/class.xsd">
+	<brief_description>
+		Native dynamic library handle, where native functions live.
+	</brief_description>
+	<description>
+	</description>
+	<tutorials>
+	</tutorials>
+	<methods>
+		<method name="get_function" qualifiers="const">
+			<return type="CFFIFunction" />
+			<param index="0" name="name" type="String" />
+			<param index="1" name="return_type" type="Variant" />
+			<param index="2" name="argument_types" type="Array" default="[]" />
+			<param index="3" name="is_variadic" type="bool" default="false" />
+			<description>
+				Get the function named [param name] from the library.
+				[param name] should be a symbol exported by the native library.
+				Users are responsible for passing the correct return type and array of argument types. Types may be either [CFFIType] or a String, for example [code]"int"[/code] or [code]"const char *"[/code].
+				[b]Warning:[/b] passing the wrong types and calling the returned function may crash your application and/or Godot editor.
+			</description>
+		</method>
+		<method name="get_global">
+			<return type="CFFIPointer" />
+			<param index="0" name="name" type="String" />
+			<param index="1" name="type" type="Variant" />
+			<description>
+				Get a pointer to the global variable named [param name] from the library.
+				[param name] should be a symbol exported by the native library.
+				Users are responsible for passing the correct type. Types may be either [CFFIType] or a String, for example [code]"int"[/code] or [code]"const char *"[/code].
+				[b]Warning:[/b] Passing the wrong type and dereferencing the returned pointer may crash your application and/or Godot editor.
+			</description>
+		</method>
+	</methods>
+</class>
