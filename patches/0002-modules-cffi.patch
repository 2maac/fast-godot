diff --git a/modules/cffi/doc_classes/CFFIScope.xml b/modules/cffi/doc_classes/CFFIScope.xml
new file mode 100644
index 00000000000..a88c57b6de3
--- /dev/null
+++ b/modules/cffi/doc_classes/CFFIScope.xml
@@ -0,0 +1,44 @@
+<?xml version="1.0" encoding="UTF-8" ?>
+<class name="CFFIScope" inherits="RefCounted" api_type="extension" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/godotengine/godot/master/doc/class.xsd">
+	<brief_description>
+		CFFI type scopes, so that different libraries can have distinct struct definitions with the same name.
+	</brief_description>
+	<description>
+	</description>
+	<tutorials>
+	</tutorials>
+	<methods>
+		<method name="create_function">
+			<return type="CFFICallableFunction" />
+			<param index="0" name="callable" type="Callable" />
+			<param index="1" name="return_type" type="Variant" />
+			<param index="2" name="argument_types" type="Array" default="[]" />
+			<description>
+				Create a new native function from a [Callable] and the function's prototype.
+				This way you can pass Callables to native code as function pointers. You are responsible for keeping the [CFFICallableFunction] alive while native code has access to it.
+				You are responsible for passing the correct return type and array of argument types. Types may be either [CFFIType] or a String, for example [code]"int"[/code] or [code]"const char *"[/code].
+				If [param callable] or any of the passed types are not valid, [code]null[/code] is returned and an error printed.
+			</description>
+		</method>
+		<method name="define_struct">
+			<return type="CFFIStructType" />
+			<param index="0" name="name" type="String" />
+			<param index="1" name="fields" type="Dictionary" />
+			<description>
+				Defines a new struct type.
+				[param name] cannot have any pointer levels.
+				If a struct with the same name is found in this scope, [code]null[/code] is returned and an error printed.
+			</description>
+		</method>
+		<method name="find_type" qualifiers="const">
+			<return type="CFFIType" />
+			<param index="0" name="name" type="String" />
+			<description>
+				Finds a type by [param name].
+				If the base type name cannot be found in this scope, the global scope (the [CFFI] singleton) is searched.
+				Pointers and CV qualifiers are supported.
+				This method is called when accessing properties by name, so that [code]some_cffi_scope["int"][/code] returns the [CFFIType] for [code]int[/code].
+			</description>
+		</method>
+	</methods>
+</class>
diff --git a/modules/cffi/doc_classes/CFFISpan.xml b/modules/cffi/doc_classes/CFFISpan.xml
new file mode 100644
index 00000000000..c7c9aec7623
--- /dev/null
+++ b/modules/cffi/doc_classes/CFFISpan.xml
@@ -0,0 +1,196 @@
+<?xml version="1.0" encoding="UTF-8" ?>
+<class name="CFFISpan" inherits="RefCounted" api_type="extension" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/godotengine/godot/master/doc/class.xsd">
+	<brief_description>
+		Object that provides access to a finite number of contiguous elements in memory.
+	</brief_description>
+	<description>
+	</description>
+	<tutorials>
+	</tutorials>
+	<methods>
+		<method name="duplicate" qualifiers="const">
+			<return type="CFFIOwnedArray" />
+			<description>
+				Duplicate data into a new [CFFIOwnedArray].
+			</description>
+		</method>
+		<method name="from" qualifiers="static">
+			<return type="CFFISpan" />
+			<param index="0" name="pointer" type="CFFIPointer" />
+			<param index="1" name="count" type="int" />
+			<description>
+				Create a new span from a pointer and a count.
+				If [param pointer] is [code]null[/code] or [param count] is negative, prints an error and returns [code]null[/code].
+			</description>
+		</method>
+		<method name="get_pointer" qualifiers="const">
+			<return type="CFFIPointer" />
+			<param index="0" name="index" type="int" />
+			<description>
+				Get a pointer for the element at [param index].
+				If the index is out of bounds, prints an error and returns [code]null[/code].
+				Alias for [code]data.offset_by(index)[/code].
+			</description>
+		</method>
+		<method name="get_string_from_ascii" qualifiers="const">
+			<return type="String" />
+			<description>
+				Get a String from this span, using ASCII encoding.
+				This span should contain elements with 1 byte, such as [code]char[/code] or [code]int8_t[/code].
+				It's an error to read ASCII strings from elements with more than 1 byte.
+			</description>
+		</method>
+		<method name="get_string_from_utf8" qualifiers="const">
+			<return type="String" />
+			<description>
+				Get a String from this span, using UTF-8 encoding.
+				This span should contain elements with 1 byte, such as [code]char[/code] or [code]int8_t[/code].
+				It's an error to read UTF-8 strings from elements with more than 1 byte.
+			</description>
+		</method>
+		<method name="get_string_from_utf16" qualifiers="const">
+			<return type="String" />
+			<description>
+				Get a String from this span, using UTF-16 encoding.
+				This span should contain elements with 2 bytes, such as [code]char16_t[/code] or [code]int16_t[/code].
+				It's an error to read UTF-16 strings from elements with any size other than 2 bytes.
+			</description>
+		</method>
+		<method name="get_string_from_utf32" qualifiers="const">
+			<return type="String" />
+			<description>
+				Get a String from this span, using UTF-32 encoding.
+				This span should contain elements with 4 bytes, such as [code]char32_t[/code] or [code]int32_t[/code].
+				It's an error to read UTF-32 strings from elements with any size other than 4 bytes.
+			</description>
+		</method>
+		<method name="get_string_from_wchar" qualifiers="const">
+			<return type="String" />
+			<description>
+				Get a String from a span of [code]wchar_t[/code].
+				This span should contain elements with [code]sizeof(wchar_t)[/code] bytes, such as [code]wchar_t[/code]. Note that the size of [code]wchar_t[/code] is platform-dependent.
+				It's an error to read wide strings from elements with any size other than [code]sizeof(wchar_t)[/code] bytes.
+			</description>
+		</method>
+		<method name="get_value" qualifiers="const">
+			<return type="Variant" />
+			<param index="0" name="index" type="int" />
+			<description>
+				Get the value at [param index].
+				If the index is out of bounds, prints an error and returns [code]null[/code].
+				Alias for [code]get_pointer(index).get_value()[/code].
+			</description>
+		</method>
+		<method name="is_empty" qualifiers="const">
+			<return type="bool" />
+			<description>
+				Returns [code]true[/code] if the span has no elements.
+			</description>
+		</method>
+		<method name="set_value" qualifiers="const">
+			<return type="bool" />
+			<param index="0" name="index" type="int" />
+			<param index="1" name="value" type="Variant" />
+			<description>
+				Sets the value at [param index].
+				If the index is out of bounds, prints an error and returns [code]false[/code].
+				Alias for [code]get_pointer(index).set_value(value)[/code].
+			</description>
+		</method>
+		<method name="subspan" qualifiers="const">
+			<return type="CFFISpan" />
+			<param index="0" name="from" type="int" />
+			<param index="1" name="count" type="int" default="-1" />
+			<description>
+				Returns part of the span from the position [param from] with [param count] elements.
+				If [param count] is -1 (as by default), returns the rest of the span starting from the given position.
+				Passing [param from] or [param count] that would grow the bounds of the span will print an error and return [code]null[/code].
+			</description>
+		</method>
+		<method name="to_array" qualifiers="const">
+			<return type="Array" />
+			<description>
+				Get an [Array] with the values of this span using [method get_value].
+			</description>
+		</method>
+		<method name="to_byte_array" qualifiers="const">
+			<return type="PackedByteArray" />
+			<description>
+				Get a copy of the memory of the span as a [PackedByteArray].
+				The size of the result [PackedByteArray] is equal to [member size_bytes].
+			</description>
+		</method>
+		<method name="to_color_array" qualifiers="const">
+			<return type="PackedColorArray" />
+			<description>
+				Get a copy of the memory of the span as a [PackedColorArray].
+				Element type must have the size of a [code]Color[/code].
+			</description>
+		</method>
+		<method name="to_float32_array" qualifiers="const">
+			<return type="PackedFloat32Array" />
+			<description>
+				Get a copy of the memory of the span as a [PackedFloat32Array].
+				Element type must have the size of a [code]float[/code].
+			</description>
+		</method>
+		<method name="to_float64_array" qualifiers="const">
